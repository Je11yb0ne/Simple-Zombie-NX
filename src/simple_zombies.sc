PROC DisableGameControls()
    // ★ 只在 PLAYER / CAMERA 组禁用，**绝对不能禁 FRONTEND 组**。
    //   DISABLE_CONTROL_ACTION 不仅让游戏忽略输入，也会让 IS_CONTROL_PRESSED /
    //   IS_CONTROL_JUST_PRESSED 读不到该 action；而菜单导航是从 FRONTEND 组读的。
    //   不同控制组的 disable 是相互独立的，所以禁 PLAYER 组的同一个 action，
    //   既能挡住游戏误触，又保留 FRONTEND 组可读。（这个技巧来自能用的 ragemenu）
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_PHONE, TRUE)
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_ATTACK, TRUE)
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_AIM, TRUE)
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_ATTACK2, TRUE)
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_MOVE_UP_ONLY, TRUE)
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_MOVE_DOWN_ONLY, TRUE)
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_MOVE_LEFT_ONLY, TRUE)
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_MOVE_RIGHT_ONLY, TRUE)
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_JUMP, TRUE)
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_DUCK, TRUE)
    DISABLE_CONTROL_ACTION(PLAYER_CONTROL, INPUT_SPRINT, TRUE)
