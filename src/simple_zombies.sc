// 跑者概率（见下方 RollRunner 的两档说明）
//   · 快速僵尸档（`g_fastZombies`，v0.19 起随感染模式自动开启）= **25% 随机**
//   · 普通档 = 对照 Reborn ZombieCreator：白天 1.8% / 夜间 16% / 20:00~03:00 18%
// 「快速僵尸」档的跑者概率（千分比）。想调难度改这一个数即可：
//   250 = 25%，500 = 一半，1000 = 全员跑者（v0.19 及以前的行为）。
CONST_INT RUNNER_PCT_FAST 250

FUNC BOOL RollRunner()
    // ★ v0.20：「快速僵尸」不再是"全员跑者"，改成**概率刷新**。
    //   v0.19 起它随感染模式自动开启，而原来的语义是 `RETURN TRUE`
    //   ⇒ 一开模式满街全是跑者，难度直接跳到顶。
    //   现在：每只僵尸 **25%** 概率是跑者 —— 随机掺在尸群里，
    //   "跑者混在行尸中"而不是"整条街都在狂奔"。
    IF g_fastZombies
        IF GET_RANDOM_INT_IN_RANGE(0, 1000) < RUNNER_PCT_FAST RETURN TRUE ENDIF
        RETURN FALSE
    ENDIF
    // 普通档：对照 Reborn ZombieCreator —— 白天 1.8% / 夜间 16% / 20:00~03:00 18%
    INT h = GET_CLOCK_HOURS()
    INT pct = 18                     // 白天 1.8%（用千分比避免小数）
    IF h >= 19 OR h <= 5 pct = 160 ENDIF
    IF h >= 20 OR h <= 3 pct = 180 ENDIF
    IF GET_RANDOM_INT_IN_RANGE(0, 1000) < pct RETURN TRUE ENDIF
    RETURN FALSE
ENDFUNC

// 变异关闭时只区分 行尸/跑者
FUNC INT ZTYPE_WALKER_OR_RUNNER()
    IF RollRunner() RETURN ZTYPE_RUNNER ENDIF
    RETURN ZTYPE_WALKER
ENDFUNC

// 稀有变异 —— 对照 Reborn：基础 4%，紧张期 +4%、夜间 +4%
// 命中后 35% 出壮尸，否则尖啸者。变异概率档位会再乘系数。
FUNC INT RollZombieType()
    IF g_mutationLevel = 0
        RETURN ZTYPE_WALKER_OR_RUNNER()
    ENDIF

    FLOAT chance = 0.04
    IF g_tension chance = chance + 0.04 ENDIF
    INT h = GET_CLOCK_HOURS()
    IF h >= 20 OR h <= 4 chance = chance + 0.04 ENDIF
    IF g_mutationLevel = 2 chance = chance * 2.0 ENDIF
    IF g_mutationLevel = 3 chance = chance * 3.5 ENDIF

    IF GET_RANDOM_FLOAT_IN_RANGE(0.0, 1.0) < chance
        IF GET_RANDOM_INT_IN_RANGE(0, 100) < 35 RETURN ZTYPE_BRUTE ENDIF
        RETURN ZTYPE_SCREAMER
    ENDIF

    RETURN ZTYPE_WALKER_OR_RUNNER()
ENDFUNC

// ---------------------------------------------------------------------------
// 菜单文字
// ---------------------------------------------------------------------------
// 菜单文字（简体中文）
//   字符串以 UTF-8 写进 ysc 的字符串表（已实测产物里能看到正确的 UTF-8 字节）。
//   显示依赖游戏自带字体；简体版客户端有中文字库，正常能显示。
// ---------------------------------------------------------------------------
// 僵尸地图标记 —— 批量应用开关（v0.13）
//
//   菜单里「僵尸地图标记」一开一关时调用，给**现有**的僵尸补建或清除标记。
//   新生成的僵尸由 RegisterZombie 按同一个开关决定加不加。
//   成本：只在切换那一刻跑一次（最多 32 只），可忽略。
// ---------------------------------------------------------------------------
PROC ApplyZombieBlips()
    INT i = 0
    WHILE i < g_zombieCount
        // 先清掉旧的（无论开关是开是关，重建最省心）
        IF DOES_BLIP_EXIST(g_zBlip[i])
            REMOVE_BLIP(g_zBlip[i])
            g_zBlip[i] = NULL
        ENDIF

        IF g_zombieBlips
            IF DOES_ENTITY_EXIST(g_zombies[i])
            AND NOT IS_ENTITY_DEAD(g_zombies[i], FALSE)
                g_zBlip[i] = ADD_BLIP_FOR_ENTITY(g_zombies[i])
                SET_BLIP_COLOUR(g_zBlip[i], 1)          // 红 = 敌意
                // 壮尸的点大一圈、尖啸者稍大 —— 便于在地图上判读威胁等级
                IF g_zType[i] = ZTYPE_BRUTE
                    SET_BLIP_SCALE(g_zBlip[i], 1.1)
                ELIF g_zType[i] = ZTYPE_SCREAMER
                    SET_BLIP_SCALE(g_zBlip[i], 0.9)
                ELSE
                    SET_BLIP_SCALE(g_zBlip[i], 0.7)
                ENDIF
                SET_BLIP_AS_SHORT_RANGE(g_zBlip[i], TRUE)
            ENDIF
        ENDIF

        i = i + 1
    ENDWHILE
ENDPROC

