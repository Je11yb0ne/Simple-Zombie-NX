// ---------------------------------------------------------------------------
// 档位 -> 数值
// ---------------------------------------------------------------------------
FUNC FLOAT SpawnDistance()
    IF g_spawnLevel = 0 RETURN 40.0 ENDIF
    IF g_spawnLevel = 1 RETURN 60.0 ENDIF
    IF g_spawnLevel = 2 RETURN 80.0 ENDIF
    RETURN 130.0
ENDFUNC

// 基础血量（档位）—— 实际血量还要乘类型系数，见 ZombieHealthFor()
FUNC INT ZombieHealth()
    IF g_healthLevel = 0 RETURN 100 ENDIF
    IF g_healthLevel = 1 RETURN 200 ENDIF
    IF g_healthLevel = 2 RETURN 400 ENDIF
    RETURN 800
ENDFUNC

// ---------------------------------------------------------------------------
// 按类型取数值 —— 数值对照 Simple Zombies Reborn v1.0.5f：
//   Walker   : 血量 ×1     咬伤 6   移速 0.35  动画集 drunk
//   Runner   : 血量 ×1     咬伤 8   移速 0.85  动画集 injured（会砸车、10% 跳扑）
//   Brute    : 血量 ×2.7   咬伤 14  移速 0.30  动画集 drunk（血厚、打得疼、不会倒地）
//   Screamer : 血量 ×1.35  咬伤 7   移速 0.55  动画集 injured（靠近就尖啸召潮）
//   移速用 SET_PED_MOVE_RATE_OVERRIDE（1.0 = 普通人速度），再乘速度档位。
// ---------------------------------------------------------------------------
FUNC INT ZombieHealthFor(INT t)
    IF t = ZTYPE_BRUTE RETURN (ZombieHealth() * 27) / 10 ENDIF
    IF t = ZTYPE_SCREAMER RETURN (ZombieHealth() * 135) / 100 ENDIF
    RETURN ZombieHealth()
ENDFUNC

FUNC INT ZombieDamageFor(INT t)
    IF t = ZTYPE_RUNNER RETURN 8 ENDIF
    IF t = ZTYPE_BRUTE RETURN 14 ENDIF
    IF t = ZTYPE_SCREAMER RETURN 7 ENDIF
    RETURN 6
ENDFUNC

FUNC FLOAT SpeedLevelFactor()
    IF g_speedLevel = 0 RETURN 0.8 ENDIF
    IF g_speedLevel = 1 RETURN 1.0 ENDIF
    IF g_speedLevel = 2 RETURN 1.25 ENDIF
    RETURN 1.5
ENDFUNC

FUNC FLOAT ZombieRateFor(INT t)
    FLOAT base = 0.35
    IF t = ZTYPE_RUNNER base = 0.85 ENDIF
    IF t = ZTYPE_BRUTE base = 0.30 ENDIF
    IF t = ZTYPE_SCREAMER base = 0.55 ENDIF
    RETURN base * SpeedLevelFactor()
ENDFUNC

FUNC BOOL ZombieIsRunner(INT t)
    RETURN t = ZTYPE_RUNNER
ENDFUNC

FUNC STRING ZombieTypeName(INT t)
    IF t = ZTYPE_RUNNER RETURN "跑者" ENDIF
    IF t = ZTYPE_BRUTE RETURN "壮尸" ENDIF
    IF t = ZTYPE_SCREAMER RETURN "尖啸者" ENDIF
    RETURN "行尸"
ENDFUNC

FUNC INT MaxZombiesForLevel()
    IF g_maxZombies = 0 RETURN 8 ENDIF
    IF g_maxZombies = 1 RETURN 16 ENDIF
    IF g_maxZombies = 2 RETURN 24 ENDIF
    RETURN 32
ENDFUNC

// 实际活跃上限 = 档位上限 × 尸潮压力系数
//   对照 Reborn：ActiveZombieCapMultiplier = clamp(0.8 + (pressure-1)*0.65, 0.75, 1.55)
// ---------------------------------------------------------------------------
// v0.45：玩家现在是不是在"野外"（山里 / 荒地 / 沙漠）
//
//   判据：**脚下附近有没有"人行道（pavement）"导航面** ——
//     · 人行道只存在于城镇/城市；山里、荒地、沙漠没有 ⇒ 这是"城市/野外"最干净的口径；
//     · 用它而不是"最近车行节点的距离"：**乡村土路会把节点距离判得很近**，
//       于是山里被误判成城里（上一版就是这么漏掉的）。
//   ★ 兜底：如果**人行道判据在这个端口不生效**（永远查不到），那"城里"就永远判不出来、
//     全场僵尸上限都会减半 —— 所以再加一条很紧的兜底：**车行节点就在 4 米内**也算城里。
//     4 米是"人就站在路面上"的量级，乡村土路虽然也可能中，但代价小得多。
//   ★ 每 1Hz 更新一次（放在 UpdateSlowSystems 里），ActiveCap() 只读这个全局 —— 不增加每帧开销。
// ---------------------------------------------------------------------------
PROC UpdateWildState()
    PED_INDEX pl = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(pl)
        g_inWild = FALSE
        EXIT
    ENDIF
    VECTOR pc = GET_ENTITY_COORDS(pl, TRUE)
    VECTOR safe
    BOOL urban = FALSE
    IF GET_SAFE_COORD_FOR_PED(pc, FALSE, safe, GSC_FLAG_ONLY_PAVEMENT)
        urban = TRUE                         // 脚下有人行道 -> 城镇/城市
    ELSE
        VECTOR np
        IF GET_CLOSEST_VEHICLE_NODE(pc, np, NF_NONE, 1.0, 1.0)
            VECTOR f1
            VECTOR f2
            f1.x = pc.x
            f1.y = pc.y
            f1.z = 0.0
            f2.x = np.x
            f2.y = np.y
            f2.z = 0.0
            IF VDIST2(f1, f2) <= 16.0        // 4²：节点就在 4 米内 -> 也算城里
                urban = TRUE
            ENDIF
        ENDIF
    ENDIF
    g_inWild = NOT urban
ENDPROC

FUNC INT ActiveCap()
    FLOAT f = 0.8 + (g_pressure - 1.0) * 0.65
    IF f < 0.75 f = 0.75 ENDIF
    IF f > 1.55 f = 1.55 ENDIF
    INT cap = ROUND(MaxZombiesForLevel() * f)
    // ★ v0.45：**野外数量减半**（用户要求：32 -> 16、16 -> 8 …）。
    //   只减"常驻上限"这一项，尸潮的 +10 另算（尸潮就是尸潮）。
    IF g_inWild
        cap = cap / 2
    ENDIF
    // 尸潮期间额外抬高上限 —— 让"尸潮"在屏幕上真的是一堵墙，而不是只快一点点
    IF GET_GAME_TIMER() < g_hordeUntil
        cap = cap + 10
    ENDIF
    IF cap < 4 cap = 4 ENDIF
    IF cap > MAX_ZOMBIES cap = MAX_ZOMBIES ENDIF
    RETURN cap
ENDFUNC

// 玩家进入这个距离，僵尸就会从"街上游荡"转为扑过来
FUNC FLOAT EngageRange()
    IF g_spawnLevel = 0 RETURN 18.0 ENDIF
    IF g_spawnLevel = 1 RETURN 22.0 ENDIF
    IF g_spawnLevel = 2 RETURN 26.0 ENDIF
    RETURN 32.0
ENDFUNC

// ---------------------------------------------------------------------------
// 僵尸的"发现距离"（v0.24）
//
//   潜行且**近期没开枪**时缩到四成 —— 这就是"潜行更不容易被发现"的实现。
//   ★ 为什么用 g_noiseUntil 而不是 IS_PED_SHOOTING：
//     IS_PED_SHOOTING 只在扣扳机的那几帧为真，而枪声在游戏里要"响一会儿"。
//     主循环里开枪会设 g_noiseUntil = now + 4000，用它当"刚开过枪"的窗口
//     正好符合直觉：开完枪 4 秒内潜行也藏不住。
// ---------------------------------------------------------------------------
FUNC FLOAT ZombieDetectRange()
    IF g_playerStealth AND GET_GAME_TIMER() >= g_noiseUntil
        RETURN EngageRange() * STEALTH_DETECT_MUL
    ENDIF
    RETURN EngageRange()
ENDFUNC

FUNC MODEL_NAMES RandomZombieModel()
