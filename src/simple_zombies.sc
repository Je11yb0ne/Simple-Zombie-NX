PROC FireBroadcast()
    // ★ v0.23：改成**随机**播报（原来是顺序轮换，十几分钟就听全了）。
    //   随机很容易连着抽中同一条，所以撞上了就往后挪一格。
    INT pick = GET_RANDOM_INT_IN_RANGE(0, BROADCAST_COUNT)
    IF pick = g_lastBroadcastIdx
        pick = pick + 1
        IF pick >= BROADCAST_COUNT pick = 0 ENDIF
    ENDIF
    g_lastBroadcastIdx = pick
    g_specialMsg = BroadcastLine(pick)
    g_specialUntil = GET_GAME_TIMER() + 7000
ENDPROC

// ---------------------------------------------------------------------------
// 跨天播报**排队**（v0.26 新增）
//
//   【为什么需要它】用户预见到的问题：
//     "末日天数更新和起床都会有通知吧？会不会冲突？"
//   —— 会。两者共用同一组 `g_specialMsg` / `g_specialUntil`，而播报是**立刻**写的，
//   所以睡醒那一刻"新的一天"的广播会把刚写好的"睡醒那句话"直接顶掉，
//   结果就是你只看到一条紧急广播、不知道自己是睡醒了还是被广播吵醒的。
//
//   【做法】所有跨天播报都先排队：
//     · 屏上正有消息 -> 等它消失后 2.5 秒再播（睡醒文案 5 秒 + 间隔 2.5 秒）；
//     · 屏上没消息   -> 1.5 秒后播（留一点"停顿"，不要和刚发生的事粘在一起）。
//   真正的播报动作交给 `UpdateBroadcast()` —— 让**所有**播报只有一个出口，
//   以后再加新的提示（尸潮、营地、感染…）也不会互相顶掉。
// ---------------------------------------------------------------------------
PROC QueueDayNews()
    IF GET_GAME_TIMER() < g_specialUntil
        g_pendingDayNews = g_specialUntil + 2500
    ELSE
        g_pendingDayNews = GET_GAME_TIMER() + 1500
    ENDIF
ENDPROC

// 末日纪时：游戏内跨过 0 点算新的一天（1Hz 调用）
PROC UpdateApocClock()
    IF NOT g_infection
        EXIT
    ENDIF
    INT h = GET_CLOCK_HOURS()

    // ★ v0.26：睡觉刚把时钟往前推过（见 UpdateCampRest）—— 锁窗口内**只同步、不检测**。
    //   不锁的话，睡觉推进的那一天会被这里按"跨过 0 点"再算一次 = 一次睡觉涨两天。
    //   顺便做一次**兼容兜底**：如果 `ADVANCE_CLOCK_TIME_TO` 在这个端口上没生效
    //   （读回的小时不是 6），就用 `SET_CLOCK_TIME` 补一刀。
    //   两者目标时刻相同，所以即使读值滞后一帧也不会跑偏（最坏就是白调一次）。
    IF g_clockLockUntil > 0
        IF GET_GAME_TIMER() >= g_clockLockUntil
            g_clockLockUntil = 0
        ELSE
            IF h <> CAMP_WAKE_HOUR AND g_clockFixTries < 2
                g_clockFixTries = g_clockFixTries + 1
                SET_CLOCK_TIME(CAMP_WAKE_HOUR, 0, 0)
            ENDIF
            g_lastHour = h
            EXIT
        ENDIF
    ENDIF

    IF g_lastHour < 0
        g_lastHour = h
        EXIT
    ENDIF
    IF h < g_lastHour
        // 跨过 0 点 -> 新的一天
        //   ★ v0.26：不再在这里直接 `FireBroadcast` —— 那会顶掉屏上正在显示的消息
        //   （比如你刚睡醒的那句话）。改成排队，由 UpdateBroadcast 统一出口播。
        g_apocDay = g_apocDay + 1
        QueueDayNews()
    ENDIF
    g_lastHour = h
ENDPROC

// 环境广播：2~3 分钟一条（1Hz 调用）。有别的消息在显示时让位，不抢屏。
PROC UpdateBroadcast()
    IF NOT g_infection
        EXIT
    ENDIF

    // ★ v0.26：跨天播报优先，而且是**排队**的 —— 时间没到就继续等
    //   （屏上还压着"睡醒那句话"时不会去顶它）。见 QueueDayNews 的说明。
    IF g_pendingDayNews > 0
        IF GET_GAME_TIMER() >= g_pendingDayNews
            g_pendingDayNews = 0
            g_nextBroadcast = GET_GAME_TIMER() + GET_RANDOM_INT_IN_RANGE(95000, 150000)
            FireBroadcast()
        ENDIF
        EXIT
    ENDIF

    IF GET_GAME_TIMER() < g_nextBroadcast
        EXIT
    ENDIF
    IF GET_GAME_TIMER() < g_specialUntil
        // 屏幕上正有别的提示（尸潮来袭等）-> 稍后再来，别覆盖它
        g_nextBroadcast = GET_GAME_TIMER() + 15000
        EXIT
    ENDIF
    g_nextBroadcast = GET_GAME_TIMER() + GET_RANDOM_INT_IN_RANGE(95000, 150000)
    FireBroadcast()
ENDPROC

// 左下角「末日第 N 天」
//   一行叙事文字、一天才变一次 —— 不是实时计数器，不违背"去计数化"的调性。
//   数值单独画（字符串不能与数字拼接），和右下角的"感染"用同一套绘制助手。
PROC APOC_DAY()
    IF NOT g_infection
        EXIT
    ENDIF
    SET_TEXT_FONT(FONT_STANDARD)
    SET_TEXT_CENTRE(FALSE)
    SET_TEXT_RIGHT_JUSTIFY(FALSE)
    SET_TEXT_WRAP(0.0, 1.0)
    SET_TEXT_DROPSHADOW(1, 0, 0, 0, 235)     // v0.15：阴影加深

    // v0.15：字号变大 + 颜色加深；数字位数不同会改变宽度，所以**按位数算位移**
    FLOAT dx = 0.030
    LABEL_AT(dx, 0.958, "末日第", 255, 205, 90)
    dx = dx + 3.0 * g_cjkW * g_hudScale + 0.012
    NUM_AT(dx, 0.958, g_apocDay, 255, 240, 190)
    FLOAT nw = g_digitW * g_hudScale
    IF g_apocDay >= 10 nw = nw * 2.0 ENDIF
    IF g_apocDay >= 100 nw = nw * 3.0 ENDIF
    dx = dx + nw + 0.012
    LABEL_AT(dx, 0.958, "天", 255, 205, 90)
ENDPROC

PROC MenuAdjust(INT dir)
    IF g_menuIndex = 0
        // 感染模式：主开关。打开/关闭时**连带**开关那五个子系统，
        // 具体联动在主循环的模式边沿处理里（那里才能一次做完全部初始化）。
        g_infection = NOT g_infection
    ELIF g_menuIndex = 1
        g_blackout = NOT g_blackout
        IF NOT g_blackout
            // 关掉停电时顺便解除天气锁定（之前用 SET_OVERRIDE_WEATHER 把天气锁死了，
            // 导致修改器改不了天气；现在停电只控灯，并且重新打开时清掉旧的锁定）
            CLEAR_OVERRIDE_WEATHER()
        ENDIF
    ELIF g_menuIndex = 2
        g_maxZombies = g_maxZombies + dir
        IF g_maxZombies > 3 g_maxZombies = 0 ENDIF
        IF g_maxZombies < 0 g_maxZombies = 3 ENDIF
    ELIF g_menuIndex = 3
        g_spawnLevel = g_spawnLevel + dir
        IF g_spawnLevel > 3 g_spawnLevel = 0 ENDIF
        IF g_spawnLevel < 0 g_spawnLevel = 3 ENDIF
    ELIF g_menuIndex = 4
        g_healthLevel = g_healthLevel + dir
        IF g_healthLevel > 3 g_healthLevel = 0 ENDIF
        IF g_healthLevel < 0 g_healthLevel = 3 ENDIF
    ELIF g_menuIndex = 5
        g_speedLevel = g_speedLevel + dir
        IF g_speedLevel > 3 g_speedLevel = 0 ENDIF
        IF g_speedLevel < 0 g_speedLevel = 3 ENDIF
    ELIF g_menuIndex = 6
        g_mutationLevel = g_mutationLevel + dir
        IF g_mutationLevel > 3 g_mutationLevel = 0 ENDIF
        IF g_mutationLevel < 0 g_mutationLevel = 3 ENDIF
    ELIF g_menuIndex = 7
        g_zombieBlips = NOT g_zombieBlips
        // 切换后立刻对**现有**僵尸生效（新僵尸由 RegisterZombie 处理）
        ApplyZombieBlips()
    ELIF g_menuIndex = 8
        // 护卫指令：跟随 <-> 留守。这里只改状态 + 置脏标志，
        // 真正的任务下发给主循环里的 ApplyGuardMode()（事件驱动，见那里的说明）。
        IF g_guardMode = 0
            g_guardMode = 1
        ELSE
            g_guardMode = 0
        ENDIF
        g_guardModeDirty = TRUE
    ELIF g_menuIndex = 9
        // 放置/拆除营地：这里只置脏标志，真正的动作由主循环执行 ——
        //   SanScript 要求**先定义后调用**，而 PlaceCamp / RemoveCamp 定义在文件后段，
        //   菜单处理函数在很靠前的位置。脏标志模式（同 ApplyGuardMode）正好绕开。
        g_campDirty = TRUE
    ENDIF
ENDPROC

PROC ForgetAllZombies()
    INT i = 0
    WHILE i < g_zombieCount
        IF DOES_ENTITY_EXIST(g_zombies[i])
            SET_ENTITY_AS_MISSION_ENTITY(g_zombies[i], TRUE, TRUE)
            DELETE_PED(g_zombies[i])
        ENDIF
        IF DOES_BLIP_EXIST(g_zBlip[i])
            REMOVE_BLIP(g_zBlip[i])
        ENDIF
        i = i + 1
    ENDWHILE
    g_zombieCount = 0
ENDPROC

// 清场用：把幸存者小队从地图上彻底抹掉
PROC ForgetAllSurvivors()
    INT i = 0
    WHILE i < g_survivorCount
        IF DOES_BLIP_EXIST(g_sBlip[i])
            REMOVE_BLIP(g_sBlip[i])
        ENDIF
        IF DOES_ENTITY_EXIST(g_survivors[i])
            SET_ENTITY_AS_MISSION_ENTITY(g_survivors[i], TRUE, TRUE)
            DELETE_PED(g_survivors[i])
        ENDIF
        i = i + 1
    ENDWHILE
    g_survivorCount = 0
ENDPROC

PROC MenuActivate()
    // v0.19：菜单精简为 9 项，这几个"回车 = 加一档"的索引整体前移
    //   （2..6）；其余是布尔开关，走 ELSE -> MenuAdjust(1)。
    IF g_menuIndex = 2
        g_maxZombies = g_maxZombies + 1
        IF g_maxZombies > 3 g_maxZombies = 0 ENDIF
    ELIF g_menuIndex = 3
        g_spawnLevel = g_spawnLevel + 1
        IF g_spawnLevel > 3 g_spawnLevel = 0 ENDIF
    ELIF g_menuIndex = 4
        g_healthLevel = g_healthLevel + 1
        IF g_healthLevel > 3 g_healthLevel = 0 ENDIF
    ELIF g_menuIndex = 5
        g_speedLevel = g_speedLevel + 1
        IF g_speedLevel > 3 g_speedLevel = 0 ENDIF
    ELIF g_menuIndex = 6
        g_mutationLevel = g_mutationLevel + 1
        IF g_mutationLevel > 3 g_mutationLevel = 0 ENDIF
    ELSE
        MenuAdjust(1)
    ENDIF
ENDPROC

