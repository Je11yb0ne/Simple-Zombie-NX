// ---------------------------------------------------------------------------
// 末日氛围包（v0.14）—— 世界静默 / 末日纪时 / 紧急广播
//
//   【为什么做】照 Reborn 的 WorldController 思路：末日里最出戏的不是少了什么，
//   而是**世界还在正常运转** —— 远处还有车流声、垃圾车在收垃圾、火车在跑、
//   警用电台还在播、救护车还在来。把这些关掉，氛围一下就对了。
//
//   【native 全部经过官方脚本交叉验证】
//     · `SET_AUDIO_FLAG("PoliceScannerDisabled", TRUE)` —— flag 名取自官方脚本
//       `dev_ng/**/*.sc` 里实际出现过的名字（不是猜的）。
//     · `AZ_DISTANT_VEHICLES_CITY_CENTRE` / `AZ_COUNTRYSIDE_DISTANT_CARS_ZONE_01..03`
//       —— 区域名取自官方 `RandomChar/Hao/mission_Race.sc` 的真实用法。
//     · `SET_RANDOM_TRAINS / SET_RANDOM_BOATS / SET_GARBAGE_TRUCKS /
//        SET_DISTANT_CARS_ENABLED` —— 关掉"城市还在运转"的几类环境实体。
//
//   【性能】全是**状态设定**，不是每帧命令：
//     · 开关变化时设一次全套（边沿触发）；
//     · 只有**环境音区**需要低频重申（游戏自己的脚本会在你进入区域时改回去），
//       每 3 秒重申一次 ≈ 5 native/3 秒；
//     · 终止"正常世界"脚本是一次性动作，10 秒最多跑一遍。
//
//   【两个刻意的取舍】
//     1. `STOP_ALL_ALARMS` **只在打开的那一瞬间调一次**，不进重申循环 ——
//        否则会把僵尸砸车时触发的车辆警报一起掐掉（那是个有用的玩法信号）。
//     2. 终止游戏自带脚本是**不可逆**的（引擎没有"重新拉起"的接口）。
//        所以关掉末日氛围只会还原"可还原的那些"（音频 flag / 环境实体 / 音区）。
// ---------------------------------------------------------------------------

// 终止一批"世界还在正常运转"的调度脚本（只有正在运行的会被终止，不在运行的无害）
PROC KillNormalWorldScripts()
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("emergencycall")          // 救护/消防/警力调度
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("emergencycalllauncher")
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("am_taxi")                // 街上还有出租车
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("am_vehicle_spawn")        // 环境载具生成
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("am_vehiclespawn")
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("traffick_air")            // 空中贩毒事件
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("traffick_ground")
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("re_crashrescue")          // 随机救援事件
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("re_rescuehostage")
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("restrictedareas")         // 军事禁区警告
    TERMINATE_ALL_SCRIPTS_WITH_THIS_NAME("audiotest")               // 调试音频脚本
ENDPROC

PROC ApplyAmbience()
    // 只有"僵尸模式开着 + 氛围开关开着"才生效；
    // 关掉僵尸模式会连氛围一起还原（符合"关闭模式 = 恢复正常游戏"的一贯设计）
    IF g_infection AND g_ambience
        IF GET_GAME_TIMER() >= g_nextAmbience
            g_nextAmbience = GET_GAME_TIMER() + 3000

            IF NOT g_ambienceOwned
                // ── 只在刚打开的那一次做全套（一次性动作放这里）──
                g_ambienceOwned = TRUE
                SET_AUDIO_FLAG("WantedMusicDisabled", TRUE)
                STOP_ALL_ALARMS(TRUE)                  // 清掉残留警报（见上面取舍 1）
                SET_RANDOM_TRAINS(FALSE)
                SET_RANDOM_BOATS(FALSE)
                SET_GARBAGE_TRUCKS(FALSE)
                SET_DISTANT_CARS_ENABLED(FALSE)
                // ★ v0.42：**这里不清场了**。
                //   原因：`CLEAR_AREA_OF_PEDS` 会把"感染路人"的素材一起清掉；
                //   `CLEAR_AREA_OF_VEHICLES` 又分不清"在开的车"和"路边停放的车"
                //   （用户要求路边空车留着）。⇒ 只靠密度：**新刷的车没了**，
                //   已经在开的那几辆会自己开出视野；路边停放车照旧保留。
                // v0.24：关掉消防与救护调度（起火的车不会再招来消防车）
                ENABLE_DISPATCH_SERVICE(DT_FIRE_DEPARTMENT, FALSE)
                ENABLE_DISPATCH_SERVICE(DT_AMBULANCE_DEPARTMENT, FALSE)
            ENDIF

            // ── 需要低频重申的：警用电台 flag + 四个远处车流音区 ──
            //   v0.24：调度服务也一起重申 —— 它是状态设定，游戏自己的脚本
            //   （比如车祸/犯罪事件）会在运行时把它改回 TRUE。
            ENABLE_DISPATCH_SERVICE(DT_FIRE_DEPARTMENT, FALSE)
            ENABLE_DISPATCH_SERVICE(DT_AMBULANCE_DEPARTMENT, FALSE)
            SET_AUDIO_FLAG("PoliceScannerDisabled", TRUE)
            SET_AMBIENT_ZONE_STATE("AZ_DISTANT_VEHICLES_CITY_CENTRE", FALSE, FALSE)
            SET_AMBIENT_ZONE_STATE("AZ_COUNTRYSIDE_DISTANT_CARS_ZONE_01", FALSE, FALSE)
            SET_AMBIENT_ZONE_STATE("AZ_COUNTRYSIDE_DISTANT_CARS_ZONE_02", FALSE, FALSE)
            SET_AMBIENT_ZONE_STATE("AZ_COUNTRYSIDE_DISTANT_CARS_ZONE_03", FALSE, FALSE)

        ENDIF

        // 终止"正常世界"的调度脚本（10 秒最多一次；首次在打开瞬间就跑一遍）
        IF GET_GAME_TIMER() >= g_nextAmbienceKill
            g_nextAmbienceKill = GET_GAME_TIMER() + 10000
            KillNormalWorldScripts()
        ENDIF
    ELSE
        // 还原（只还原我们改过的；"终止脚本"不可逆，见取舍 2）
        IF g_ambienceOwned
            g_ambienceOwned = FALSE
            SET_AUDIO_FLAG("PoliceScannerDisabled", FALSE)
            SET_AUDIO_FLAG("WantedMusicDisabled", FALSE)
            SET_RANDOM_TRAINS(TRUE)
            SET_RANDOM_BOATS(TRUE)
            SET_GARBAGE_TRUCKS(TRUE)
            SET_DISTANT_CARS_ENABLED(TRUE)
            ENABLE_DISPATCH_SERVICE(DT_FIRE_DEPARTMENT, TRUE)
            ENABLE_DISPATCH_SERVICE(DT_AMBULANCE_DEPARTMENT, TRUE)
            SET_AMBIENT_ZONE_STATE("AZ_DISTANT_VEHICLES_CITY_CENTRE", TRUE, FALSE)
            SET_AMBIENT_ZONE_STATE("AZ_COUNTRYSIDE_DISTANT_CARS_ZONE_01", TRUE, FALSE)
            SET_AMBIENT_ZONE_STATE("AZ_COUNTRYSIDE_DISTANT_CARS_ZONE_02", TRUE, FALSE)
            SET_AMBIENT_ZONE_STATE("AZ_COUNTRYSIDE_DISTANT_CARS_ZONE_03", TRUE, FALSE)
            // v0.41：车流/人流**不用在这里还原** —— 密度用的是 `*_THIS_FRAME` 版本
            //   （只对当前帧生效），停止重申就自动回到默认值。
        ENDIF
    ENDIF
ENDPROC

// 紧急广播文本（按索引轮换；字符串不能和数字拼接，所以天数单独画）
// ---------------------------------------------------------------------------
// 紧急广播文本（v0.23：从 7 条扩到 54 条）
//
//   【为什么扩】用户希望"多加一些末日电台消息，增加沉浸感"。原来的 7 条顺序轮播，
//   十几分钟就听全了，之后完全是重复；现在 54 条随机播，每次都有新信息。
//
//   【内容取材（都是 GTA 世界观里真实存在的地名）】
//     · 爆发源头与外地城市 —— 卡瑟城（Manhunt 的舞台，被当作最初的感染源）、
