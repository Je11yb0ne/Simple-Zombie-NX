ENDPROC

PROC MenuInput()
    // 开关菜单：**只有 RB + B 这一种组合**
    //   RB = INPUT_FRONTEND_RB，B = INPUT_FRONTEND_CANCEL（本端口上 CANCEL 就是 B，
    //   因为菜单里"单按 B 关闭"用的也是同一个 action，用户已验证可用）。
    //   注意不要再加 INPUT_RELOAD / INPUT_COVER 那条备用路径 —— 那条在本端口实际
    //   命中的是 A 键，会造成"RB+A 也能开菜单"。
    IF IS_CONTROL_PRESSED(FRONTEND_CONTROL, INPUT_FRONTEND_RB)
    AND IS_CONTROL_JUST_PRESSED(FRONTEND_CONTROL, INPUT_FRONTEND_CANCEL)
        g_menuOpen = NOT g_menuOpen
        g_menuIndex = 0
        EXIT
    ENDIF

    IF NOT g_menuOpen
        EXIT
    ENDIF

    // 先禁掉游戏操作（导航键也一并禁掉）
    DisableGameControls()

    // ★★ 关键：被 DISABLE 过的输入必须用 IS_DISABLED_CONTROL_* 来读。
    //    （能正常工作的 ragemenu 就是这么写的）
    //    上/下：支持长按连发（用 g_repeatV）
    IF IS_DISABLED_CONTROL_JUST_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_UP)
        g_menuIndex = g_menuIndex - 1
        IF g_menuIndex < 0 g_menuIndex = MENU_COUNT - 1 ENDIF
        g_repeatV = GET_GAME_TIMER() + 350
    ELIF IS_DISABLED_CONTROL_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_UP)
    AND GET_GAME_TIMER() >= g_repeatV
        g_menuIndex = g_menuIndex - 1
        IF g_menuIndex < 0 g_menuIndex = MENU_COUNT - 1 ENDIF
        g_repeatV = GET_GAME_TIMER() + 120
    ENDIF

    IF IS_DISABLED_CONTROL_JUST_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_DOWN)
        g_menuIndex = g_menuIndex + 1
        IF g_menuIndex >= MENU_COUNT g_menuIndex = 0 ENDIF
        g_repeatV = GET_GAME_TIMER() + 350
    ELIF IS_DISABLED_CONTROL_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_DOWN)
    AND GET_GAME_TIMER() >= g_repeatV
        g_menuIndex = g_menuIndex + 1
        IF g_menuIndex >= MENU_COUNT g_menuIndex = 0 ENDIF
        g_repeatV = GET_GAME_TIMER() + 120
    ENDIF

    // 左/右：改档位（长按同样连发，用 g_repeatH 与上下互不干扰）
    IF IS_DISABLED_CONTROL_JUST_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_LEFT)
        MenuAdjust(-1)
        g_repeatH = GET_GAME_TIMER() + 350
    ELIF IS_DISABLED_CONTROL_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_LEFT)
    AND GET_GAME_TIMER() >= g_repeatH
        MenuAdjust(-1)
        g_repeatH = GET_GAME_TIMER() + 140
    ENDIF

    IF IS_DISABLED_CONTROL_JUST_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_RIGHT)
        MenuActivate()
        g_repeatH = GET_GAME_TIMER() + 350
    ELIF IS_DISABLED_CONTROL_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_RIGHT)
    AND GET_GAME_TIMER() >= g_repeatH
        MenuActivate()
        g_repeatH = GET_GAME_TIMER() + 140
    ENDIF

    // 确认键也能切换
    IF IS_DISABLED_CONTROL_JUST_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_ACCEPT)
        MenuActivate()
    ENDIF

    // 关闭菜单：单按 B
    IF IS_DISABLED_CONTROL_JUST_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_CANCEL)
        g_menuOpen = FALSE
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 资源准备
// ---------------------------------------------------------------------------
// 资源准备
//   ★ 性能要点（Switch 上很要紧）：REQUEST_* 是"挂号"语义，喊一次就行；
//     HAS_*_LOADED 也不需要每帧查。原来这 10 个 REQUEST + 10 个 HAS 每帧都跑，
//     而且只要有一个资源加载不上就永远停在这个状态 —— 等于每帧白烧 20 次 native。
//     现在：REQUEST 只做一次；HAS 检查降到 1 秒一次（加载完成后整个函数直接返回）。
PROC PrepareAssets()
    IF g_modelReady AND g_animReady AND g_copReady AND g_crateReady AND g_carReady
    AND g_animalReady AND g_repairAnimReady AND g_wreckReady AND g_campReady
        EXIT
    ENDIF

    IF NOT g_assetsRequested
        g_assetsRequested = TRUE
        REQUEST_MODEL(U_M_Y_ZOMBIE_01)
        REQUEST_MODEL(A_M_M_BEVHILLS_01)
        REQUEST_MODEL(A_M_M_BUSINESS_01)
        REQUEST_MODEL(A_M_M_HILLBILLY_01)
        REQUEST_MODEL(A_M_M_FARMER_01)
        REQUEST_MODEL(S_M_Y_COP_01)
        REQUEST_MODEL(PROP_MIL_CRATE_01)     // 解药箱
        REQUEST_MODEL(PROP_SKID_TENT_01)     // v0.24 营地：帐篷 + 篝火
        REQUEST_MODEL(PROP_BEACH_FIRE)
        REQUEST_MODEL(EMPEROR)               // 掠夺者车队的轿车
        REQUEST_MODEL(ASEA)                  // v0.22 路上报废车（3 种车型）
        REQUEST_MODEL(PREMIER)
        REQUEST_MODEL(RUMPO)
        REQUEST_MODEL(A_C_BOAR)              // v0.21 野化动物（v0.24 起不再有犬类）
        REQUEST_MODEL(A_C_COYOTE)
        REQUEST_MODEL(A_C_MTLION)
        REQUEST_ANIM_SET("move_m@drunk@verydrunk")
        REQUEST_ANIM_SET("move_m@injured")
        REQUEST_ANIM_DICT("rcmbarry")
        REQUEST_ANIM_DICT("amb@world_human_bum_wash@male@high@idle_a")
        REQUEST_ANIM_DICT("facials@gen_male@base")
        REQUEST_ANIM_DICT("mini@repair")     // v0.21 修车动画（官方 FBI4_Prep2.sc 同款）
        g_assetPoll = GET_GAME_TIMER() + 1000
        EXIT
    ENDIF

    IF GET_GAME_TIMER() < g_assetPoll
        EXIT
    ENDIF
    g_assetPoll = GET_GAME_TIMER() + 1000

    // ★ 问题 3 的根因之一：动画集/字典是流式资源，`REQUEST_*` 是"挂号"语义，
    //   但一旦挂号那次没落地（脚本刚启动、游戏还在加载），之后永远查不到 ——
    //   而我们对走路姿态的设置有 HAS_ANIM_SET_LOADED 前置判断，于是全部被挡掉，
    //   僵尸就按普通人走路了。所以只要还没就绪，就每秒重新挂一次（很便宜）。
    IF NOT g_modelReady
        REQUEST_MODEL(U_M_Y_ZOMBIE_01)
        REQUEST_MODEL(A_M_M_BEVHILLS_01)
        REQUEST_MODEL(A_M_M_BUSINESS_01)
        REQUEST_MODEL(A_M_M_HILLBILLY_01)
        REQUEST_MODEL(A_M_M_FARMER_01)
    ENDIF
    IF NOT g_animReady
        REQUEST_ANIM_SET("move_m@drunk@verydrunk")
        REQUEST_ANIM_SET("move_m@injured")
        REQUEST_ANIM_DICT("rcmbarry")
        REQUEST_ANIM_DICT("amb@world_human_bum_wash@male@high@idle_a")
        REQUEST_ANIM_DICT("facials@gen_male@base")
    ENDIF
    IF NOT g_copReady
        REQUEST_MODEL(S_M_Y_COP_01)
    ENDIF
    IF NOT g_crateReady
        REQUEST_MODEL(PROP_MIL_CRATE_01)
    ENDIF
    IF NOT g_campReady
        REQUEST_MODEL(PROP_SKID_TENT_01)
        REQUEST_MODEL(PROP_BEACH_FIRE)
    ENDIF
    IF NOT g_carReady
        REQUEST_MODEL(EMPEROR)
    ENDIF
    IF NOT g_animalReady
        REQUEST_MODEL(A_C_BOAR)
        REQUEST_MODEL(A_C_COYOTE)
        REQUEST_MODEL(A_C_MTLION)
    ENDIF
    IF NOT g_repairAnimReady
        REQUEST_ANIM_DICT("mini@repair")
    ENDIF
    IF NOT g_wreckReady
        REQUEST_MODEL(ASEA)
        REQUEST_MODEL(PREMIER)
        REQUEST_MODEL(RUMPO)
        REQUEST_MODEL(EMPEROR)
    ENDIF

    IF NOT g_modelReady
        IF HAS_MODEL_LOADED(U_M_Y_ZOMBIE_01)
        AND HAS_MODEL_LOADED(A_M_M_BEVHILLS_01)
        AND HAS_MODEL_LOADED(A_M_M_BUSINESS_01)
        AND HAS_MODEL_LOADED(A_M_M_HILLBILLY_01)
        AND HAS_MODEL_LOADED(A_M_M_FARMER_01)
            g_modelReady = TRUE
        ENDIF
    ENDIF

    IF NOT g_copReady
        IF HAS_MODEL_LOADED(S_M_Y_COP_01)
            g_copReady = TRUE
        ENDIF
    ENDIF

    IF NOT g_crateReady
        IF HAS_MODEL_LOADED(PROP_MIL_CRATE_01)
            g_crateReady = TRUE
        ENDIF
    ENDIF

    IF NOT g_campReady
        IF HAS_MODEL_LOADED(PROP_SKID_TENT_01)
        AND HAS_MODEL_LOADED(PROP_BEACH_FIRE)
            g_campReady = TRUE
        ENDIF
    ENDIF

    IF NOT g_carReady
        IF HAS_MODEL_LOADED(EMPEROR)
            g_carReady = TRUE
        ENDIF
    ENDIF

    IF NOT g_animalReady
        IF HAS_MODEL_LOADED(A_C_BOAR)
        AND HAS_MODEL_LOADED(A_C_COYOTE)
        AND HAS_MODEL_LOADED(A_C_MTLION)
            g_animalReady = TRUE
        ENDIF
    ENDIF

    IF NOT g_repairAnimReady
        IF HAS_ANIM_DICT_LOADED("mini@repair")
            g_repairAnimReady = TRUE
        ENDIF
    ENDIF

    IF NOT g_wreckReady
        // ★ 四种车型全都要就绪 —— RandomWreckModel() 里有 30% 会挑 EMPEROR，
        //   原来这里没检查它，一旦它没加载，那 30% 的尝试就白费。
        IF HAS_MODEL_LOADED(ASEA)
        AND HAS_MODEL_LOADED(PREMIER)
        AND HAS_MODEL_LOADED(RUMPO)
        AND HAS_MODEL_LOADED(EMPEROR)
            g_wreckReady = TRUE
        ENDIF
    ENDIF

    IF NOT g_animReady
        IF HAS_ANIM_SET_LOADED("move_m@drunk@verydrunk")
        AND HAS_ANIM_SET_LOADED("move_m@injured")
        AND HAS_ANIM_DICT_LOADED("rcmbarry")
        AND HAS_ANIM_DICT_LOADED("amb@world_human_bum_wash@male@high@idle_a")
        AND HAS_ANIM_DICT_LOADED("facials@gen_male@base")
            g_animReady = TRUE
        ENDIF
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 关系组（原版 Static/Relationships.cs 的做法）
//   自建组失败时退回到 RELGROUPHASH_HATES_PLAYER —— 至少保证僵尸打玩家
// ---------------------------------------------------------------------------
PROC SetupRelations()
    IF g_relReady
        EXIT
    ENDIF

    IF ADD_RELATIONSHIP_GROUP("ZOMBIE_NX", g_zGroup)
        // 僵尸 <-> 玩家：互相敌对
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_zGroup, RELGROUPHASH_PLAYER)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, RELGROUPHASH_PLAYER, g_zGroup)
        // 僵尸 <-> 普通市民：敌对（感染扩散的基础）
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_zGroup, RELGROUPHASH_CIVMALE)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, RELGROUPHASH_CIVMALE, g_zGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_zGroup, RELGROUPHASH_CIVFEMALE)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, RELGROUPHASH_CIVFEMALE, g_zGroup)
        // 僵尸 <-> 警察：敌对（警察会打僵尸）
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_zGroup, RELGROUPHASH_COP)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, RELGROUPHASH_COP, g_zGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_zGroup, RELGROUPHASH_HATES_PLAYER)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, RELGROUPHASH_HATES_PLAYER, g_zGroup)
        // 僵尸之间互不攻击
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_IGNORE, g_zGroup, g_zGroup)
    ELSE
        g_zGroup = RELGROUPHASH_HATES_PLAYER
    ENDIF

    IF ADD_RELATIONSHIP_GROUP("SURVIVOR_NX", g_sGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_sGroup, g_zGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_zGroup, g_sGroup)
        // 幸存者对玩家友好（不会误伤你）
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_RESPECT, g_sGroup, RELGROUPHASH_PLAYER)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_RESPECT, RELGROUPHASH_PLAYER, g_sGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_IGNORE, g_sGroup, g_sGroup)
    ELSE
        g_sGroup = RELGROUPHASH_AGGRESSIVE_INVESTIGATE
    ENDIF

    // ★ 巡逻警专用关系组（问题 5）：
    //   原来的巡逻警用的是 RELGROUPHASH_COP。问题在于——警方是个"敏感阵营"，
    //   只要你在警察附近开枪，目击到的那名警察就会**直接把你当罪犯开打**，
    //   这跟通缉星级无关（所以压了 SET_MAX_WANTED_LEVEL(0) 也照样挨打）。
    //   给巡逻警单独一个组、并且对玩家设成 RESPECT，游戏就不会再把他算进
    //   "警察对犯罪做出反应"的那套逻辑里 —— 他只认僵尸。
    IF ADD_RELATIONSHIP_GROUP("COP_PATROL_NX", g_copGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_RESPECT, g_copGroup, RELGROUPHASH_PLAYER)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_RESPECT, RELGROUPHASH_PLAYER, g_copGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_copGroup, g_zGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_zGroup, g_copGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_RESPECT, g_copGroup, g_sGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_RESPECT, g_sGroup, g_copGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_IGNORE, g_copGroup, g_copGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_copGroup, RELGROUPHASH_HATES_PLAYER)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, RELGROUPHASH_HATES_PLAYER, g_copGroup)
        g_copGroupOk = TRUE
    ELSE
        g_copGroup = RELGROUPHASH_COP
    ENDIF

    // 掠夺者关系组：跟玩家、僵尸、幸存者、巡逻警全部互为敌对（无法无天）
    IF ADD_RELATIONSHIP_GROUP("RAIDER_NX", g_rGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_rGroup, RELGROUPHASH_PLAYER)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, RELGROUPHASH_PLAYER, g_rGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_rGroup, g_zGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_zGroup, g_rGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_rGroup, g_sGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_sGroup, g_rGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_rGroup, g_copGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_copGroup, g_rGroup)
        SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_IGNORE, g_rGroup, g_rGroup)
        g_rGroupOk = TRUE
    ELSE
        g_rGroup = RELGROUPHASH_HATES_PLAYER
    ENDIF

    g_relReady = TRUE
ENDPROC

// ---------------------------------------------------------------------------
// 僵尸化 / 登记
// ---------------------------------------------------------------------------
PROC MakeIntoZombie(PED_INDEX z, INT t)
    SET_ENTITY_AS_MISSION_ENTITY(z, TRUE, TRUE)

    SET_PED_RELATIONSHIP_GROUP_HASH(z, g_zGroup)
    SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, g_zGroup, RELGROUPHASH_PLAYER)
    SET_RELATIONSHIP_BETWEEN_GROUPS(ACQUAINTANCE_TYPE_PED_HATE, RELGROUPHASH_PLAYER, g_zGroup)

    // 腐尸外观：照原版做法叠加伤害包（血污 + 伤口），不换模型也像僵尸。
    //   参考 mod 用的是 alpha=9.0（重度），比 1.0 明显更"尸"。
    APPLY_PED_DAMAGE_PACK(z, "BigHitByVehicle", 0.0, 9.0)
    APPLY_PED_DAMAGE_PACK(z, "ExplosionMed", 0.0, 9.0)
    APPLY_PED_DAMAGE_PACK(z, "SCR_Torture", 0.0, 9.0)
    // 壮尸再叠一层，看起来更"厚"
    IF t = ZTYPE_BRUTE
        APPLY_PED_DAMAGE_PACK(z, "SCR_Dumpster", 0.0, 9.0)
    ENDIF

    // 被感染的武装路人会把枪丢掉（原版 target.Weapons.Drop()）
    IF IS_PED_ARMED(z, 7)
        SET_PED_DROPS_WEAPON(z)
    ENDIF
    SET_PED_CAN_SWITCH_WEAPON(z, FALSE)

    // 血量按类型（Reborn：壮尸 ×2.7、尖啸者 ×1.35）
    SET_ENTITY_MAX_HEALTH(z, ZombieHealthFor(t))
    SET_ENTITY_HEALTH(z, ZombieHealthFor(t))
    SET_PED_ACCURACY(z, 12)
    // 感知范围也照 Reborn 放大（它用 SensingRange 85 / VisionDistance 24）
    SET_PED_SEEING_RANGE(z, 60.0)
    SET_PED_HEARING_RANGE(z, 85.0)
    SET_PED_ALERTNESS(z, AS_VERY_ALERT)
    SET_PED_COMBAT_MOVEMENT(z, CM_WILLADVANCE)
    SET_PED_COMBAT_ABILITY(z, CAL_POOR)
    SET_PED_COMBAT_RANGE(z, CR_NEAR)
    SET_PED_COMBAT_ATTRIBUTES(z, CA_ALWAYS_FIGHT, TRUE)
    SET_PED_FLEE_ATTRIBUTES(z, FA_NEVER_FLEE, TRUE)
    SET_BLOCKING_OF_NON_TEMPORARY_EVENTS(z, TRUE)
    SET_PED_DIES_WHEN_INJURED(z, FALSE)
    SET_PED_SUFFERS_CRITICAL_HITS(z, FALSE)
    SET_PED_CAN_RAGDOLL(z, TRUE)
    // 移速：Reborn 用 SET_PED_MOVE_RATE_OVERRIDE（1.0 = 普通人），
    // 行尸 0.35 / 跑者 0.85 / 壮尸 0.30 / 尖啸者 0.55，再乘速度档位
    SET_PED_MOVE_RATE_OVERRIDE(z, ZombieRateFor(t))
    // 壮尸血厚且不会被撞倒
    IF t = ZTYPE_BRUTE
        SET_PED_CAN_RAGDOLL_FROM_PLAYER_IMPACT(z, FALSE)
    ENDIF

    // ★ 不说人话（用户反馈 3）：用 PED_CONFIG/RESET 标志去关"说话"，
    //   **而不是**动声道 —— 之前试过把声道换成 "ALIENS"，那是个不存在的声道名，
    //   会把 ped 的整个音源弄哑（连嘶吼一起没了）。
    //   · PCF_DontShoutTargetPosition(437)：不再喊"他在这儿！"这类报点台词
    //   · 每帧的 PRF_DisableTalk / PRF_DisableCombatAudio 见 UpdateZombieWorld
    SET_PED_CONFIG_FLAG(z, INT_TO_ENUM(PED_CONFIG_FLAGS, 437), TRUE)

    // 僵尸化：不发呆动作、不攀爬
    SET_PED_CAN_PLAY_AMBIENT_ANIMS(z, FALSE)
    SET_PED_CAN_PLAY_GESTURE_ANIMS(z, FALSE)
    SET_PED_CAN_EVASIVE_DIVE(z, FALSE)
    SET_PED_PATH_CAN_USE_LADDERS(z, FALSE)

    // ★ 声音（v0.9 重做）——两件事必须同时成立：
    //   (a) 僵尸不能说人话；(b) 僵尸要会吼。
    //   v0.8 用"每帧 PRF_DisableTalk"来堵嘴 —— 那是个**每帧重置的日志标志**，
    //   它把 ped 的说话/战斗发声整条通道都关掉了，代价是连嘶吼一起没了。
    //   现在改用**声源替换**（FiveM 的 RottenV 就是这么做的，是经过实战验证的写法）：
    //     `SET_AMBIENT_VOICE_NAME(z, "ALIENS")`
    //   之后这个 ped 的所有发声都走怪物声道 —— 说不出人话，只会发出低沉的
    //   怪物嘶吼。人话被从源头消灭，因此**不需要**再去每帧屏蔽发声。
    //   同时保留痛觉音效开启 —— 我们的 ZombieRoar() 正是用痛觉音来吼的，
    //   声道一换，那些惨叫/呻吟就自动变成怪物的嘶吼声。
    SET_AMBIENT_VOICE_NAME(z, "ALIENS")
    DISABLE_PED_PAIN_AUDIO(z, FALSE)

    // 死了不要派救护车（PCF_AllowMedicsToAttend = 20）
    SET_PED_CONFIG_FLAG(z, INT_TO_ENUM(PED_CONFIG_FLAGS, 20), FALSE)

    // 醉酒：踉跄动作 + 含糊喉音
    SET_PED_IS_DRUNK(z, TRUE)

    TASK_WANDER_STANDARD(z)
    SET_PED_KEEP_TASK(z, TRUE)
ENDPROC

PROC RegisterZombie(PED_INDEX z, INT t)
    IF g_zombieCount >= MAX_ZOMBIES
        EXIT
    ENDIF

    g_zombies[g_zombieCount] = z
    g_zAggro[g_zombieCount] = FALSE
    g_zType[g_zombieCount] = t
    g_zAttacking[g_zombieCount] = FALSE
    g_zNextAttack[g_zombieCount] = 0
    g_zTarget[g_zombieCount] = NULL
    g_zTargetTime[g_zombieCount] = 0
    g_zThink[g_zombieCount] = 0
    g_zNextRoar[g_zombieCount] = GET_GAME_TIMER() + GET_RANDOM_INT_IN_RANGE(3000, 12000)
    g_zNudge[g_zombieCount] = 0
    g_zNextSmash[g_zombieCount] = 0
    g_zApproachUntil[g_zombieCount] = 0
    g_zNextVoice[g_zombieCount] = GET_GAME_TIMER() + GET_RANDOM_INT_IN_RANGE(1000, 4000)

    // ★ v0.13：僵尸的地图标记改成**可配置**（菜单最后一项「僵尸地图标记」）。
    //   默认关闭 = v0.12 的行为（僵尸只靠眼睛看）；打开后每只僵尸一个红点，
    //   壮尸大一圈、尖啸者稍大，便于在地图上判读威胁等级。
    IF g_zombieBlips
        g_zBlip[g_zombieCount] = ADD_BLIP_FOR_ENTITY(z)
        SET_BLIP_COLOUR(g_zBlip[g_zombieCount], 1)
        IF t = ZTYPE_BRUTE
            SET_BLIP_SCALE(g_zBlip[g_zombieCount], 1.1)
        ELIF t = ZTYPE_SCREAMER
            SET_BLIP_SCALE(g_zBlip[g_zombieCount], 0.9)
        ELSE
            SET_BLIP_SCALE(g_zBlip[g_zombieCount], 0.7)
        ENDIF
        SET_BLIP_AS_SHORT_RANGE(g_zBlip[g_zombieCount], TRUE)
    ELSE
        g_zBlip[g_zombieCount] = NULL
    ENDIF

    // ★ v0.23：**删掉"壮尸/尖啸者出现了"的提示**（用户要求）。
    //   变种该靠外观和体型自己认出来 —— 弹文字提示反而削弱了紧张感。
    //   （尖啸者的"招来尸群"仍有声音与尸潮提示作为反馈。）

    g_zombieCount = g_zombieCount + 1
ENDPROC

// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 目标选择 / 受保护角色判定
// ---------------------------------------------------------------------------
// ★ 受保护角色判定 —— 绝对不碰的 ped（麦克的家人、剧情角色、玩家）
//   这是上一版"家人又被感染"的根因：僵尸侧的感染扩散只判断了 CIVMALE/CIVFEMALE，
//   而家人（Amanda / Jimmy / Tracey）在 ped type 上就是普通市民，于是被当成了猎物。
//   现在的多重保险：
//     1. 模型黑名单 —— 三个家人的 IG_ 模型（最直接、最可靠）
//     2. IS_ENTITY_A_MISSION_ENTITY —— 剧情角色通常是 mission entity
//     3. IS_PED_A_PLAYER —— 排除玩家本人
FUNC BOOL IsProtectedPed(PED_INDEX p)
    IF IS_PED_MODEL(p, IG_AMANDATOWNLEY) RETURN TRUE ENDIF
    IF IS_PED_MODEL(p, IG_JIMMYDISANTO) RETURN TRUE ENDIF
    IF IS_PED_MODEL(p, IG_TRACYDISANTO) RETURN TRUE ENDIF
    IF IS_ENTITY_A_MISSION_ENTITY(p) RETURN TRUE ENDIF
    IF IS_PED_A_PLAYER(p) RETURN TRUE ENDIF
    RETURN FALSE
ENDFUNC

// ---------------------------------------------------------------------------
// 感染街上的人（首选来源；找不到人才凭空生成）
// ---------------------------------------------------------------------------
FUNC BOOL InfectNearbyPed()
    IF g_zombieCount >= ActiveCap()
        RETURN FALSE
    ENDIF

    PED_INDEX found[16]
    INT n = GET_PED_NEARBY_PEDS(PLAYER_PED_ID(), found, PEDTYPE_INVALID)
    IF n <= 0
        RETURN FALSE
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)
    FLOAT maxD = SpawnDistance()

    // 从随机位置开始扫，避免每次都感染同一批人
    INT start = GET_RANDOM_INT_IN_RANGE(0, n)
    INT k = 0

    WHILE k < n
        INT idx = start + k
        IF idx >= n
            idx = idx - n
        ENDIF

        PED_INDEX p = found[idx]

        // 过滤条件（缺一不可）：
        //   IS_PED_A_PLAYER      -> 排除玩家本人
        //   IS_PED_HUMAN         -> 排除动物
        //   NOT ON_SCREEN        -> 只在画面外动手，避免眼前变脸，
        //                           也顺带避开屋里的剧情人物（家人等）
        //   GET_PED_TYPE         -> 只收普通市民，剧情 NPC 多为其它类型
        //   NOT IsProtectedPed   -> 家人 / 剧情角色（模型黑名单 + mission entity）
        IF DOES_ENTITY_EXIST(p)
        AND p <> player
        AND NOT IS_PED_A_PLAYER(p)
        AND IS_PED_HUMAN(p)
        AND NOT IS_ENTITY_DEAD(p, FALSE)
        AND NOT IS_ENTITY_ON_SCREEN(p)
        AND GET_PED_RELATIONSHIP_GROUP_HASH(p) <> g_zGroup
        // ★ 问题 1 的主因：幸存者小队和招募来的护卫**也是普通市民类型**，
        //   原来这条过滤没排除他们 —— 于是在你视线外，我们的刷怪器会把你的
        //   幸存者/护卫直接"同化"成僵尸：地图上的蓝点还在（我们没删 blip），
        //   但人已经不是人了，你站到"幸存者"旁边按互动键当然毫无反应。
        AND GET_PED_RELATIONSHIP_GROUP_HASH(p) <> g_sGroup
        // 车里的人不碰：同化之后他会一直坐在驾驶座上（僵尸开车），
        // 既不合理也永远不会下来，等于凭空多出一辆"僵尸车"。
        AND NOT IS_PED_IN_ANY_VEHICLE(p)
        // ★ v0.22：屋里的人也不碰 —— 否则玩家躲进室内时，屋里（画外）的人会被
        //   我们隔空感染成僵尸，等于"室内凭空冒出僵尸"，正是用户要杜绝的现象。
        AND GET_INTERIOR_FROM_ENTITY(p) = NULL
        AND NOT IsProtectedPed(p)
            PED_TYPE t = GET_PED_TYPE(p)
            IF t = PEDTYPE_CIVMALE OR t = PEDTYPE_CIVFEMALE
                FLOAT d = GET_DISTANCE_BETWEEN_COORDS(pc, GET_ENTITY_COORDS(p, TRUE), TRUE)
                IF d > 15.0
                AND d < maxD
                    INT zt = RollZombieType()
                    MakeIntoZombie(p, zt)
                    RegisterZombie(p, zt)
                    RETURN TRUE
                ENDIF
            ENDIF
        ENDIF

        k = k + 1
    ENDWHILE

    RETURN FALSE
ENDFUNC

// ---------------------------------------------------------------------------
// 凭空生成（保底：附近没人的时候）
//   学 RottenV 的 zombiespawner.lua：
//     · 在玩家周围随机取点，再用 GET_GROUND_Z_FOR_3D_COORD **贴地**
//       （直接拿玩家 z+0.5 会把人生成在半空、楼顶或墙里）
//     · 一次生成一小群（1~3 只），而不是"凭空冒出来一只"
// ---------------------------------------------------------------------------
// 记录一个失败的落点（4 格环形缓冲）
PROC RememberFail(VECTOR p)
    g_failPos[g_failNext] = p
    g_failNext = g_failNext + 1
    IF g_failNext > 3 g_failNext = 0 ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 生成一只僵尸 —— 参考 Reborn 的 TryGetTravelSpawnPoint + IsSafeSpawnPoint：
//   1. **在玩家前方流式生成**：按玩家/载具朝向取点（58% 落在 ±68°，其余甩到侧后方），
//      而不是随机绕圈 —— 这样僵尸会"从你要去的方向涌出来"
//   2. 距离随状态变化：步行 45~115m；开车时更远（速度越快越远，最多 ~195m）
//   3. 位置验证：贴地 + **与玩家高差 ≤12m**（挡掉屋顶/立交桥上）+ 地面坡度检查
//      （三点采样，高差 >1.55m 视为斜坡/屋顶边缘，否决）
//   4. 失败记录：最近失败的落点会进一个小环形缓冲，12m 内不再重复尝试
//      （Reborn 用 18m×10m 网格 + 900ms 冷却；我们没有字典，用 4 格环形缓冲等效）
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 落点校验（僵尸与野化动物共用）—— v0.22
//
//   ★ 用户反馈的三个问题都在这里解决：
//     1. 「僵尸会生成在室外建筑楼顶上」
//        根因：`GET_GROUND_Z_FOR_3D_COORD` 返回的是**最高的那一层地面** ——
//        楼顶、高架、桥面在它眼里都是"地面"。原来只有"与玩家高差 ≤12m"这一条，
//        挡得住"比你高很多的楼顶"，挡不住**你旁边那栋两层小楼的顶**（只高 4~6m）。
//        现在加一条**道路层校验**：用 `GET_CLOSEST_VEHICLE_NODE` 找最近的"车行节点"
//        （车行节点只存在于街道 / 车道 / 车库通道上，**永远不会在楼顶**），
//        落点与它的高差超过 `ROOF_Z_TOL`（2.5m）就否决 —— 这就是"只在地面生成"。
//        查不到节点（山里、荒地、沙漠）时退化成更严的"与玩家高差 ≤6m"。
//     2. 「不能在室内生成」
//        `GET_INTERIOR_AT_COORDS` 返回非 NULL = 落在室内实例里 -> 否决。
//        （官方脚本就是用 `!= NULL` 判断"在室内"的，见 AM_CONTACT_REQUESTS.sc:633）
//     3. 顺带把僵尸和动物那两套重复的校验合一 —— 以后只改一处。
//
//   ★ 调用顺序按"便宜到贵"排：室内 1 次 native -> 高差 0 次 -> 道路层 1 次
//     -> 坡度 2 次 -> 占位 1 次。前面否决就短路，不浪费后面的调用。
//     （Switch 上 native 贵，这个顺序是有意的）
// ---------------------------------------------------------------------------
FUNC BOOL GroundSpotOK(VECTOR spot, VECTOR pc, FLOAT gz, FLOAT radius)
    PED_INDEX player = PLAYER_PED_ID()

    // (0) ★★ v0.44：**先判断这一带是"城里"还是"野外"**（判据 = 最近的车行节点有多远）。
    //     这一步必须在"高差"之前做 —— 因为两者的高差口径完全不同（见下）。
    VECTOR nodePos
    VECTOR f1
    VECTOR f2
    BOOL wild = TRUE
    IF GET_CLOSEST_VEHICLE_NODE(spot, nodePos, NF_NONE, 1.0, 1.0)
        f1.x = spot.x
        f1.y = spot.y
        f1.z = 0.0
        f2.x = nodePos.x
        f2.y = nodePos.y
        f2.z = 0.0
        IF VDIST2(f1, f2) <= 100.0          // 10²：节点在 10 米内 -> 不在野外
            wild = FALSE
        ENDIF
    ENDIF

    // (1) 室内否决
    IF GET_INTERIOR_AT_COORDS(spot) != NULL
        RETURN FALSE
    ENDIF

    // (1.5) ★ v0.45：**水里不刷**（用户要求）
    //   判据：该点若有水面、且落点高度**低于/接近水面** ⇒ 判为水里。
    //   （桥上、码头、水面上方的平台是"高于水面"，照常允许。）
    FLOAT wh
    //   ★ 用 `_NO_WAVES` 版：官方 INFO 写着含波浪那版"结果会随具体帧变化"，
    //     在岸边做判定会抖 —— 无波浪版帧间一致。
    IF GET_WATER_HEIGHT_NO_WAVES(spot, wh)
        IF spot.z < wh + 0.3
            RETURN FALSE
        ENDIF
    ENDIF

    // (2) 与玩家高差
    //   ★★ v0.44 修 BUG【山上不刷僵尸】（主因之二）：
    //     原来死守 ±12m。城里平坦，这条几乎不触发；**可山地里 30~130 米外的地形
    //     动不动就差 15~30 米** ⇒ 那一片的候选点**全被这一条否掉**。
    //     ⇒ 野外放宽到 **±25m**（僵尸爬个坡下来完全正常），城里仍是 ±12m（挡楼顶）。
    FLOAT zdiff = spot.z - pc.z
    IF wild
        IF zdiff > 25.0 OR zdiff < -25.0
            RETURN FALSE
        ENDIF
    ELSE
        IF zdiff > 12.0 OR zdiff < -12.0
            RETURN FALSE
        ENDIF
    ENDIF

    // (3) 道路层校验（"别上屋顶"的真正手段）：**只在"路边"用严格口径**
    //   ★ v0.42 起的教训：城里好用，但山里玩家附近往往就是有条山下公路
    //     （节点在几十米外、低几十米）⇒ 高差远超 2.5m ⇒ 整片被否。
    //     ⇒ 野外这一条**干脆不做**（靠上面的高差 + 下面的坡度/占位把关）。
    IF NOT wild
        FLOAT dz = spot.z - nodePos.z
        IF dz < 0.0 dz = 0.0 - dz ENDIF
        IF dz > ROOF_Z_TOL
            RETURN FALSE
        ENDIF
    ENDIF

    // (4) 地面坡度：中心 + 左右各 1.8m，高差 >1.55m 判为斜坡/屋沿
    FLOAT g1 = 0.0
    FLOAT g2 = 0.0
    VECTOR pA
    VECTOR pB
    pA.x = spot.x + 1.8
    pA.y = spot.y
    pA.z = spot.z + 2.0
    pB.x = spot.x - 1.8
    pB.y = spot.y
    pB.z = spot.z + 2.0
    IF GET_GROUND_Z_FOR_3D_COORD(pA, g1)
    AND GET_GROUND_Z_FOR_3D_COORD(pB, g2)
        FLOAT dA = g1 - gz
        FLOAT dB = g2 - gz
        IF dA < 0.0 dA = 0.0 - dA ENDIF
        IF dB < 0.0 dB = 0.0 - dB ENDIF
        IF dA > 1.55 OR dB > 1.55
            RETURN FALSE
        ENDIF
    ENDIF

    // (5) 有没有被别的实体占着
    IF IS_POSITION_OCCUPIED(spot, radius, FALSE, TRUE, TRUE, FALSE, FALSE, player, FALSE)
        RETURN FALSE
    ENDIF

    RETURN TRUE
ENDFUNC

// ---------------------------------------------------------------------------
// 营地（v0.24）—— 帐篷 + 篝火 + 安全区 + 休息
//
//   【为什么做】用户想要"在野外能休息的地方"：搭个帐篷、生堆火，周围不再刷东西。
//   这补上了本模组一直缺的一环 —— 之前你在野外只能一直跑，没有任何"落脚点"。
//
//   【安全区】半径 35m 内不刷新：僵尸（含尸潮补波）/ 掠夺者车队 / 野生动物 / 报废车。
//     ★ 一个刻意的边界：**已经被你吸引过来的僵尸不会被赶走**，也不会在这里凭空消失。
//       营地是"不会再冒出新的"，不是"绝对无敌区" —— 想休息得先把附近清干净。
//       休息时如果 20m 内有僵尸，会直接拒绝（见 StartCampRest），
//       免得变成"被围住也能一觉到天亮"的逃课手段。
//
//   【物体为什么能一直留着】和报废车同一套道理，但物体更省心：
//     `CREATE_OBJECT(..., ScriptHostObject = TRUE)` + `SET_ENTITY_DYNAMIC(FALSE)`
//     + `FREEZE_ENTITY_POSITION(TRUE)` + `SET_ENTITY_AS_MISSION_ENTITY(TRUE, TRUE)`。
//     最后那条是关键：不然引擎会在你走远之后把帐篷当普通环境物件回收掉，
//     回来一看营地没了。
// ---------------------------------------------------------------------------

// 这个坐标在不在营地的安全区里（没有营地时永远返回 FALSE，几乎零成本）
FUNC BOOL InCampSafeZone(VECTOR p)
    IF NOT DOES_ENTITY_EXIST(g_tent)
        RETURN FALSE
    ENDIF
    RETURN (VDIST2(p, g_campPos) < CAMP_SAFE_R2)
ENDFUNC



// 小数文本（诊断用）—— NUM_AT 只能画整数，这里用 ADD_TEXT_COMPONENT_FLOAT

FUNC BOOL NearCamp()
    IF NOT DOES_ENTITY_EXIST(g_tent)
        RETURN FALSE
    ENDIF
    PED_INDEX pl = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(pl)
        RETURN FALSE
    ENDIF
    RETURN (VDIST2(GET_ENTITY_COORDS(pl, TRUE), g_campPos) < CAMP_REST_RANGE2)
ENDFUNC

// 每帧刷新"玩家在不在安全区"（没有营地时提前退出，等于 0 次 native）
PROC UpdateCampSafeZone()
    IF NOT DOES_ENTITY_EXIST(g_tent)
        g_playerSafe = FALSE
        EXIT
    ENDIF
    PED_INDEX pl = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(pl)
        g_playerSafe = FALSE
        EXIT
    ENDIF
    g_playerSafe = (VDIST2(GET_ENTITY_COORDS(pl, TRUE), g_campPos) < CAMP_SAFE_R2)
ENDPROC

PROC RemoveCamp()
    IF DOES_BLIP_EXIST(g_campBlip)
        REMOVE_BLIP(g_campBlip)
    ENDIF
    g_campBlip = NULL
    // 删除前先**解除 mission entity 标记**再删 —— 和 FixWreck 里"修好之后交还引擎"
    // 是同一个道理：带标记的实体不该被直接删掉（引擎的归属关系会不一致）。
    IF DOES_ENTITY_EXIST(g_campfire)
        SET_ENTITY_AS_MISSION_ENTITY(g_campfire, FALSE, FALSE)
        DELETE_OBJECT(g_campfire)
    ENDIF
    g_campfire = NULL
    IF DOES_ENTITY_EXIST(g_tent)
        SET_ENTITY_AS_MISSION_ENTITY(g_tent, FALSE, FALSE)
        DELETE_OBJECT(g_tent)
    ENDIF
    g_tent = NULL
    g_campPos.x = 0.0
    g_campPos.y = 0.0
    g_campPos.z = 0.0
    g_playerSafe = FALSE
    g_campFadePhase = 0
ENDPROC

// ---------------------------------------------------------------------------
// 营地物件"落地稳定"（v0.27）—— 让**物理**把它放到地面上，落稳后再冻结
//
//   【为什么不再算坐标】
//     前两版都在试图**算出**正确的 z，两次都错，而且方向相反：
//       · v0.25 用 `GET_ENTITY_HEIGHT_ABOVE_GROUND` 当"底部离地高度"
//         -> 帐篷埋掉一半（那个量测的是**实体原点**，不是底部）；
//       · v0.26 用 `GET_MODEL_DIMENSIONS` 的 min.z 反推
//         -> **帐篷和篝火一起浮起约 1 米**，而且两者浮起的高度几乎一样
//            （说明那个位移不是模型自身的尺寸，而是我们算出来的一个常数）。
//     两次的教训是同一条：**这个端口上"物件的哪个点会落在给定坐标上"没法从
//     native 文档推出来**（`CREATE_OBJECT` 那句 "offset (from the root the base)"
//     到底指什么，两种解释都跟实测对不上）。再猜第三种公式就是拿测试时间赌博。
//
//   ⇒ 改用**不需要知道任何语义**的办法：抬高 1.4m 生成 -> 打开重力 ->
//     等它自己落到地面上 -> 冻结。**物理只会把它放到"底部接触地面"为止**，
//     这件事完全不需要我们理解模型的原点在哪。
//
//   唯一的代价：刚放下的那一瞬间物件会有一个约 1 米的"落下"动作（约 0.5 秒），
//   观感上像"把它往地上一放"。换来的是"不管哪个模型都一定贴地"。
//
//   落稳后做三件事：冻结、按**最终**位置重设安全区圆心、检查有没有掉穿地面
//   （在桥洞/水面/空洞上落下去，就宁可不要这个营地，也不让你守着一个悬空的帐篷）。

// 在玩家面前搭营地（帐篷 + 篝火）
// ---------------------------------------------------------------------------
// 营地物件的"落地收尾"（v0.32 定稿）
//
//   这一处从 v0.24 到 v0.32 改了 10 版，最后一次能收敛靠的是**换机制**而不是换公式：
//
//   【为什么用"物理落地"】
//     · `CREATE_OBJECT(..., ForceToBeObject = FALSE)` 创建的是**普通动态道具**，
//       受重力与碰撞控制（v0.6 的解药箱就是这种 —— 一撞就滚，说明物理确实接管它）；
//     · `ForceToBeObject = TRUE` 创建的是**静态物件**，本端口物理**不接管**
//       （v0.27 实测：抬高 1.4 米它不下落）—— 那条路失败的原因就在这里。
//     ⇒ 所以"抬高 1 米多、让它自己落下来"这条路**本来是对的**，只是当初用了错的那一个
//       创建参数，于是"物理没接管"。现在用对参数，它就成立了。
//
//   【这条路同时解决了两件事 —— 这才是它值钱的地方】
//     ① "该落在哪个高度"完全交给物理：落点就在物件**自己的 x/y** 上，
//        斜坡、台阶、路缘、桥面全都自动正确（不再需要"探测别处的地面"）；
//     ② "给定坐标对应物件哪个点"不再需要知道：落地是碰撞决定的，不是我们算出来的。
//        前 9 版反复失败的根，就是想用一个我们自己算的高度去描述引擎的锚点语义。
//
//   【时机】速度归零即可收尾（最短 0.25 秒，最长 1.6 秒封顶），然后：
//     冻结成静态物件 + 恢复朝向 + 标 mission entity + 设防护。
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 营地落点取样："**人能站的地面**"高度（v0.34 定稿的最后一环）
//
//   前 11 版先后试过四种"表面"来源，全都不行：
//     · 玩家脚下 `pc.z` —— 只在**玩家自己那个 x/y** 上是真实表面；挪到 3 米外就不是了
//       （v0.33 实测：把物件原点放到 pc.z 后仍然浮 ~0.5 米 ⇒ 那 3 米外的地面比脚下低 0.5）；
//     · `GET_GROUND_Z_FOR_3D_COORD` —— 读的是**地形网格**（不认人行道/台阶/坡面），
//       误差在 1 米量级且符号不定；
//     · 射线（shape test）—— 本端口**四次调用零命中**，完全不可用；
//     · 靠物理落地 —— 这两个模型是**静态道具**，`ACTIVATE_PHYSICS` 也叫不动（v0.33 实测）。
//   ⇒ 正解是 `GET_SAFE_COORD_FOR_PED`：官方注释 *"Checks to see if it can find a
//     **safe bit of ground to place a ped**"* —— 它查的是**导航网格（navmesh）**，
//     也就是"人能站的地面"，和地形网格是两回事（人行道、台阶、坡面在导航网格里是对的）。
//     R* 自己在 `re_abandonedcar.sc` / `taxiService.sc` 里就是这么给 ped 找落点的；
//     而且它**返回一个已经吸到地面的坐标**，正是我们要的东西。
//   官方 INFO 提醒它**开销不小**（要等导航网格查询），所以只在搭营那一刻调两次；
//   取不到（荒郊没有导航面）就退回玩家脚下的高度 —— 那也是最保险的已知值。
//
//   ★★ v0.35：v0.34 实测 `帐篷读回 − 地表 = 1.53`（正好是那个模型偏移 ⇒ 引擎确实按
//      "坐标 = 底部"处理），**但画面看上去仍然浮着** ⇒ 剩下的可能只有两个：
//      ① "引擎认的底部"和"眼睛看到的最低处"不是同一个点；
//      ② 导航面本身比真实地面高（它是"给 ped 用的面"，不是视觉表面）。
//      两个都要**测**，不能推：
//      ① 用 `GET_MODEL_DIMENSIONS` 的包围盒最低点当"最低几何"（唯一可测的口径），
//         见 `SitObjectOnSurface`；
//      ② 在**玩家脚下**量一次导航面 —— 他正站在真实地面上，那是场景里**唯一**一块
//         我们确知的地面，`量到的值 − pc.z` 就是导航面的**系统偏差**，
//         再从 3 米外的落点读数里减掉。
//
//   ★★ v0.36 定稿（第十四版）：**只信"就在正下方"的面，否则退回玩家脚下。**
//     v0.35 实测把两个未知都钉死了：
//       · `模型底 = -1.53` == 引擎的创建偏移 ⇒ 引擎认的"底部"**就是**模型最低几何；
//       · `源 = 2` ⇒ 帐篷那一点导航面**横向吸走 >1.5 米**，返回的 z 是**别处**的地面；
//       · `偏差 = 0.00` ⇒ 导航面在**玩家自己那点**是准的（== 脚下高度）。
//     ⇒ 原则：**从别处借来的高度，一律不用。**
//       现在从 `refZ` 起往下试三个探测高度，**只接受水平距离 ≤ 0.75 米的返回点**
//       （面就在正下方，它的 z 才代表这个位置）；一个都没有就退回 `pc.z`。
//        最后再用 `GET_ENTITY_HEIGHT_ABOVE_GROUND`（官方：*Gets the entity's height
//        above the ground*）实测一次"原点离地高度"做闭环校正 —— 浮了往下、埋了往上，
//        限幅 0.8 米，读数为 0 或离谱时自动不动（等于这条机制在本端口无效）。
// ---------------------------------------------------------------------------
FUNC FLOAT CampSurfaceZ(FLOAT csx, FLOAT csy, FLOAT refZ)
    VECTOR probe
    VECTOR safePos
    VECTOR flat1
    VECTOR flat2
    FLOAT bestLat
    FLOAT bestZ
    FLOAT lat2
    INT tryN
    BOOL got
    BOOL trust
    probe.x = csx
    bestLat = 9999.0
    bestZ = refZ
    tryN = 0
    got = FALSE
    trust = FALSE
    // 三个探测高度：`refZ` / `refZ-0.8` / `refZ-1.6`。
    //   为什么要多试：v0.35 实测导航面在 `refZ+1.0` 处会**横向吸走 1.5 米以上**，
    //   很可能就是探测点离导航面太远（搜索体积没罩住脚下那块面）。
    //   这里从"跟脚底齐平"往下试 —— 导航面一般就在探测点下方或同高。
    WHILE tryN < 3 AND NOT trust
        probe.x = csx
        probe.y = csy
        probe.z = refZ - 0.8 * tryN
        // ★ v0.45（本轮审查修正）：加 `GSC_FLAG_NOT_WATER` —— 原来会接受"水面的导航面"，
        //   于是营地有可能搭在水上。
        IF GET_SAFE_COORD_FOR_PED(probe, FALSE, safePos, GSC_FLAG_NOT_WATER)
            // 只量**水平**距离（两点压到 z=0），判断返回点是不是就在我们要的 x/y 上
            flat1.x = csx
            flat1.y = csy
            flat1.z = 0.0
            flat2.x = safePos.x
            flat2.y = safePos.y
            flat2.z = 0.0
            lat2 = VDIST2(flat1, flat2)
            IF lat2 < bestLat
                bestLat = lat2
                bestZ = safePos.z
                got = TRUE
            ENDIF
            IF lat2 <= 0.5625              // 0.75²：面就在正下方 -> 它的 z 才代表这个位置
                trust = TRUE
            ENDIF
        ENDIF
        tryN = tryN + 1
    ENDWHILE
    // ★★ 原则：**"从别处借来的高度"一律不用**。
    //   没有"正下方"的结果时，宁可退回 `pc.z`（玩家脚下 —— 场景里唯一确知在地面上的
    //   高度），也不再相信任何一个吸走的 z。v0.35 的 `源=2` 就是这么浮起来的。
    IF NOT trust
        RETURN refZ
    ENDIF
    RETURN bestZ
ENDFUNC

// ---------------------------------------------------------------------------
// 把物件的"最低几何"精确摆到面上（v0.35）
//
//   背景：v0.34 让"坐标 = 导航面"，实测 `帐篷读回 − 地表 = 1.53` = 那个模型偏移
//   ⇒ 引擎确实是"给定坐标 = 物件底部"的语义。**可是画面看上去还是浮着。**
//   于是只剩两种解释，而这一版把两种都做成"可测"：
//     · 引擎认的"底部"和眼睛看到的最低处不是同一个点（包围盒能给出一个客观口径）；
//     · 导航面比真实地面高（用玩家脚下的活标尺量出来）。
//
//   这里做前者：`GET_MODEL_DIMENSIONS(mdl, mn, mx)` 给的是模型**局部**包围盒
//   （相对实体原点），所以"最低几何的世界高度" = `读回 z + mn.z`。
//   而 `SET_ENTITY_COORDS` 实测**没有**模型偏移（v0.33：请求 73.80 读回 73.80），
//   所以可以直接按差值精确平移，不用再管引擎的锚点语义。
//   跑两轮以吃掉"平移残差"，最终让 `读回 z + mn.z == 面上高度`。
//
//   ★ 保险：单次修正量超过 1 米就**放弃不动**（说明包围盒语义和我们的假设不符），
//     把它交给诊断行 —— 宁可停在旧位置，也不要一头扎进地里。
//   ★ 如果 `GET_MODEL_DIMENSIONS` 在本端口无效（返回 0），这里自然变成空操作，
//     诊断行的 `模型底` 会显示 0.000 —— 那就是换方案的信号。
// ---------------------------------------------------------------------------
FUNC FLOAT SitObjectOnSurface(OBJECT_INDEX sobj, MODEL_NAMES smdl, FLOAT bx, FLOAT by, FLOAT surfZ, FLOAT sink)
    VECTOR mn
    VECTOR mx
    VECTOR now2
    VECTOR fix2
    FLOAT need
    FLOAT hNow
    FLOAT err
    FLOAT applied
    FLOAT result
    INT pass2
    BOOL off2
    INT pass3
    BOOL off3
    result = -9999.0
    applied = 0.0
    // ★ 注意：FUNC 里**不能**用 EXIT（*"Cannot use EXIT in a FUNC"*），
    //   也不能用 BREAK 跳出循环（*"BREAK outside any SWITCH"*）—— 只能让条件自己结束。
    IF DOES_ENTITY_EXIST(sobj)
        GET_MODEL_DIMENSIONS(smdl, mn, mx)

        // ① 用包围盒最低点（= 引擎认的"底部"，v0.35 实测两者相等）精确压到目标面
        pass2 = 0
        off2 = TRUE
        WHILE pass2 < 2 AND off2
            pass2 = pass2 + 1
            now2 = GET_ENTITY_COORDS(sobj, TRUE)
            need = surfZ - (now2.z + mn.z)        // 正数 = 还要往下挪
            IF need > -0.04 AND need < 0.04
                off2 = FALSE                      // 已经在容差里
            ELIF need < -1.0 OR need > 1.0
                // 离谱值。多半是上面那句 PLACE_OBJECT... 把物件挪走了 ——
                // 那就用**确定性公式**摆回来。依据都是实测过的：
                //   · `SET_ENTITY_COORDS` **没有**模型偏移（请求 73.80 读回 73.80）；
                //   · `模型底`(mn.z) == 引擎在 `CREATE_OBJECT` 里加的那个偏移（帐篷 -1.53）。
                // ⇒ "原点 = 面 − 模型底" 正好让最低几何落在那块面上。
                // 包围盒无效（mn.z 不显著为负）时不动，保留"坐标 = 底部"的原始创建结果。
                IF mn.z < -0.05
                    fix2.x = bx
                    fix2.y = by
                    fix2.z = surfZ - mn.z
                    SET_ENTITY_COORDS(sobj, fix2, FALSE, FALSE, FALSE, TRUE)
                ENDIF
                off2 = FALSE
            ELSE
                fix2.x = bx                       // ★ x/y 用**传进来的**，不用读回值：
                fix2.y = by                       //   PLACE_OBJECT_ON_GROUND_PROPERLY 之后
                fix2.z = now2.z + need            //   读回的 x/y 可能已经不在原处了
                SET_ENTITY_COORDS(sobj, fix2, FALSE, FALSE, FALSE, TRUE)
            ENDIF
        ENDWHILE

        // ② 闭环：用**引擎实测的离地高度**把最低几何压到地面（两轮收敛）
        //    `GET_ENTITY_HEIGHT_ABOVE_GROUND` 官方 PURPOSE：*Gets the entity's height
        //    above the ground.* ⇒ 它量的是**实体原点**离地高度，正确的值应该等于 |模型底|。
        //    ★ v0.36 实测它在本端口是**有效的**：帐篷 `离地 = 2.52`、而 |模型底| = 1.53
        //      ⇒ `2.52 - 1.53 = 0.99` = 帐篷**真的浮了 0.99 米**（原点比它该在的位置高 0.99）。
        //    ★ 当时我设了 ±0.80 米的单次上限，正好把 0.99 判成"离谱"而**没修**（修正 0.00）
        //      —— 护栏不能做成"把要修的量挡在外面"。现在上限放到 **±2.0 米**。
        //    保险仍在：读数 < 0.35（接口无效/量到别的东西）或 > 4.0（离谱）一律不动；
        //    单次超过 2.0 米也一律不动（那多半不是"浮"，而是量错了东西）。
        pass3 = 0
        off3 = TRUE
        WHILE pass3 < 2 AND off3
            pass3 = pass3 + 1
            hNow = GET_ENTITY_HEIGHT_ABOVE_GROUND(sobj)
            err = hNow - (0.0 - mn.z)             // >0 = 浮着；<0 = 埋着
            IF hNow < 0.35 OR hNow > 4.0
                off3 = FALSE                      // 读数不可信 -> 不动
            ELIF err > -0.10 AND err < 0.10
                off3 = FALSE                      // 已经站上了
            ELIF err < -2.0 OR err > 2.0
                off3 = FALSE                      // 离谱 -> 不动
            ELSE
                now2 = GET_ENTITY_COORDS(sobj, TRUE)
                fix2.x = bx                       // x/y 始终用传进来的值
                fix2.y = by
                fix2.z = now2.z - err
                SET_ENTITY_COORDS(sobj, fix2, FALSE, FALSE, FALSE, TRUE)
                applied = applied - err
            ENDIF
        ENDWHILE

        // ③ 人工微调（菜单「营地高度」）：闭环已经把它放在"引擎认的地面"上，
        //    这里再按玩家调的值整体上下挪 —— **人眼看到的地面只有玩家能确认**。
        //    （闭环是个闭合回路，会把偏移拉回去，所以微调必须放在它之后。）
        IF sink > 0.01 OR sink < -0.01
            now2 = GET_ENTITY_COORDS(sobj, TRUE)
            fix2.x = bx
            fix2.y = by
            fix2.z = now2.z + sink                // sink 为负 = 往下
            SET_ENTITY_COORDS(sobj, fix2, FALSE, FALSE, FALSE, TRUE)
        ENDIF

        now2 = GET_ENTITY_COORDS(sobj, TRUE)
        result = now2.z + mn.z                    // 返回口径：最低几何的世界高度
    ENDIF
    RETURN result
ENDFUNC

PROC PlaceCamp()
    IF NOT g_campReady
        g_specialUntil = GET_GAME_TIMER() + 4000
        g_specialMsg = "营地资源还没加载好，稍后再试"
        EXIT
    ENDIF
    IF g_playerIndoor
        g_specialUntil = GET_GAME_TIMER() + 4000
        g_specialMsg = "不能在室内扎营"
        EXIT
    ENDIF

    PED_INDEX pl = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(pl)
        EXIT
    ENDIF
    // v0.29：**车里不给扎营**。除了观感（帐篷不能塞进车里），还有个技术理由：
    //   贴地校准拿 pc.z 当"已知的地面高度"基准，而坐在车里时 pc.z 是座位高度，
    //   基准就错了 —— 与其模糊处理，不如直接拒绝（也符合"下车安营"的直觉）。
    IF IS_PED_IN_ANY_VEHICLE(pl)
        g_specialUntil = GET_GAME_TIMER() + 4000
        g_specialMsg = "请下车再扎营"
        EXIT
    ENDIF
    VECTOR pc = GET_ENTITY_COORDS(pl, TRUE)

    // 朝向：帐篷放在你面前 3m，篝火再往前 1.6m、往右侧偏 1.2m
    VECTOR fwd = GET_ENTITY_FORWARD_VECTOR(pl)
    FLOAT fx = fwd.x
    FLOAT fy = fwd.y
    IF ABSF(fx) + ABSF(fy) < 0.01
        fx = 1.0
        fy = 0.0
    ENDIF

    // 先拆掉旧的（只允许一个营地）
    IF DOES_ENTITY_EXIST(g_tent)
        RemoveCamp()
    ENDIF

    // 帐篷朝向 = 面朝玩家（这样从外面看是帐篷门对着你）
    FLOAT heading = GET_HEADING_FROM_VECTOR_2D(0.0 - fx, 0.0 - fy)

    // ★★ v0.32 定稿：**不做任何地面探测**（也不做任何高度计算）——
    //   把两个物件从上方 `CAMP_DROP_H` 处**放下来**，让引擎的物理决定它们落在哪。
    //   依据与取舍见 `FinalizeCampProps` 上方的长注释。
    //   ★ 关键区别：`ForceToBeObject = FALSE`（普通动态道具，物理接管）
    //     —— v0.27 失败就是因为这里传了 TRUE（静态物件，物理不接管）。
    VECTOR tentPos
    tentPos.x = pc.x + fx * 3.0
    tentPos.y = pc.y + fy * 3.0

    VECTOR firePos
    firePos.x = pc.x + fx * 4.6 - fy * 1.2
    firePos.y = pc.y + fy * 4.6 + fx * 1.2

    // ★★ v0.36：落点高度 —— **只用"就在正下方"的面；取不到就退回玩家脚下**。
    //   为什么不"借别处的高度"：v0.35 实测 `源 = 2`（横向吸走 >1.5 米）时，导航面返回的
    //   z 根本不是帐篷脚下那点的 —— 帐篷就浮了 ~0.5 米、而且每次吸到的是**同一个远处的
    //   多边形**（两轮 `帐篷/篝火` 读数一模一样，脚底却变了 0.26）。
    //   而 `偏差 = 0.00` 说明导航面在**玩家自己那点**是准的（== 脚下高度）。
    //   ⇒ 原则：**从别处借来的高度，一律不用。**（细节见 CampSurfaceZ 的说明）
    //   查不到"正下方"的面时退回 `pc.z` —— 玩家脚下是场景里唯一确知在地面上的高度。
    FLOAT surfTent = CampSurfaceZ(tentPos.x, tentPos.y, pc.z)
    FLOAT surfFire = CampSurfaceZ(firePos.x, firePos.y, pc.z)
    tentPos.z = surfTent
    firePos.z = surfFire

    g_tent = CREATE_OBJECT(PROP_SKID_TENT_01, tentPos, FALSE, TRUE, FALSE)
    IF NOT DOES_ENTITY_EXIST(g_tent)
        g_tent = NULL
        g_specialUntil = GET_GAME_TIMER() + 4000
        g_specialMsg = "这里放不下帐篷"
        EXIT
    ENDIF
    SET_ENTITY_HEADING(g_tent, heading)
    SET_ENTITY_COLLISION(g_tent, TRUE, TRUE)
    // v0.36：先让引擎自己贴一次坡（官方注释 *"Used to orient an object to match the
    //   terrain."*）。在本端口它**对高度没有可观测效果**（老实测），所以不会干扰
    //   下面我们自己的精确摆位；万一"浮"其实是**斜坡上物件不贴坡**，这一步能治。
    PLACE_OBJECT_ON_GROUND_PROPERLY(g_tent)
    // 再把"最低几何"精确摆到选定面上（含用引擎离地读数做的闭环校正）
    g_campBottomZ = SitObjectOnSurface(g_tent, PROP_SKID_TENT_01, tentPos.x, tentPos.y, surfTent, CAMP_SINK_TENT)
    SET_ENTITY_DYNAMIC(g_tent, FALSE)              // 静态物件：不给它重力
    FREEZE_ENTITY_POSITION(g_tent, TRUE)           // 就地固定，省得被撞走
    SET_ENTITY_AS_MISSION_ENTITY(g_tent, TRUE, TRUE)
    // 防护参数顺序（官方签名）：子弹 / 火焰 / 爆炸 / **碰撞** / 近战
    SET_ENTITY_PROOFS(g_tent, TRUE, TRUE, TRUE, FALSE, TRUE)

    g_campfire = CREATE_OBJECT(PROP_BEACH_FIRE, firePos, FALSE, TRUE, FALSE)
    IF DOES_ENTITY_EXIST(g_campfire)
        SET_ENTITY_HEADING(g_campfire, heading)
        SET_ENTITY_COLLISION(g_campfire, TRUE, TRUE)
        PLACE_OBJECT_ON_GROUND_PROPERLY(g_campfire)
        // 篝火用自己的偏移（两个模型的最低几何位置不同）；返回值这里不用，只为函数有返回值
        FLOAT fireBot = SitObjectOnSurface(g_campfire, PROP_BEACH_FIRE, firePos.x, firePos.y, surfFire, CAMP_SINK_FIRE)
        SET_ENTITY_DYNAMIC(g_campfire, FALSE)
        FREEZE_ENTITY_POSITION(g_campfire, TRUE)
        SET_ENTITY_AS_MISSION_ENTITY(g_campfire, TRUE, TRUE)
        SET_ENTITY_PROOFS(g_campfire, TRUE, TRUE, TRUE, FALSE, TRUE)
    ELSE
        g_campfire = NULL
    ENDIF

    g_campPos = GET_ENTITY_COORDS(g_tent, TRUE)
    // 圆心高度用**实际落地后**的最低几何高度（闭环校正可能挪过几厘米）——
    //   安全区判定用 `VDIST2`（三维距离），圆心越高，旁边的玩家就越早/越晚被算进安全区。
    g_campPos.z = g_campBottomZ

    g_campBlip = ADD_BLIP_FOR_ENTITY(g_tent)
    SET_BLIP_COLOUR(g_campBlip, 2)         // 绿 = 友方/安全
    SET_BLIP_SCALE(g_campBlip, 1.0)
    SET_BLIP_AS_SHORT_RANGE(g_campBlip, TRUE)


    g_specialUntil = GET_GAME_TIMER() + 5000
    g_specialMsg = "营地已搭好 —— 周围 35 米不会有东西刷新"
ENDPROC

// ---------------------------------------------------------------------------
// 营地落地（v0.40 定稿）：
//   ① 落点高度 = 导航面（只在"就在正下方"时才信）/ 否则玩家脚下   —— CampSurfaceZ
//   ② 摆位 = 包围盒最低点压到那个面上                             —— SitObjectOnSurface
//   ③ 闭环 = 用引擎实测的"离地高度"就地校正到"引擎认的地面"
//   ④ 固定偏移 = `CAMP_SINK_TENT` / `CAMP_SINK_FIRE`（人眼与引擎口径的系统性差）
//   ★ 完整来龙去脉（16 版试错 + 四个"地面来源"为什么互相矛盾）见文件头部变更记录
//     和 `SANSCRIPT-NOTES.md` 的"物件与营地"一节。
// ---------------------------------------------------------------------------

// 菜单里按「放置营地」：有营地就拆、没有就搭（脏标志模式，主循环调用）
PROC ToggleCamp()
    IF DOES_ENTITY_EXIST(g_tent)
        RemoveCamp()
        g_specialUntil = GET_GAME_TIMER() + 4000
        g_specialMsg = "营地已拆除"
    ELSE
        PlaceCamp()
    ENDIF
ENDPROC

// 清场用（关掉僵尸模式时调）
PROC ForgetCamp()
    RemoveCamp()
ENDPROC

// ---------------------------------------------------------------------------
// 休息（跳过时间）
//   两段式：先淡出屏幕 -> 0.9 秒后**在黑的这一刻**改时间 -> 再淡入。
//   为什么不直接改：直接在亮着的画面上跳 8 小时，"天突然从中午变晚上"会很突兀；
//   淡出再淡入是 R* 自己在睡觉/过场里用的手法，读起来就是"睡了一觉"。
//   期间的饥饿/口渴**不消耗**（跳时间不等于挨饿），感染度也照旧（它走真实秒）。
// ---------------------------------------------------------------------------
PROC StartCampRest()
    IF GET_GAME_TIMER() < g_campRestNext
        EXIT
    ENDIF

    // 20m 内有僵尸 -> 不许休息（防止"被围住也能一觉到天亮"）
    //   ★ 这里用局部标志 + 走完整圈，**不在循环里 EXIT** ——
    //     一是不依赖"EXIT 在循环内到底是 break 还是 return"这种语义细节，
    //     二是原来那版借 g_specialUntil 传递结果很脆（屏幕上刚好有别的消息时
    //     会把休息误判成"有僵尸"）。这只是一次按键动作，走满 32 只无所谓。
    PED_INDEX pl = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(pl, TRUE)
    BOOL blocked = FALSE
    INT i = 0
    WHILE i < g_zombieCount
        IF DOES_ENTITY_EXIST(g_zombies[i])
        AND NOT IS_ENTITY_DEAD(g_zombies[i], FALSE)
            IF VDIST2(pc, GET_ENTITY_COORDS(g_zombies[i], TRUE)) < CAMP_CLEAR_R2
                blocked = TRUE
            ENDIF
        ENDIF
        i = i + 1
    ENDWHILE
    IF blocked
        g_specialUntil = GET_GAME_TIMER() + 4000
        g_specialMsg = "附近有僵尸，没法休息"
        EXIT
    ENDIF

    g_campRestNext = GET_GAME_TIMER() + 5000
    g_campFadePhase = 1
    g_campFadeAt = GET_GAME_TIMER() + 950
    DO_SCREEN_FADE_OUT(700)
ENDPROC

// ---------------------------------------------------------------------------
// 睡醒时的一句话（v0.25）—— 随机抽，不再固定"睡了一觉 —— 天亮了"
//
//   灵感来自用户给的三条样例（今夜真冷 / 夜晚好像有什么声音 / 做噩梦了）。
//   写的时候守住两条：**不写好消息**（末日里醒来该是疲惫和不安，
//   不是"又是美好的一天"），也**不写具体剧情**（一句话就够，留白比线索好）。
//   字符串不能和数字拼接，所以这里是一整张表。
// ---------------------------------------------------------------------------
FUNC STRING CampWakeLine(INT i)
    IF i = 0 RETURN "今夜真冷" ENDIF
    IF i = 1 RETURN "夜里好像有什么声音，你没敢出去看" ENDIF
    IF i = 2 RETURN "做噩梦了 —— 梦里你也变成了它们中的一员" ENDIF
    IF i = 3 RETURN "风刮了一整夜，梦里全是那种嘶吼声" ENDIF
    IF i = 4 RETURN "睡得不太踏实，远处一直有东西在动" ENDIF
    IF i = 5 RETURN "篝火快灭了，火堆边只剩一层白灰" ENDIF
    IF i = 6 RETURN "梦见爆发前的那个晚上，醒来嗓子干得发疼" ENDIF
    IF i = 7 RETURN "好像听见有人喊救命，也可能只是风" ENDIF
    IF i = 8 RETURN "一整夜都在做同一个梦：跑，一直跑" ENDIF
    IF i = 9 RETURN "被鸟叫吵醒了 —— 至少还有鸟" ENDIF
    IF i = 10 RETURN "帐篷外有一串脚印，不是你的" ENDIF
    IF i = 11 RETURN "这年头能睡上一整觉，已经是奢侈" ENDIF
    RETURN "天亮了"
ENDFUNC

PROC UpdateCampRest()
    IF g_campFadePhase = 0
        EXIT
    ENDIF
    IF GET_GAME_TIMER() < g_campFadeAt
        EXIT
    ENDIF
    g_campFadePhase = 0

    // ★ v0.26：改用 `ADVANCE_CLOCK_TIME_TO` —— 官方注释写着
    //   "if the new time is before the current time a day will pass on the date"，
    //   也就是"**推进到** 6 点；若 6 点已经过去了就顺延一天"。官方 Family5 任务里
    //   就是用这一句把玩家睡到早上 6 点的（同族的 ADD_TO_CLOCK_TIME 在出租车、
    //   昏迷等场景也在用）。
    //   原来 v0.25 用的 `SET_CLOCK_TIME` 语义是"设成某个时刻"，在当前时间已过 6 点
    //   时会让时钟**倒退**（当时我接受过这个瑕疵，现在顺手抹掉）。
    ADVANCE_CLOCK_TIME_TO(CAMP_WAKE_HOUR, 0, 0)

    DO_SCREEN_FADE_IN(700)

    // 睡醒台词：随机抽一条，撞上刚说过的那条就往后挪一格（同电台的做法）
    INT pick = GET_RANDOM_INT_IN_RANGE(0, CAMP_WAKE_LINES)
    IF pick = g_lastWakeIdx
        pick = pick + 1
        IF pick >= CAMP_WAKE_LINES pick = 0 ENDIF
    ENDIF
    g_lastWakeIdx = pick

    g_specialUntil = GET_GAME_TIMER() + 5000
    g_specialMsg = CampWakeLine(pick)

    // ★★ v0.26：天数**在这里直接推进**，不再等 `UpdateApocClock` 的"跨过 0 点"检测。
    //   【为什么】那个检测只在"睡前的钟点大于 6"时才成立：晚上 9 点睡到 6 点会涨一天，
    //   可**凌晨 2 点睡到 6 点属于同一个日历日**，天数不动 —— 从玩家角度看就是
    //   "睡了一觉天数没变，像是坏了"（用户这次反馈的正是它）。
    //   既然"睡觉"是玩家主动按下的一天结束动作，就在这里推进：行为完全可预期，
    //   也不依赖"时钟读回值在这个端口上是否可靠"这件没法离线验证的事。
    //   副作用：同一晚上睡两次会涨两天 —— 可接受，天数本来就是叙事刻度。
    g_apocDay = g_apocDay + 1

    // 时钟锁：接下来 6 秒内让 `UpdateApocClock` **只同步、不检测**，
    //   否则它会按"跨过 0 点"再算一次（一次睡觉涨两天）。
    g_clockLockUntil = GET_GAME_TIMER() + 6000
    g_clockFixTries = 0
    g_lastHour = CAMP_WAKE_HOUR

    // 跨天播报**排队**（不立刻播）：屏上这会儿正显示着刚睡醒那句话，
    //   马上播会把那句话顶掉 —— 就是用户预见到的那种冲突。见 QueueDayNews。
    QueueDayNews()
ENDPROC

// 左上角营地状态（只在安全区内显示，一行小字）
PROC CAMP_HUD()
    IF NOT g_infection
        EXIT
    ENDIF
    IF NOT g_playerSafe
        EXIT
    ENDIF

    SET_TEXT_FONT(FONT_STANDARD)
    SET_TEXT_CENTRE(FALSE)
    SET_TEXT_RIGHT_JUSTIFY(FALSE)
    SET_TEXT_WRAP(0.0, 1.0)
    SET_TEXT_DROPSHADOW(1, 0, 0, 0, 235)

    LABEL_AT(0.030, 0.158, "营地", 150, 220, 180)

ENDPROC

// ---------------------------------------------------------------------------
// 生成一只僵尸（FUNC BOOL：告诉调用方成不成功，失败了就换角度重试）
//
//   ★ v0.10 针对"僵尸凭空出现在画面里"的三处改动：
//     1. 生成方向从"58% 落在玩家前方"改成**优先落在玩家身后/侧后** ——
//        原来照 Reborn 的"前方流式生成"做偏置，却没有"看不见才生成"的判定，
//        结果就是经常在你眼前冒出来。
//     2. 加 `IS_SPHERE_VISIBLE` **硬否决**：落点只要在摄像机视野里就换角度
//        （最多 6 次），这是"凭空出现"的根治手段。
//     3. 最小距离抬到 30m，不再贴着玩家冒出来。
//   全部尝试失败就这一帧不刷（不是非刷不可）。
//   ★ v0.22：落点校验收敛到 `GroundSpotOK()` —— 顺带解决"生成在楼顶"和"生成在室内"，
//     并且**玩家在室内时直接不刷**（室内不生成，也不会在门口堆一堆）。
// ---------------------------------------------------------------------------
FUNC BOOL SpawnOneZombie(FLOAT baseDist)
    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player)
        RETURN FALSE
    ENDIF

    // ★ v0.22：玩家在室内 -> 一只都不刷
    //   （僵尸进不来室内，刷了也只会堆在门外；索性不生）
    IF g_playerIndoor
        RETURN FALSE
    ENDIF

    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    // 朝向：直接用玩家（在车里就是车）的朝向做基准
    FLOAT baseAng = GET_ENTITY_HEADING(player)
    FLOAT baseRad = baseAng * 0.01745329

    FLOAT dist = baseDist * GET_RANDOM_FLOAT_IN_RANGE(0.55, 1.45)
    IF dist < 30.0 dist = 30.0 ENDIF

    INT attempt = 0
    WHILE attempt < 5
        attempt = attempt + 1

        // 65% 在身后（180° 附近 ±60°），其余两侧后方
        FLOAT off
        IF GET_RANDOM_INT_IN_RANGE(0, 100) < 65
            off = GET_RANDOM_FLOAT_IN_RANGE(120.0, 240.0)
        ELSE
            IF GET_RANDOM_INT_IN_RANGE(0, 100) < 50
                off = GET_RANDOM_FLOAT_IN_RANGE(70.0, 115.0)
            ELSE
                off = GET_RANDOM_FLOAT_IN_RANGE(-115.0, -70.0)
            ENDIF
        ENDIF
        FLOAT rad = baseRad + (off * 0.01745329)

        VECTOR spot
        spot.x = pc.x + dist * SIN(rad)
        spot.y = pc.y + dist * COS(rad)
        spot.z = pc.z + 60.0

        // 失败格缓存：太靠近最近失败的落点就换角度
        BOOL bad = FALSE
        INT k = 0
        WHILE k < 4
            IF VDIST2(spot, g_failPos[k]) < 144.0     // 12m²
                bad = TRUE
            ENDIF
            k = k + 1
        ENDWHILE

        IF NOT bad
            REQUEST_COLLISION_AT_COORD(spot)
            FLOAT gz = 0.0
            BOOL got = FALSE
            VECTOR safePos
            // ★★ v0.44 修 BUG【山上 / 郊区不刷僵尸】（主因之一）：
            //   原来落点**只**用 `GET_GROUND_Z_FOR_3D_COORD`（读地形网格）取高度 ——
            //   它**依赖碰撞流式加载**：在山区/野外，那个坐标的碰撞往往还没加载好，
            //   查询直接失败 ⇒ 5 次尝试全废 ⇒ 一只都不刷（城里因为流式密集+地形平，从没暴露）。
            //   ⇒ 现在**先用导航面** `GET_SAFE_COORD_FOR_PED` ——
            //     官方 PURPOSE 就是 *"find a **safe bit of ground to place a ped**"*，
            //     是"给 ped 找落脚点"的专用接口，不依赖碰撞流式加载；
            //     取不到再退回地形查询。
            // ★ v0.45：**水里不刷** —— 导航面查询带上 `GSC_FLAG_NOT_WATER`
            //   （官方枚举：*No navmesh polygons marked as water*），从源头上避开水面多边形
            IF GET_SAFE_COORD_FOR_PED(spot, FALSE, safePos, GSC_FLAG_NOT_WATER)
                spot.x = safePos.x
                spot.y = safePos.y
                spot.z = safePos.z + 0.6
                gz = safePos.z
                got = TRUE
            ELIF GET_GROUND_Z_FOR_3D_COORD(spot, gz)
                spot.z = gz + 0.6
                got = TRUE
            ENDIF
            IF NOT got
                bad = TRUE
            ELSE
                // ★ v0.22：室内否决 / 与玩家高差 / 道路层校验（挡楼顶）/ 坡度 / 占位
                // ★ v0.24：营地安全区内不生成
                IF NOT GroundSpotOK(spot, pc, gz, 2.5)
                    bad = TRUE
                ELIF InCampSafeZone(spot)
                    bad = TRUE
                ELSE
                    // ★ 视野否决：落点在摄像机视野里就换角度（"凭空出现"的根治）
                    IF IS_SPHERE_VISIBLE(spot, 2.0)
                        bad = TRUE
                    ENDIF
                ENDIF
            ENDIF
        ENDIF

        IF bad
            // 记下来，避免下次又挑到同一个坑（视野否决也记 —— 那片区域你正看着）
            RememberFail(spot)
        ELSE
            MODEL_NAMES mdl = RandomZombieModel()
            PED_INDEX z = CREATE_PED(PEDTYPE_CIVMALE, mdl, spot, GET_RANDOM_FLOAT_IN_RANGE(0.0, 360.0), TRUE, FALSE)
            IF DOES_ENTITY_EXIST(z)
                SET_PED_RANDOM_COMPONENT_VARIATION(z)
                INT zt = RollZombieType()
                MakeIntoZombie(z, zt)
                RegisterZombie(z, zt)
                RETURN TRUE
            ENDIF
            RememberFail(spot)
        ENDIF
    ENDWHILE

    RETURN FALSE
ENDFUNC

// 一次刷一小群；尸潮期间刷一大群（对照 Reborn 的 horde：5~10 只）
PROC SpawnZombie()
    IF g_zombieCount >= ActiveCap()
        EXIT
    ENDIF
    IF NOT g_modelReady
        EXIT
    ENDIF

    FLOAT dist = SpawnDistance()
    INT want = GET_RANDOM_INT_IN_RANGE(1, 4)
    IF GET_GAME_TIMER() < g_hordeUntil
        want = GET_RANDOM_INT_IN_RANGE(5, 11)
    ENDIF

    // SpawnOneZombie 现在是"视野否决 + 多次换角度"的 FUNC：
    //   成功了才算一只，失败就再试（最多 10 次机会），别硬塞。
    INT made = 0
    INT tries = 0
    WHILE made < want AND tries < 10
        tries = tries + 1
        IF g_zombieCount >= ActiveCap()
            made = want                     // 到上限了，收工
        ELSE
            IF SpawnOneZombie(dist)
                made = made + 1
            ENDIF
        ENDIF
    ENDWHILE

ENDPROC

// ---------------------------------------------------------------------------
// 目标选择
// ---------------------------------------------------------------------------
// 这个 ped 值得被僵尸追吗？（原版 ZombiePed.IsGoodTarget 的放宽版：
// 原版只认"恨僵尸的关系"，这里额外把普通市民也算进来，保证感染扩散一定能发生）
FUNC BOOL IsZombieTarget(PED_INDEX z, PED_INDEX p)
    IF NOT DOES_ENTITY_EXIST(p) RETURN FALSE ENDIF
    IF p = z RETURN FALSE ENDIF
    IF NOT IS_PED_HUMAN(p) RETURN FALSE ENDIF
    IF IS_ENTITY_DEAD(p, FALSE) RETURN FALSE ENDIF
    // ★ v0.22：**在室内的人不算目标** —— 僵尸不追进屋里。
    //   玩家那一份由全局 g_playerIndoor 单独管（更省 native），
    //   这里覆盖路人 / 幸存者 / 警察。
    IF GET_INTERIOR_FROM_ENTITY(p) != NULL RETURN FALSE ENDIF
    IF GET_PED_RELATIONSHIP_GROUP_HASH(p) = g_zGroup RETURN FALSE ENDIF
    // ★ 家人 / 剧情角色绝不作为目标
    IF IsProtectedPed(p) RETURN FALSE ENDIF
    IF IS_PED_A_PLAYER(p)
        // 玩家永远是有效目标（v0.8 起车里也算 —— 车内不再安全）
        RETURN TRUE
    ENDIF
    IF ENUM_TO_INT(GET_RELATIONSHIP_BETWEEN_PEDS(p, z)) = 5 RETURN TRUE ENDIF
    PED_TYPE t = GET_PED_TYPE(p)
    IF t = PEDTYPE_CIVMALE OR t = PEDTYPE_CIVFEMALE RETURN TRUE ENDIF
    RETURN FALSE
ENDFUNC

// 僵尸的"走路姿态"（醉汉踉跄 / 一瘸一拐）
//   ★ 只在**事件**上重设：被僵尸化时、以及每次给它（重新）下任务时。
//     因为游戏只在任务/移动状态发生变化时才会把 clipset 重置回普通姿态，
//     而我们自己控制着所有任务变化 —— 这样就完全不需要"每 N 秒刷一遍"。
// 走路姿态（问题 3）
//   ★ 上一版"不像僵尸"的两个原因：
//     1) 动画集是**流式资源**，`REQUEST_ANIM_SET` 只在启动时喊过一次；万一那次
//        没生效（比如游戏还没就绪），HAS_ANIM_SET_LOADED 永远为假 -> 后面所有
//        SET_PED_MOVEMENT_CLIPSET 全被 if 挡掉 -> 僵尸就是**普通人走路**。
//        （现在 PrepareAssets 会每秒重喊一次请求，见那里）
//     2) 没有任何回退：醉汉动画集不可用时就什么都不设。
//        现在给一条回退链：drunk@verydrunk -> injured。
//     另外过渡时间用 1.0（RottenV 同款），比 0.25 更"粘"，不容易被战斗姿态冲掉。
PROC ApplyZombieLook(INT i)
    PED_INDEX z = g_zombies[i]
    INT zt = g_zType[i]
    BOOL fast = (zt = ZTYPE_RUNNER OR zt = ZTYPE_SCREAMER)
    IF fast
        // 跑者/尖啸者：一瘸一拐地快走（Reborn 同款）
        IF HAS_ANIM_SET_LOADED("move_m@injured")
            SET_PED_MOVEMENT_CLIPSET(z, "move_m@injured", 1.0)
        ELIF HAS_ANIM_SET_LOADED("move_m@drunk@verydrunk")
            SET_PED_MOVEMENT_CLIPSET(z, "move_m@drunk@verydrunk", 1.0)
        ENDIF
        SET_PED_IS_DRUNK(z, TRUE)
    ELSE
        // 行尸/壮尸：醉汉式踉跄（最像僵尸的走法）
        IF HAS_ANIM_SET_LOADED("move_m@drunk@verydrunk")
            SET_PED_MOVEMENT_CLIPSET(z, "move_m@drunk@verydrunk", 1.0)
        ELIF HAS_ANIM_SET_LOADED("move_m@injured")
            SET_PED_MOVEMENT_CLIPSET(z, "move_m@injured", 1.0)
        ENDIF
        SET_PED_IS_DRUNK(z, TRUE)
    ENDIF
ENDPROC

// 僵尸嘶吼
//   kind: 0 = 追击中的低吼，1 = 撕咬时的短吼，2 = 尖啸者的长啸
//
//   ★ v0.9 的两个修正：
//     (1) 换用**响度足够**的惨叫类。上一版挑的是 DYING_MOAN(濒死呻吟) /
//         WHIMPER(呜咽) / EXHAUSTION(喘息) —— 这几种在原声里都是**很轻**的气音，
//         混在环境音里基本听不见，所以"僵尸从来不叫"。
//         现在主用 SCREAM_PANIC / SCREAM_SHOCKED / SCREAM_SCARED / SCREAM_TERROR
//         这类真正喊出来的音。它们是**非语言**的惨叫，不依赖任何台词。
//     (2) 去掉尾部的 PLAY_FACIAL_ANIM —— 面部动画和发声共用一条通道，
//         紧跟着播会把刚触发的音频掐断。
//   另外 RawDamage 从 0.0 改成正值：音频系统会按伤害值给音量定标，
//   传 0 有被当成"零响度"的风险（官方注释也写了这个参数是 Damage value）。
PROC ZombieRoar(PED_INDEX z, INT kind)
    IF NOT DOES_ENTITY_EXIST(z)
        EXIT
    ENDIF
    IF IS_ENTITY_DEAD(z, FALSE)
        EXIT
    ENDIF
    // 保证痛觉/发声通道开着（可能被别的脚本关掉）
    DISABLE_PED_PAIN_AUDIO(z, FALSE)

    INT r = GET_RANDOM_INT_IN_RANGE(0, 100)
    IF kind = 2
        // 尖啸者：最响的一种，配合"召潮"的定位
        PLAY_PAIN(z, AUD_DAMAGE_REASON_SCREAM_TERROR, 30.0, FALSE)
    ELIF kind = 1
        // 撕咬时的短吼
        IF r < 50
            PLAY_PAIN(z, AUD_DAMAGE_REASON_SCREAM_SHOCKED, 20.0, FALSE)
        ELSE
            PLAY_PAIN(z, AUD_DAMAGE_REASON_SCREAM_PANIC_SHORT, 20.0, FALSE)
        ENDIF
    ELSE
        // 追击中的低吼：混合几种惨叫，避免每次都一样
        IF r < 30
            PLAY_PAIN(z, AUD_DAMAGE_REASON_SCREAM_PANIC, 25.0, FALSE)
        ELIF r < 60
            PLAY_PAIN(z, AUD_DAMAGE_REASON_SCREAM_SHOCKED, 25.0, FALSE)
        ELIF r < 85
            PLAY_PAIN(z, AUD_DAMAGE_REASON_SCREAM_SCARED, 25.0, FALSE)
        ELSE
            PLAY_PAIN(z, AUD_DAMAGE_REASON_DYING_MOAN, 25.0, FALSE)
        ENDIF
    ENDIF
ENDPROC

PROC SetZombieTarget(INT i, PED_INDEX tgt)
    PED_INDEX z = g_zombies[i]
    g_zTarget[i] = tgt
    g_zAttacking[i] = FALSE
    IF DOES_ENTITY_EXIST(tgt)
        TASK_COMBAT_PED(z, tgt)
        // 锁定目标的那一瞬吼一声 —— 事件驱动，不花轮询成本，
        // 也是玩家最容易察觉到"僵尸发现我了"的时刻。
        IF NOT g_zAggro[i]
            ZombieRoar(z, 0)
        ENDIF
        g_zAggro[i] = TRUE
        // 追击超时：18 秒还没够到就放弃（防止锁死在一个够不到的目标上，
        // 表现就是"僵尸站着不动"）
        g_zTargetTime[i] = GET_GAME_TIMER() + 18000
    ELSE
        TASK_WANDER_STANDARD(z)
        g_zAggro[i] = FALSE
        g_zTargetTime[i] = 0
    ENDIF
    SET_PED_KEEP_TASK(z, TRUE)
    // 换任务 = 游戏最可能重置走路姿态的时刻 -> 这里顺手补一次（事件驱动，不是轮询）
    ApplyZombieLook(i)
ENDPROC

// 目标搜索。参数 pc / dz 由调用方预算好（玩家坐标每帧只取一次，不再每只僵尸各取一次）
// 节流：无目标 700ms 一次，有目标时只在目标失效/超距才重搜；
//       玩家超过 150m 的僵尸直接不搜（它马上就要被清理了）
PROC RefreshZombieTarget(INT i, VECTOR pc, FLOAT dz)
    PED_INDEX z = g_zombies[i]
    VECTOR zc = GET_ENTITY_COORDS(z, TRUE)

    // ★ 追击超时判断必须放在"优先玩家"分支**之前**（问题 8 的第三个隐患）：
    //   原来放在后面，而"目标就是玩家"时前面会直接 EXIT —— 于是超时永远不触发，
    //   僵尸会锁死在一个够不到的目标上一直发呆。
    //   另外：贴身（12m 内）时给计时续期，不然打着打着会突然放弃目标。
    IF g_zTarget[i] <> NULL
        IF g_zTargetTime[i] > 0 AND GET_GAME_TIMER() > g_zTargetTime[i]
            PED_INDEX cur0 = g_zTarget[i]
            BOOL closeIn = FALSE
            IF DOES_ENTITY_EXIST(cur0) AND NOT IS_ENTITY_DEAD(cur0, FALSE)
                IF VDIST2(zc, GET_ENTITY_COORDS(cur0, TRUE)) < 144.0
                    closeIn = TRUE
                ENDIF
            ENDIF
            IF closeIn
                g_zTargetTime[i] = GET_GAME_TIMER() + 18000
            ELSE
                SetZombieTarget(i, NULL)
                EXIT
            ENDIF
        ENDIF
    ENDIF

    // ★ v0.22：玩家躲进室内 -> 立刻放弃玩家这个目标（僵尸不追进屋里）。
    //   这条必须在"优先玩家"**之前**：否则它每 700ms 又会把玩家重新设成目标，
    //   表现就是一群僵尸挤在你门口的墙外打转。
    IF g_playerIndoor AND g_zTarget[i] = PLAYER_PED_ID()
        SetZombieTarget(i, NULL)
        EXIT
    ENDIF

    // 优先玩家：进感知范围 / 听到动静（枪声·车声·爆炸）
    //   ★ v0.8 起**车里也照样追**（用户反馈 7：车内不再是安全区）：
    //     僵尸会围上来砸车；至于"够不到就发呆"的老问题，
    //     现在用"所有类型都会砸车"（见 UpdateZombieWorld 里的 SmashVehicle）
    //     让他们有明确行为，而不是站在车边干瞪眼。
    //   ★ v0.22：玩家在室内时不再把他当目标（已有的目标由上面那条清掉）。
    //   ★ v0.24：潜行时发现距离缩到四成，而且稍远一点**要求有视线**
    //     （躲在车后、墙后、栅栏后就不会被发现）。枪声照旧会暴露你
    //     （`GET_GAME_TIMER() < g_noiseUntil` 那条是"绕过视线"的听觉通道）。
    //
    //   ★ 一个刻意的设计取舍：这只影响"**新**发现你"。已经被盯上的僵尸不会因为
    //     你按下潜行键就放弃 —— 潜行是"别被看到"，不是"隐身"。
    //     想甩掉追兵得靠转弯、上车、或者真的拉开距离。
    //   ★ v0.24：营地安全区同理 —— 在营地里不会被**新**盯上（已在追你的照旧）。
    IF NOT g_playerIndoor AND NOT g_playerSafe
        BOOL heardNoise = (GET_GAME_TIMER() < g_noiseUntil)
        BOOL spotted = FALSE

        IF dz < ZombieDetectRange()
            spotted = TRUE
            // 潜行时：超过 STEALTH_LOS_DIST 就让"视线"来裁决。
            //   只对**已经进入候选范围的那一只**做检查（LOS 是昂贵调用），
            //   而且只在你潜行时才会走到这里，成本可控。
            IF g_playerStealth AND NOT heardNoise AND dz > STEALTH_LOS_DIST
                IF NOT HAS_ENTITY_CLEAR_LOS_TO_ENTITY(z, PLAYER_PED_ID())
                    spotted = FALSE
                ENDIF
            ENDIF
        ENDIF

        // 听觉通道：有动静（枪声/车声/爆炸）时 60m 内直接惊动，不看视线
        IF NOT spotted AND heardNoise AND dz < 60.0
            spotted = TRUE
        ENDIF

        IF spotted
            IF g_zTarget[i] <> PLAYER_PED_ID()
                SetZombieTarget(i, PLAYER_PED_ID())
            ENDIF
            EXIT
        ENDIF
    ENDIF

    // 已有目标且还有效 -> 继续追（避免每 700ms 换目标导致任务抖动）
    PED_INDEX cur = g_zTarget[i]
    IF DOES_ENTITY_EXIST(cur)
    AND NOT IS_ENTITY_DEAD(cur, FALSE)
        IF VDIST2(zc, GET_ENTITY_COORDS(cur, TRUE)) < 2025.0   // 45m²
            EXIT
        ENDIF
    ENDIF

    // 找最近的候选，只对"选中的那一个"做视线检查（LOS 很贵，别每个候选都查）
    PED_INDEX found[6]
    INT n = GET_PED_NEARBY_PEDS(z, found, PEDTYPE_INVALID)
    PED_INDEX best = NULL
    FLOAT bestD2 = 900.0            // 30m²
    INT k = 0
    WHILE k < n
        PED_INDEX p = found[k]
        // 不追开车的人（追不上，而且会让僵尸站在路边发呆）
        IF IsZombieTarget(z, p) AND NOT IS_PED_IN_ANY_VEHICLE(p)
            // 用内建 VDIST2（VM 指令）代替 GET_DISTANCE_BETWEEN_COORDS（native 调用）
            FLOAT d2 = VDIST2(zc, GET_ENTITY_COORDS(p, TRUE))
            IF d2 < bestD2
                bestD2 = d2
                best = p
            ENDIF
        ENDIF
        k = k + 1
    ENDWHILE

    IF best <> NULL
        // 18m 内直接认定；更远要求有视线（LOS 是 native，只对选中的那一个做一次）
        IF bestD2 < 324.0 OR HAS_ENTITY_CLEAR_LOS_TO_ENTITY(z, best)
            SetZombieTarget(i, best)
            EXIT
        ENDIF
    ENDIF

    IF g_zAggro[i]
        SetZombieTarget(i, NULL)
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 玩家感染（参考 Reborn 的 PlayerInfectionManager，做了时间尺度简化）
//   · 每次被僵尸咬：咬伤数 +1，感染度 +0.05
//   · 生存窗口按咬数递减（v0.8 起整体**放慢一倍**）：1咬 40 分 / 2咬 20 分 /
//     3咬 10 分 / 4咬以上 6 分（按现实秒，从咬到"自然满"的时间）
//   · ★ v0.8：取消"到 100 后还要等 60+120 秒才死"的设定 ——
//     **感染度到 100 立即死亡**（用户反馈 4）。危急/终末两个倒计时阶段一并删除。
//   · 症状每 35~65 秒一次，随感染度分级（见 UpdatePlayerInfection）
//   · 解药箱随机刷在 250~500m，蓝点，180 秒消失；
//     靠近 3m 按互动键使用，60% 治愈，失败则病情加重
//   · ★ 提示只留"首次被咬"那一条 + 右下角数值（用户反馈 5）
// ---------------------------------------------------------------------------
FUNC FLOAT InfWindowSeconds()
    IF g_infBites <= 1 RETURN 2400.0 ENDIF
    IF g_infBites = 2 RETURN 1200.0 ENDIF
    IF g_infBites = 3 RETURN 600.0 ENDIF
    RETURN 360.0
ENDFUNC

// 被咬一次
PROC OnPlayerBitten()
    BOOL wasFirst = (g_infBites = 0)
    g_infBites = g_infBites + 1
    g_infProgress = g_infProgress + 0.05
    IF g_infProgress > 0.99 g_infProgress = 0.99 ENDIF

    // ★ 唯一保留的感染提示（用户反馈 5）：**首次**被咬时提示一次
    IF wasFirst
        g_specialUntil = GET_GAME_TIMER() + 6000
        g_specialMsg = "你被僵尸咬了 —— 感染开始了"
    ENDIF

    IF g_infSymNext = 0
        g_infSymNext = GET_GAME_TIMER() + 35000
    ENDIF
ENDPROC

// 生成解药箱
PROC SpawnAntidoteCrate()
    IF NOT g_modelReady
        EXIT
    ENDIF
    IF NOT g_crateReady
        EXIT
    ENDIF
    IF g_crate <> NULL
        EXIT
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)
    FLOAT ang = GET_RANDOM_FLOAT_IN_RANGE(0.0, 360.0)
    FLOAT rad = ang * 0.01745329
    FLOAT dist = GET_RANDOM_FLOAT_IN_RANGE(250.0, 500.0)
    // 感染度已经很高 -> 刷得近一些，给玩家一个能赶到的机会
    IF g_infProgress >= 0.75
        dist = GET_RANDOM_FLOAT_IN_RANGE(60.0, 200.0)
    ENDIF

    VECTOR spot
    spot.x = pc.x + dist * SIN(rad)
    spot.y = pc.y + dist * COS(rad)
    spot.z = pc.z + 60.0

    REQUEST_COLLISION_AT_COORD(spot)
    FLOAT gz = 0.0
    BOOL cok = FALSE
    VECTOR csafe
    // ★★ v0.45（本轮审查修正）：箱子刷在 **250~500 米外** —— 那个距离上
    //   `GET_GROUND_Z_FOR_3D_COORD`（依赖碰撞流式加载）几乎不可能就绪 ⇒ 箱子刷不出来。
    //   改成和僵尸同一套：导航面优先（排除水面）→ 地形兜底。
    IF GET_SAFE_COORD_FOR_PED(spot, FALSE, csafe, GSC_FLAG_NOT_WATER)
        spot.x = csafe.x
        spot.y = csafe.y
        gz = csafe.z
        cok = TRUE
    ELIF GET_GROUND_Z_FOR_3D_COORD(spot, gz)
        cok = TRUE
    ENDIF
    IF NOT cok
        EXIT
    ENDIF
    // 水面也排除：箱子掉海里 = 目标不可达
    FLOAT cwh
    IF GET_WATER_HEIGHT_NO_WAVES(spot, cwh)
        IF gz < cwh + 0.3
            EXIT
        ENDIF
    ENDIF
    // ★ v0.30：删掉 v0.29 的"减偏差"（偏差不是常数，已证伪），原样用探测值。
    //   箱子刷在 250~500 米外，拿不到"玩家脚下"这种已知参考点，只能这样；
    //   即便误差一米也只是观感，而且它是个带蓝点的目标物。
    spot.z = gz

    // ★ 固定住（问题 1）：
    //   CREATE_OBJECT 的第 3/4/5 个参数是 RegisterAsNetworkObject / ScriptHostObject /
    //   ForceToBeObject。上一版传的是 (TRUE, FALSE) —— 等于"不要强制成物体"，
    //   于是引擎把它当成**普通物理道具**，一撞就滚，这就是"箱子会被推走"的根因。
    //   现在：(FALSE, TRUE, TRUE) + 冻结位置 + 防碰撞 + 非动态，四重保险。
    g_crate = CREATE_OBJECT(PROP_MIL_CRATE_01, spot, FALSE, TRUE, TRUE)
    IF NOT DOES_ENTITY_EXIST(g_crate)
        g_crate = NULL
        EXIT
    ENDIF
    SET_ENTITY_DYNAMIC(g_crate, FALSE)
    FREEZE_ENTITY_POSITION(g_crate, TRUE)
    SET_ENTITY_PROOFS(g_crate, TRUE, TRUE, TRUE, TRUE, TRUE)
    g_crateHome = spot
    g_crateBlip = ADD_BLIP_FOR_ENTITY(g_crate)
    SET_BLIP_COLOUR(g_crateBlip, 3)
    SET_BLIP_SCALE(g_crateBlip, 1.2)
    SET_BLIP_AS_SHORT_RANGE(g_crateBlip, FALSE)

    // v0.8：不再弹文字提示（用户反馈 5 要求精简感染提示），
    //       地图上那个蓝点就是提示
    g_crateUntil = GET_GAME_TIMER() + 180000
ENDPROC

PROC ClearAntidoteCrate()
    IF DOES_BLIP_EXIST(g_crateBlip)
        REMOVE_BLIP(g_crateBlip)
    ENDIF
    IF g_crate <> NULL AND DOES_ENTITY_EXIST(g_crate)
        DELETE_OBJECT(g_crate)
    ENDIF
    g_crate = NULL
    g_crateUntil = 0
    g_crateHome.x = 0.0
    g_crateHome.y = 0.0
    g_crateHome.z = 0.0
ENDPROC

// 用解药（v0.8：不再弹文字提示 —— 数值变化本身就是反馈；成功时数值直接归零）
PROC UseAntidote()
    IF GET_RANDOM_INT_IN_RANGE(0, 100) < 60
        g_infProgress = 0.0
        g_infBites = 0
        g_infSymNext = 0
    ELSE
        g_infBites = g_infBites + 1
        g_infProgress = g_infProgress + 0.15
        IF g_infProgress > 0.99 g_infProgress = 0.99 ENDIF
    ENDIF
    ClearAntidoteCrate()
ENDPROC

// 1Hz 调用：推进感染度、触发症状、管理解药箱
PROC UpdatePlayerInfection()
    IF NOT g_infectedPlayer
        EXIT
    ENDIF
    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player)
        EXIT
    ENDIF
    IF IS_ENTITY_DEAD(player, FALSE)
        EXIT
    ENDIF

    INT now = GET_GAME_TIMER()

    // 解药箱：超时移除；靠近了按互动键使用
    IF g_crate <> NULL
        IF now > g_crateUntil OR NOT DOES_ENTITY_EXIST(g_crate)
            ClearAntidoteCrate()
        ELSE
            // 兜底：万一被载具/爆炸顶开了，直接拉回原位（1Hz，成本可忽略）
            IF VDIST(GET_ENTITY_COORDS(g_crate, TRUE), g_crateHome) > 1.5
                SET_ENTITY_COORDS(g_crate, g_crateHome, FALSE, FALSE, FALSE, TRUE)
                FREEZE_ENTITY_POSITION(g_crate, TRUE)
            ENDIF
            IF VDIST(GET_ENTITY_COORDS(player, TRUE), GET_ENTITY_COORDS(g_crate, TRUE)) < 3.0
                g_hintUntil = GET_GAME_TIMER() + 1600
                g_hintMsg = "按 [十字键 右] 使用解药"
                IF g_keyContext
                    g_keyContext = FALSE
                    UseAntidote()
                    EXIT
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    IF g_infBites <= 0
        EXIT
    ENDIF

    // ★ 感染推进（v0.8 重做）：
    //   · 速率由"按咬数递减的生存窗口"决定（见 InfWindowSeconds）
    //   · **到 100 立即死亡** —— 取消原来的"危急 60 秒 + 终末 120 秒"延迟
    //     （用户反馈 4：不需要那两分钟）
    g_infProgress = g_infProgress + (1.0 / InfWindowSeconds())
    IF g_infProgress >= 1.0
        SET_ENTITY_HEALTH(player, 0)
        EXIT
    ENDIF

    // 症状 —— **按感染度分级**（问题 5：确认一下，腿软摔倒是原本就有的设定，
    //   在下面这一段里；原来的问题是"任何感染度都可能摔"，所以刚被咬一口
    //   也会莫名其妙跌倒。现在改成随感染度加重）
    //     < 0.15 : 无症状
    //     0.15+  : 画面摇晃（ANIMPOSTFX "Drunk"）
    //     0.40+  : 再叠加每次 -3 血
    //     0.70+  : 35% 概率腿软摔倒（这才是"重症状"）
    IF g_infSymNext > 0 AND now > g_infSymNext
        g_infSymNext = now + GET_RANDOM_INT_IN_RANGE(35000, 65000)
        IF g_infProgress >= 0.15
            ANIMPOSTFX_PLAY("Drunk", 2500, FALSE)
        ENDIF
        IF g_infProgress >= 0.40
            INT hp = GET_ENTITY_HEALTH(player)
            IF hp > 20
                SET_ENTITY_HEALTH(player, hp - 3)
            ENDIF
        ENDIF
        IF g_infProgress >= 0.70
            IF GET_RANDOM_INT_IN_RANGE(0, 100) < 35
                SET_PED_TO_RAGDOLL(player, 900, 900, INT_TO_ENUM(START_RAGDOLL_TASK, 0), FALSE, FALSE, FALSE)
            ENDIF
        ELIF g_infProgress >= 0.40
            IF GET_RANDOM_INT_IN_RANGE(0, 100) < 12
                SET_PED_TO_RAGDOLL(player, 900, 900, INT_TO_ENUM(START_RAGDOLL_TASK, 0), FALSE, FALSE, FALSE)
            ENDIF
        ENDIF
    ENDIF

    // 感染度过 0.35 且还没解药箱 -> 投放
    IF g_infProgress > 0.35 AND g_crate = NULL
        SpawnAntidoteCrate()
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 攻击（只在"刚进入攻击距离"那一下咬一次）
// ---------------------------------------------------------------------------
// 玩家是否处于"不该掉血"的状态（修改器的无敌）
//   注意：APPLY_DAMAGE_TO_PED 会直接扣血、**绕过** SET_PLAYER_INVINCIBLE /
//   SET_ENTITY_INVINCIBLE，所以必须自己查一遍，否则开了无敌照样被扣死。
FUNC BOOL PlayerProtected()
    IF GET_PLAYER_INVINCIBLE(PLAYER_ID())
        RETURN TRUE
    ENDIF
    IF NOT GET_ENTITY_CAN_BE_DAMAGED(PLAYER_PED_ID())
        RETURN TRUE
    ENDIF
    RETURN FALSE
ENDFUNC

// firstBite = 本次是"刚进入攻击距离"的第一口（跑者只有第一口才可能扑倒）
PROC ZombieAttack(INT i, BOOL firstBite)
    PED_INDEX z = g_zombies[i]
    PED_INDEX tgt = g_zTarget[i]
    INT zt = g_zType[i]
    IF NOT DOES_ENTITY_EXIST(tgt)
        EXIT
    ENDIF
    IF IS_ENTITY_DEAD(tgt, FALSE)
        EXIT
    ENDIF
    IF GET_GAME_TIMER() < g_zNextAttack[i]
        EXIT
    ENDIF
    // 攻关节奏：冷却必须 ≥ 动画时长，否则上一口的动作会被下一口打断
    //   （"动作做一半又重来"）。v0.9 起动画播完整段，冷却对齐到 2200ms。
    g_zNextAttack[i] = GET_GAME_TIMER() + 2200

    // 撕咬动画
    //   ★ 问题 8 的根因：AF_UPPERBODY(16) 只表示"只播上半身"，它**仍然占用主任务槽**，
    //     会把 TASK_COMBAT_PED 顶掉；动画 1 秒放完之后僵尸就彻底没有任务了 ——
    //     表现就是"咬我一口之后原地站着不动"。
    //     加上 AF_SECONDARY(32) 后，动画跑在**次级任务槽**，移动/战斗任务得以保留
    //     （48 = 16 + 32，两个位不重叠，可以直接相加）。
    //   ★ v0.9：nTimeToPlay 从 1000 改成 -1（播完整段）。原来强制只播 1 秒，
    //     而冷却只有 1.5 秒 —— 看起来就是"动作做一半就被打断，然后重复"。
    TASK_PLAY_ANIM(z, "rcmbarry", "bar_1_teleport_aln", 8.0, 8.0, -1, INT_TO_ENUM(ANIMATION_FLAGS, 48))
    // 咬击时发一声短吼（问题 4）
    ZombieRoar(z, 1)

    IF IS_PED_A_PLAYER(tgt)
        // 修改器开了无敌就不扣血
        IF PlayerProtected()
            EXIT
        ENDIF
        // 玩家在车里时咬不到（否则开车撞僵尸反而自己掉血）。
        //   v0.9 起"人在车里"的目标已经走 HandleVehicleTarget（追车+砸车），
        //   正常不会走到这里；这条只是保险。
        IF IS_PED_IN_ANY_VEHICLE(tgt)
            EXIT
        ENDIF
        // 扑倒：跑者 10%、壮尸 35%（Reborn 的数据），一场遭遇只判定一次
        IF firstBite
            INT knock = 0
            IF zt = ZTYPE_RUNNER knock = 10 ENDIF
            IF zt = ZTYPE_BRUTE knock = 35 ENDIF
            IF knock > 0 AND GET_RANDOM_INT_IN_RANGE(0, 100) < knock
                TASK_JUMP(z, TRUE)
                SET_PED_TO_RAGDOLL(tgt, 2000, 2000, INT_TO_ENUM(START_RAGDOLL_TASK, 0), FALSE, FALSE, FALSE)
                EXIT
            ENDIF
        ENDIF
        APPLY_DAMAGE_TO_PED(tgt, ZombieDamageFor(zt), FALSE, z)
        // 玩家感染系统：被咬累积感染度
        IF g_infectedPlayer
            OnPlayerBitten()
        ENDIF
    ELSE
        // 路人 / 幸存者：咬一口 + 感染扩散
        APPLY_DAMAGE_TO_PED(tgt, 25, FALSE, z)
        // ★ v0.9：自己人（幸存者小队 / 招募来的护卫）**不会被同化**。
        //   这是"地图上蓝点闪一下就没了"的根因：他们跟僵尸对射，血量掉到 1/4 时
        //   被咬成僵尸 -> 关系组变了 -> UpdateSurvivors 把名单和蓝点一起清掉，
        //   你走过去当然既没有人、也没有招募提示（人已经变成僵尸了）。
        //   现在他们只会被打死，不会变成僵尸。
        IF (g_zombieCount < ActiveCap())
        AND GET_PED_RELATIONSHIP_GROUP_HASH(tgt) <> g_sGroup
        AND GET_ENTITY_HEALTH(tgt) <= (GET_ENTITY_MAX_HEALTH(tgt) / 4)
            SET_PED_TO_RAGDOLL(tgt, 3000, 3000, INT_TO_ENUM(START_RAGDOLL_TASK, 0), FALSE, FALSE, FALSE)
            g_zTarget[i] = NULL
            // 对照 Reborn：被僵尸同化出来的新僵尸直接是"跑者"（更有压迫感）
            MakeIntoZombie(tgt, ZTYPE_RUNNER)
            RegisterZombie(tgt, ZTYPE_RUNNER)
        ENDIF
    ENDIF

    // ★ 收尾保险（问题 8）：主任务万一还是被顶掉了，这里立刻补回来，
    //   不等下一轮看门狗（ZombieAttack 里的 EXIT 分支会跳过这里，由看门狗兜底）。
    IF g_zTarget[i] <> NULL
        IF DOES_ENTITY_EXIST(tgt) AND NOT IS_ENTITY_DEAD(tgt, FALSE)
            IF NOT IS_PED_IN_COMBAT(z)
                TASK_COMBAT_PED(z, tgt)
                SET_PED_KEEP_TASK(z, TRUE)
                ApplyZombieLook(i)
            ENDIF
        ENDIF
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 砸车 —— 对照 Reborn 的 Runner.OnAttackTarget：跑者/壮尸会砸目标所在的车
//   （Reborn 数值：引擎 -10（>120 才掉）、车身 -8（>240 才掉），壮尸翻倍）
// ---------------------------------------------------------------------------
PROC SmashVehicle(PED_INDEX z, PED_INDEX tgt, INT zt)
    VEHICLE_INDEX v = GET_VEHICLE_PED_IS_IN(tgt, FALSE)
    IF NOT DOES_ENTITY_EXIST(v)
        EXIT
    ENDIF

    FLOAT dmg = 25.0
    IF zt = ZTYPE_BRUTE dmg = 50.0 ENDIF

    // ★ v0.11：修"僵尸会攻击车辆，但是车辆没有损伤"。
    //   根因：原来只改 `engine/body health` 两个**数值**，而 GTA 的车没有血条 ——
    //   数值掉了玩家完全看不出来，而且改数值**不会产生形变**（连凹陷都没有）。
    //   要让"砸车"看得见，必须用 `SET_VEHICLE_DAMAGE`：它按世界坐标施加真实损伤，
    //   会产生凹陷/掉漆/碎窗/冒烟这些**可视**效果。
    VECTOR vc = GET_ENTITY_COORDS(v, TRUE)
    VECTOR hit
    hit.x = vc.x
    hit.y = vc.y
    hit.z = vc.z + 0.5
    SET_VEHICLE_DAMAGE(v, hit, dmg, 300.0, FALSE)

    // 砸碎车窗：最直观的"僵尸在砸车"信号（随机挑一扇侧窗，40% 概率）
    IF GET_RANDOM_INT_IN_RANGE(0, 100) < 40
        SMASH_VEHICLE_WINDOW(v, INT_TO_ENUM(SC_WINDOW_LIST, GET_RANDOM_INT_IN_RANGE(0, 6)))
    ENDIF

    // 数值损伤也保留（决定车还能不能开、会不会冒烟），留个下限免得被瞬间打报废
    FLOAT eh = GET_VEHICLE_ENGINE_HEALTH(v)
    IF eh > 150.0
        SET_VEHICLE_ENGINE_HEALTH(v, eh - (dmg * 0.4))
    ENDIF
    FLOAT bh = GET_VEHICLE_BODY_HEALTH(v)
    IF bh > 200.0
        SET_VEHICLE_BODY_HEALTH(v, bh - dmg)
    ENDIF

    // 砸出动静：警报 + 引擎开始劣化
    SET_VEHICLE_ALARM(v, TRUE)
    SET_VEHICLE_ENGINE_CAN_DEGRADE(v, TRUE)
ENDPROC

// ---------------------------------------------------------------------------
// 被僵尸从摩托 / 自行车上拽下车 —— v0.12 重做（两段式，照 R* 官方的做法）
//
//   【用户反馈的两件事，都在这里修】
//     ① "瞬间被拽下车、缺少抓拽动作"
//        原来判定命中的**同一帧**就 ragdoll，中间没有任何过程。现在拆成两段：
//          · 阶段一「被抓住」：僵尸转身伸手抓过来 + 播抓取动画 + 摩托被拉住减速，
//            持续约 1.1 秒 —— 玩家能看清"它抓住了我"；
//          · 阶段二「拽下车」：才真正把玩家弄下去。
//     ② "没碰到僵尸就被拽下去"
//        原来摩托复用了"贴到车边砸车"的 4.0m 判定 —— 对一辆行驶中的摩托来说
//        4m 太远了（擦身而过就算命中）。现在抓取用**独立且更近**的判据：
//        `VehicleApproachRange()` 对摩托返回 1.8m（有车厢的车仍是 4.0m 砸车）。
//        参照：R* 官方把骑手从摩托上打下来用的判定距离是 **0.8m**
//        （Paparazzo 任务的 CLOSE_ENOUGH_FOR_BEVERLY_KNOCK_OFF_DISTANCE），
//        我们取 1.8m 已经算宽松。
//
//   【怎么把人弄下车 —— 照抄官方】
//     R* 不用 SET_PED_TO_RAGDOLL 硬摔，而是用引擎自带的击落接口：
//         IF CAN_KNOCK_PED_OFF_VEHICLE(ped)
//             KNOCK_PED_OFF_VEHICLE(ped)
//             APPLY_FORCE_TO_ENTITY(ped, APPLY_TYPE_IMPULSE, <<2.0,0,-4.0>>,
//                                   <<0.0,0.21,0.0>>,
//                                   GET_PED_RAGDOLL_BONE_INDEX(ped, RAGDOLL_HEAD),
//                                   TRUE, TRUE, TRUE)
//         ENDIF
//     引擎自己处理"离车 → 翻滚落地"的物理，比我们硬设 ragdoll 自然得多。
//     来源：singleplayer/scripts/RandomChar/Paparazzo/Paparazzo1.sc
//           的 KBAS_SUCCESSFUL_ATTACK 状态。
//     `CAN_KNOCK_PED_OFF_VEHICLE` 会尊重 `SET_PED_CAN_BE_KNOCKED_OFF_VEHICLE`
//     的设置 —— 所以"有车厢的车拽不下来"由那个开关统一负责（见 UpdateVehicleDragRule），
//     这里不需要再判断车型。
// ---------------------------------------------------------------------------
CONST_FLOAT BIKE_GRAB_RANGE 1.8      // 摩托/自行车：僵尸伸手够得到的距离

// 接近到多近才算"贴上了"：摩托要真的够到手，有车厢的车贴到车边就能砸
FUNC FLOAT VehicleApproachRange(MODEL_NAMES m)
    IF IS_THIS_MODEL_A_BIKE(m) OR IS_THIS_MODEL_A_BICYCLE(m)
        RETURN BIKE_GRAB_RANGE
    ENDIF
    RETURN 4.0
ENDFUNC

// 阶段一：僵尸抓住玩家（只建立"抓住"这个状态，不动玩家）
PROC StartGrapple(PED_INDEX z, PED_INDEX player)
    g_dragZombie = z
    g_dragGrappleUntil = GET_GAME_TIMER() + 1100
    g_dragSlowNext = 0
    // 僵尸：转身面向玩家 + 伸手抓的动作（次级任务槽，不会顶掉主任务）
    TASK_TURN_PED_TO_FACE_ENTITY(z, player, 300)
    TASK_PLAY_ANIM(z, "rcmbarry", "bar_1_teleport_aln", 8.0, 8.0, -1, INT_TO_ENUM(ANIMATION_FLAGS, 48))
    SET_PED_KEEP_TASK(z, TRUE)
    ZombieRoar(z, 2)
ENDPROC

// 阶段二：真正把人从车上弄下来（官方标准的 knock-off 做法）
PROC ExecuteKnockOff(PED_INDEX player, PED_INDEX z)
    IF NOT DOES_ENTITY_EXIST(player)
        EXIT
    ENDIF
    IF NOT IS_PED_IN_ANY_VEHICLE(player)
        EXIT
    ENDIF

    IF CAN_KNOCK_PED_OFF_VEHICLE(player)
        KNOCK_PED_OFF_VEHICLE(player)
        APPLY_FORCE_TO_ENTITY(player, APPLY_TYPE_IMPULSE, <<2.0, 0.0, -4.0>>, <<0.0, 0.21, 0.0>>,
                              GET_PED_RAGDOLL_BONE_INDEX(player, RAGDOLL_HEAD), TRUE, TRUE, TRUE)
    ENDIF

    // 兜底：万一引擎没把他弄下去（比如被障碍卡住），0.35 秒后自己看一眼。
    //   ★ 这里**不再弹任何提示**（用户要求移除"被僵尸拽下了车"那条消息），
    //     表现完全交给物理和动作。
    g_dragVerify = GET_GAME_TIMER() + 350
    g_dragNext = GET_GAME_TIMER() + 8000      // 冷却：别被连着拽

    // 玩家已经被弄下车 -> 把僵尸从"抓取动画"里解放出来，转回正常战斗，
    //   否则它会一直保持抓着人的姿势站在原地。
    IF DOES_ENTITY_EXIST(z) AND NOT IS_ENTITY_DEAD(z, FALSE)
        TASK_COMBAT_PED(z, player)
        SET_PED_KEEP_TASK(z, TRUE)
    ENDIF
ENDPROC

// 抓拽阶段维护（主循环每帧调；不在抓拽中时只有 1 次计时器比较，可忽略）
PROC UpdateGrapple()
    IF g_dragGrappleUntil = 0
        EXIT
    ENDIF

    INT now = GET_GAME_TIMER()
    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player)
        g_dragGrappleUntil = 0
        EXIT
    ENDIF

    // ── 松脱条件（任何一个成立就放弃这次抓拽）──
    IF NOT IS_PED_IN_ANY_VEHICLE(player)
        // 玩家已经自己下车了
        g_dragGrappleUntil = 0
        g_dragZombie = NULL
        EXIT
    ENDIF
    IF NOT DOES_ENTITY_EXIST(g_dragZombie)
    OR IS_ENTITY_DEAD(g_dragZombie, FALSE)
        // 抓住我的那只被打死了 -> 松手
        g_dragGrappleUntil = 0
        g_dragZombie = NULL
        EXIT
    ENDIF
    VEHICLE_INDEX v = GET_VEHICLE_PED_IS_IN(player, FALSE)
    IF NOT DOES_ENTITY_EXIST(v)
        g_dragGrappleUntil = 0
        EXIT
    ENDIF
    IF VDIST(GET_ENTITY_COORDS(player, TRUE), GET_ENTITY_COORDS(g_dragZombie, TRUE)) > 3.5
        // 被甩开了（加速跑掉 / 摩托太猛）-> 抓不住，放手，短冷却后还能再抓
        g_dragGrappleUntil = 0
        g_dragZombie = NULL
        g_dragNext = now + 2500
        EXIT
    ENDIF

    // ── "被拉住"的表现：摩托被强行拖慢 ──
    //   每 0.25 秒设一次（状态设定类 native 不每帧调），
    //   下限 2.0 m/s 免得看起来像"车被冻住"。
    IF now >= g_dragSlowNext
        g_dragSlowNext = now + 250
        FLOAT sp = GET_ENTITY_SPEED(v)
        IF sp > 4.0
            FLOAT ns = sp * 0.6
            SET_VEHICLE_FORWARD_SPEED(v, ns)
        ENDIF
    ENDIF

    // ── 抓满时间 -> 阶段二 ──
    IF now >= g_dragGrappleUntil
        // 先把句柄取出来再清状态（ExecuteKnockOff 之后要给这只僵尸下战斗任务）
        PED_INDEX gz = g_dragZombie
        g_dragGrappleUntil = 0
        g_dragZombie = NULL
        ExecuteKnockOff(player, gz)
    ENDIF
ENDPROC

// 击落后的兜底检查（只有"刚击落"的 0.35 秒内才会真正干活）
PROC VerifyDragOff()
    IF g_dragVerify = 0
        EXIT
    ENDIF
    IF GET_GAME_TIMER() < g_dragVerify
        EXIT
    ENDIF
    g_dragVerify = 0

    PED_INDEX p = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(p)
        EXIT
    ENDIF
    IF IS_PED_IN_ANY_VEHICLE(p)
        // 引擎没把他弄下去 -> 自己来：先再试一次 knock-off，再退化为 ragdoll
        IF CAN_KNOCK_PED_OFF_VEHICLE(p)
            KNOCK_PED_OFF_VEHICLE(p)
        ENDIF
        SET_PED_TO_RAGDOLL(p, 2500, 2500, INT_TO_ENUM(START_RAGDOLL_TASK, 0), FALSE, FALSE, FALSE)
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 搜刮尸体（参考 Reborn 的 PlayerInventory.PickupLoot）
//   僵尸/幸存者倒下后，把**这具尸体**记进一个 6 格环形缓冲；
//   走近 2.5m 会提示"按 [十字键 右] 搜刮尸体"，按了就随机给点东西。
//   ★ 有效性只认"尸体还在"（DOES_ENTITY_EXIST）：被引擎清理掉之后这格作废，
//     不会出现"对着空地也能搜刮"。
//   成本：1Hz 里每格 1 次 DOES_ENTITY_EXIST（最多 6 次），可忽略。
// ---------------------------------------------------------------------------
// kind：0 = 人的尸体，1 = 兽（v0.21）
PROC RememberLoot(PED_INDEX corpse, INT kind)
    IF NOT DOES_ENTITY_EXIST(corpse)
        EXIT
    ENDIF
    g_lootPed[g_lootNext] = corpse
    g_lootKind[g_lootNext] = kind
    g_lootTaken[g_lootNext] = FALSE
    g_lootNext = g_lootNext + 1
    IF g_lootNext > 5 g_lootNext = 0 ENDIF
ENDPROC

// 搜刮收益：弹药 / 医疗 / 护甲，偶尔什么都没有
//   v0.21：多了 kind = 1（猎物）这一支 —— 兽尸只出肉，是人尸收益的"食物专精"版。
PROC TakeLoot(INT kind)
    PED_INDEX player = PLAYER_PED_ID()

    IF kind = 1
        // ── 猎物：割肉 ──
        //   设计意图：这是 v0.15 生存三柱的"食物来源"，比翻箱子更有末日感。
        IF g_survival AND g_infection
            // v0.24：数值减半（用户反馈"一次掉 40 太多了，20 差不多"）
            g_food = g_food + 25.0
            IF g_food > 100.0 g_food = 100.0 ENDIF
            g_specialMsg = "割下 兽肉 饥饿 +25"
        ELSE
            // 生存需求关着时给点小回血，免得"搜了等于白搜"
            INT hpa = GET_ENTITY_HEALTH(player)
            SET_ENTITY_HEALTH(player, hpa + 10)
            g_specialMsg = "割下 兽肉 生命 +10"
        ENDIF
        g_specialUntil = GET_GAME_TIMER() + 3000
        EXIT
    ENDIF

    INT roll = GET_RANDOM_INT_IN_RANGE(0, 100)
    IF g_survival AND g_infection
        // v0.15：生存需求开着时，补给表里加入 罐头 / 瓶装水
        //   （否则"搜刮"出来的食物饮水毫无意义）
        IF roll < 18
            IF IS_PED_ARMED(player, 7)
                ADD_AMMO_TO_PED(player, WEAPONTYPE_PISTOL, 20)
                g_specialMsg = "搜到 手枪弹 x20"
            ELSE
                GIVE_WEAPON_TO_PED(player, WEAPONTYPE_PISTOL, 20, FALSE, TRUE)
                g_specialMsg = "搜到 一把手枪"
            ENDIF
        ELIF roll < 36
            g_food = g_food + 20.0
            IF g_food > 100.0 g_food = 100.0 ENDIF
            g_specialMsg = "搜到 罐头 饥饿 +20"
        ELIF roll < 54
            g_water = g_water + 20.0
            IF g_water > 100.0 g_water = 100.0 ENDIF
            g_specialMsg = "搜到 瓶装水 水分 +20"
        ELIF roll < 72
            INT hp = GET_ENTITY_HEALTH(player)
            SET_ENTITY_HEALTH(player, hp + 25)
            g_specialMsg = "搜到 医疗包 生命 +25"
        ELIF roll < 88
            INT ar = GET_PED_ARMOUR(player)
            SET_PED_ARMOUR(player, ar + 25)
            g_specialMsg = "搜到 防弹衣 护甲 +25"
        ELSE
            g_specialMsg = "尸体上什么都没有"
        ENDIF
    ELSE
        // 生存需求关着 -> 沿用原来的四档（食物饮水没意义就不出现）
        IF roll < 32
            IF IS_PED_ARMED(player, 7)
                ADD_AMMO_TO_PED(player, WEAPONTYPE_PISTOL, 20)
                g_specialMsg = "搜到 手枪弹 x20"
            ELSE
                GIVE_WEAPON_TO_PED(player, WEAPONTYPE_PISTOL, 20, FALSE, TRUE)
                g_specialMsg = "搜到 一把手枪"
            ENDIF
        ELIF roll < 57
            INT hp2 = GET_ENTITY_HEALTH(player)
            SET_ENTITY_HEALTH(player, hp2 + 25)
            g_specialMsg = "搜到 医疗包 生命 +25"
        ELIF roll < 82
            INT ar2 = GET_PED_ARMOUR(player)
            SET_PED_ARMOUR(player, ar2 + 25)
            g_specialMsg = "搜到 防弹衣 护甲 +25"
        ELSE
            g_specialMsg = "尸体上什么都没有"
        ENDIF
    ENDIF

    // ★ v0.22：汽车零件 —— **独立掷骰**，不占用上面的补给档位。
    //   为什么要独立：如果把它塞进那张表里，就等于"每 6~7 具尸体必出一个"，
    //   修车会变得太轻松（用户要求"概率低一些、不能太轻松修好车"）。
    //   现在 15%（PART_DROP_PCT），修一辆车要 3 个 —— 期望上得搜二十来具尸体。
    //   ★ 副作用说明：屏幕提示只有一行，所以"搜到零件"会把这件尸体原本的补给提示
    //     顶掉 —— 但补给**照给**，只是没写出来。数量看左上角的「零件」计数。
    IF GET_RANDOM_INT_IN_RANGE(0, 100) < PART_DROP_PCT
        g_parts = g_parts + 1
        g_specialMsg = "搜到 汽车零件"
    ENDIF

    g_specialUntil = GET_GAME_TIMER() + 3000
ENDPROC

// ---------------------------------------------------------------------------
// 目标在车里时的行为（v0.9 新增）—— 修"僵尸看着我却不过来"
//
//   为什么必须自己驱动：
//     `TASK_COMBAT_PED` 对"人在车里的目标"是**没法执行的** —— 引擎的战斗 AI
//     判断"打不到车里的人"，于是让 ped 原地保持敌对姿态（看着你、做出想打的
//     样子、不移动）。这就是反馈里"僵尸看向我做出想打我的样子，但不朝我走过来"
//     的确切原因。
//   现在分两段自己驱动：
//     · 距离 >4m：`TASK_GO_TO_ENTITY` 目标设成**车本身**（引擎的寻路对"实体"
//       是有效的），真的走过去；2.5 秒最多重下一次，避免任务抖动。
//     · 距离 <=4m：把战斗任务交还引擎（近战砸车是引擎的强项，动画也由它播），
//       我们只额外负责车身掉血 + 警报，节奏 2 秒一次 —— 原来和"尖啸者尖啸"
//       共用同一个冷却计时器，两边互相顶掉，砸车动作看着就像"做一半又重来"。
//     · 摩托 / 自行车（没有车厢）：**不砸车**，改为「抓住 -> 拽下车」两段式
//       （StartGrapple / ExecuteKnockOff）。摔在僵尸堆里就是找死。
//   ★ v0.12：接近判定改成按车型区分（`VehicleApproachRange`）——
//     摩托要 1.8m 才算贴到手，有车厢的车仍 4.0m 就能砸。
// ---------------------------------------------------------------------------
PROC HandleVehicleTarget(INT i, PED_INDEX z, PED_INDEX tgt, FLOAT dz)
    VEHICLE_INDEX v = GET_VEHICLE_PED_IS_IN(tgt, FALSE)
    IF NOT DOES_ENTITY_EXIST(v)
        EXIT
    ENDIF

    INT now = GET_GAME_TIMER()
    // ★ 性能：目标就是玩家时（绝大多数情况），僵尸到玩家的距离 ≈ 到车的距离，
    //   直接复用主循环已经算好的 dz，省掉每帧两次取坐标的 native。
    FLOAT d = dz
    IF tgt <> PLAYER_PED_ID()
        d = VDIST(GET_ENTITY_COORDS(z, TRUE), GET_ENTITY_COORDS(v, TRUE))
    ENDIF

    MODEL_NAMES vm = GET_ENTITY_MODEL(v)
    // ★ v0.12：接近判定按车型区分 ——
    //   摩托/自行车要**真的够到手**（1.8m）才算贴上；有车厢的车贴到车边（4.0m）就能砸。
    //   原来两种车统一用 4.0m，这就是"骑车从僵尸旁边过、根本没碰到就被拽下车"的根因。
    //   顺带好处：骑得快的时候僵尸根本追不进 1.8m，自然也就拽不到你。
    IF d > VehicleApproachRange(vm)
        IF now > g_zApproachUntil[i]
            g_zApproachUntil[i] = now + 2500
            TASK_GO_TO_ENTITY(z, v, 5000, 1.2, PEDMOVEBLENDRATIO_RUN, 2.0)
            SET_PED_KEEP_TASK(z, TRUE)
            // 换任务就是游戏可能重置走路姿态的时机 -> 顺手补一次
            ApplyZombieLook(i)
        ENDIF
        EXIT
    ENDIF

    // ★ v0.10：引擎**不会**替我们攻击"人在车里"的目标 —— 它根本不认为那是
    //   一个可攻击目标（这就是"追到车边既不攻击、也没有任何攻击动作"的原因）。
    //   所以贴到车边之后全部自己来：
    //     1) 转身面向车辆（引擎不会替我们转）
    //     2) 播攻击动画（次级任务槽，不占主任务）
    //     3) 车身伤害 + 警报 + 吼叫
    //   节奏 1.6 秒一次，和动画（播完整段）对齐，不会"做一半又重来"。
    //
    //   ★ v0.12 保护：正在**抓着玩家**的那只僵尸不要走这里 ——
    //     否则它自己那套"抓住"的动画会被这里的扑击动画顶掉，
    //     看起来就是"抓一半又改成挥拳"。抓拽期间让它安静地抓完。
    IF g_dragGrappleUntil > 0 AND g_dragZombie = z
        EXIT
    ENDIF

    IF now > g_zNextSmash[i]
        g_zNextSmash[i] = now + 1600

        TASK_TURN_PED_TO_FACE_ENTITY(z, v, 400)
        TASK_PLAY_ANIM(z, "rcmbarry", "bar_1_teleport_aln", 8.0, 8.0, -1, INT_TO_ENUM(ANIMATION_FLAGS, 48))
        SET_PED_KEEP_TASK(z, TRUE)
        // 吼叫只在半数攻击时发 —— 车边常常围着一圈僵尸，
        // 每只都 1.6 秒吼一次会糊成一片噪音
        IF GET_RANDOM_INT_IN_RANGE(0, 100) < 50
            ZombieRoar(z, 1)
        ENDIF

        IF IS_THIS_MODEL_A_BIKE(vm) OR IS_THIS_MODEL_A_BICYCLE(vm)
            // 摩托 / 自行车：没有车厢保护 -> 抓住玩家把他拽下车。
            //   ★ v0.12：这里**只启动"抓住"**，真正的拽下车在 1.1 秒后由
            //     UpdateGrapple -> ExecuteKnockOff 执行（见那两处的说明）。
            //     外层已经保证 d <= BIKE_GRAB_RANGE(1.8m)，所以这里是真正的贴身距离。
            //     摩托不砸车：没有车厢可砸，砸了也没有观感。
            IF IS_PED_A_PLAYER(tgt)
            AND now > g_dragNext
            AND g_dragGrappleUntil = 0
                StartGrapple(z, tgt)
            ENDIF
        ELSE
            SmashVehicle(z, tgt, g_zType[i])
        ENDIF
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 每帧的僵尸主循环（把原来的"行为"和"维护列表"两趟遍历合并成一趟）
//
//   ★ 性能设计（Switch 上很要紧，尽量少烧 native 调用）：
//     · 只遍历一次 —— 原来每帧遍历两遍，每遍都要 DOES_ENTITY_EXIST + IS_ENTITY_DEAD
//     · 玩家坐标每帧只取一次 —— 原来每只僵尸各取一次
//     · 距离用内建 `VDIST2`（VM 指令），代替 GET_DISTANCE_BETWEEN_COORDS（native 调用）
//     · 攻击判定复用已经取到的僵尸坐标，只需要再取一次目标坐标（原来要 3 次 native）
//     · 走路姿态改成**事件驱动**：只在换任务时重设（ApplyZombieLook），
//       不再每 2 秒整批刷；战斗属性也不再每 5 秒刷（它们本来就不会被游戏重置）
//     · 只留一个 10 秒的"保险"整批重设（32 只 × 2 次 / 10 秒 ≈ 6 次/秒，可忽略）
// ---------------------------------------------------------------------------
PROC UpdateZombieWorld()
    IF g_zombieCount <= 0
        EXIT
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    // 走路姿态的保险 pass：6 秒一次（问题 3）
    //   clipset 会被"进入战斗 / 受击 / 被推挤 / 换任务"重置，事件驱动覆盖不到全部，
    //   所以留一个低频兜底。32 只 × 2 次 native / 6 秒 ≈ 10 次/秒，可以忽略。
    BOOL restyleAll = GET_GAME_TIMER() >= g_zWalkTime
    IF restyleAll
        g_zWalkTime = GET_GAME_TIMER() + 6000
    ENDIF

    // 感知节流间隔 —— 对照 Reborn：平时 900~1400ms，有噪声时才 180~700ms
    // （Reborn 的完整表：无噪音且距玩家 >60m 用 900-1400ms，否则 400-700ms；
    //   噪音 >90 用 180-340ms，否则 90-180ms。这里取"有噪声 400 / 无噪声 900"）
    INT senseGap = 900
    IF GET_GAME_TIMER() < g_noiseUntil
        senseGap = 400
    ENDIF

    INT i = 0
    WHILE i < g_zombieCount
        PED_INDEX z = g_zombies[i]
        INT zt = g_zType[i]
        BOOL drop = FALSE

        IF NOT DOES_ENTITY_EXIST(z)
            drop = TRUE
        ELSE
            VECTOR zc = GET_ENTITY_COORDS(z, TRUE)
            FLOAT dz = VDIST(pc, zc)

            IF IS_ENTITY_DEAD(z, FALSE)
                // 死了：把这具尸体记进可搜刮名单，然后只解除脚本引用 -> 尸体留在世界里
                RememberLoot(z, 0)
                SET_PED_AS_NO_LONGER_NEEDED(z)
                drop = TRUE
                // ★ v0.10：刚死一只就延后 3 秒再补 —— 否则上限一空出来，
                //   下一个 1.5 秒的刷怪 tick 立刻补上一只，观感上就是
                //   "打死一只，立刻凭空又冒出一只"。
                IF g_nextSpawn < GET_GAME_TIMER() + 3000
                    g_nextSpawn = GET_GAME_TIMER() + 3000
                ENDIF
            ELIF dz > 300.0
                SET_PED_AS_NO_LONGER_NEEDED(z)
                drop = TRUE
            ELSE
                // 注意：这里不再做任何掐麦/静音 —— 僵尸的声音统一交给
                // ZombieRoar()（非语言痛觉音），任何"每帧静音"都会把它一起掐掉。
                IF IS_ENTITY_ON_FIRE(z)
                    // 着火就烧死（原版：IsOnFire 且没死 -> Kill）
                    SET_ENTITY_HEALTH(z, 0)
                ELSE
                    // ★ v0.9：这里原来每帧设 PRF_DisableTalk / PRF_DisableCombatAudio
                    //   来"封嘴"，但那把**嘶吼也一起封掉了**（这两个标志关的是整条
                    //   发声通道，不只是台词）。现在改用"换怪物声道"从源头消灭人话，
                    //   这里不再做任何屏蔽 —— 僵尸的叫声才出得来。
                    IF restyleAll
                        ApplyZombieLook(i)
                    ENDIF

                    // 嘶吼 / 低吼（问题 4）：只要在追人就周期性发声 —— 走尸也一样，
                    // 而且间隔从 4~8 秒压到 2.5~6.5 秒，让街上真的有"僵尸在叫"的感觉。
                    IF g_zAggro[i]
                        IF GET_GAME_TIMER() >= g_zNextVoice[i]
                            g_zNextVoice[i] = GET_GAME_TIMER() + GET_RANDOM_INT_IN_RANGE(2500, 6500)
                            ZombieRoar(z, 0)
                        ENDIF
                    ENDIF

                    // 目标搜索：有目标时不重搜（Refresh 内部会判断）；
                    // 玩家 150m 外的僵尸直接跳过（它很快就会被清理）
                    IF GET_GAME_TIMER() >= g_zThink[i] AND dz < 150.0
                        g_zThink[i] = GET_GAME_TIMER() + senseGap
                        RefreshZombieTarget(i, pc, dz)

                        // ★ 看门狗（问题 8 的第二道保险）：
                        //   明明有目标，却没在战斗 —— 说明任务被别的任务（撕咬动画、
                        //   被撞、被 ragdoll）顶掉了。这时立刻把战斗任务补回去，
                        //   并把走路姿态一起补回来。僵尸"站着不动"就是这里救回来的。
                        PED_INDEX wd = g_zTarget[i]
                        IF DOES_ENTITY_EXIST(wd) AND NOT IS_ENTITY_DEAD(wd, FALSE)
                            // ★ 目标在车里时不要在这里补战斗任务 —— 那会把
                            //   HandleVehicleTarget 下的"追到车边"任务顶掉，
                            //   僵尸就又站住了。
                            BOOL wdVeh = IS_PED_IN_ANY_VEHICLE(wd)
                            // 去抖：同一只僵尸 2.5 秒内只补一次，避免"任务抖动"
                            IF NOT IS_PED_IN_COMBAT(z)
                            AND NOT wdVeh
                            AND GET_GAME_TIMER() > g_zNudge[i]
                                g_zNudge[i] = GET_GAME_TIMER() + 2500
                                TASK_COMBAT_PED(z, wd)
                                SET_PED_KEEP_TASK(z, TRUE)
                                ApplyZombieLook(i)
                            ENDIF
                        ENDIF
                    ENDIF

                    PED_INDEX tgt = g_zTarget[i]
                    BOOL hasTgt = DOES_ENTITY_EXIST(tgt)
                    IF hasTgt
                        hasTgt = NOT IS_ENTITY_DEAD(tgt, FALSE)
                    ENDIF

                    // 尖啸者：目标在 28m 内就尖啸召潮（对照 Reborn 的 Screamer，冷却 18~31 秒）
                    IF zt = ZTYPE_SCREAMER AND hasTgt AND dz < 60.0
                        IF GET_GAME_TIMER() >= g_zNextRoar[i]
                            g_zNextRoar[i] = GET_GAME_TIMER() + GET_RANDOM_INT_IN_RANGE(18000, 31000)
                            ZombieRoar(z, 2)
                            // 召潮：拉高噪声 + 触发尸潮压力
                            g_noise = 75.0
                            g_noiseUntil = GET_GAME_TIMER() + 5000
                            g_hordeUntil = GET_GAME_TIMER() + 30000
                            g_pressure = g_pressure + 0.25
                            IF g_pressure > 2.2 g_pressure = 2.2 ENDIF
                            g_specialUntil = GET_GAME_TIMER() + 4000
                            g_specialMsg = "尸潮来袭"
                        ENDIF
                    ENDIF

                    // 目标在车里？走专门的"追车 + 砸车"分支（见 HandleVehicleTarget）。
                    //   绝对不要在这个分支里播撕咬动画 —— 那正是"僵尸在车边做一半
                    //   攻击动作又重来"的来源：动画占了任务槽，引擎的砸车动作被打断。
                    BOOL tgtVeh = FALSE
                    IF hasTgt
                        IF IS_PED_IN_ANY_VEHICLE(tgt)
                            tgtVeh = TRUE
                        ENDIF
                    ENDIF

                    IF hasTgt AND tgtVeh
                        g_zAttacking[i] = FALSE
                        HandleVehicleTarget(i, z, tgt, dz)
                    ELIF hasTgt
                        IF VDIST2(zc, GET_ENTITY_COORDS(tgt, TRUE)) < 4.84   // 2.2m²
                            // 靠 ZombieAttack 内部的冷却控制节奏；
                            // 只有"这一场交手的第一口"才允许扑倒
                            ZombieAttack(i, NOT g_zAttacking[i])
                            g_zAttacking[i] = TRUE
                        ELSE
                            g_zAttacking[i] = FALSE
                        ENDIF
                    ELSE
                        g_zAttacking[i] = FALSE
                    ENDIF
                ENDIF
            ENDIF
        ENDIF

        IF drop
            // v0.13：地图标记是可选的 —— 存在就清掉
            IF DOES_BLIP_EXIST(g_zBlip[i])
                REMOVE_BLIP(g_zBlip[i])
            ENDIF
            INT last = g_zombieCount - 1
            g_zombieCount = last
            g_zombies[i] = g_zombies[last]
            g_zBlip[i] = g_zBlip[last]
            g_zAggro[i] = g_zAggro[last]
            g_zType[i] = g_zType[last]
            g_zAttacking[i] = g_zAttacking[last]
            g_zNextAttack[i] = g_zNextAttack[last]
            g_zTarget[i] = g_zTarget[last]
            g_zTargetTime[i] = g_zTargetTime[last]
            g_zThink[i] = g_zThink[last]
            g_zNextVoice[i] = g_zNextVoice[last]
            g_zNextRoar[i] = g_zNextRoar[last]
            g_zNudge[i] = g_zNudge[last]
            g_zNextSmash[i] = g_zNextSmash[last]
            g_zApproachUntil[i] = g_zApproachUntil[last]
        ELSE
            i = i + 1
        ENDIF
    ENDWHILE
ENDPROC

// ---------------------------------------------------------------------------
// 幸存者小队（原版 FriendlySurvivors：3~5 人，带武器，蓝点）
// ---------------------------------------------------------------------------
PROC SpawnSurvivors()
    IF NOT g_modelReady
        EXIT
    ENDIF
    IF g_survivorCount > 0
        EXIT
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player)
        EXIT
    ENDIF

    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)
    INT want = GET_RANDOM_INT_IN_RANGE(3, 6)
    INT placed = 0
    INT guard = 0

    WHILE placed < want AND guard < 12
        guard = guard + 1

        FLOAT ang = GET_RANDOM_FLOAT_IN_RANGE(0.0, 360.0)
        FLOAT rad = ang * 0.01745329
        FLOAT dist = GET_RANDOM_FLOAT_IN_RANGE(25.0, 45.0)

        VECTOR spot
        spot.x = pc.x + dist * SIN(rad)
        spot.y = pc.y + dist * COS(rad)
        spot.z = pc.z + 0.5

        // ★★ v0.42 修 BUG【幸存者一刷出来就"嚎叫"一声】：
        //   原来落点**没做任何地面校验**（直接给 `pc.z + 0.5`），在起伏地形/楼边会生成在
        //   半空或楼里 —— 引擎把他"落"下去/挤出来，顺带放一声惨叫。
        //   （**不是**把僵尸的发声通道套上去了：换声道 `SET_AMBIENT_VOICE_NAME("ALIENS")`
        //     只在 `MakeIntoZombie()` 里调用，幸存者不走那条路。）
        //   ⇒ 照僵尸生成的做法：请求碰撞 -> 取地面高度 -> 放在地面上方 0.5 米，
        //     并挡掉"室内/楼里"和"与玩家高差太大"的点。
        BOOL sok = TRUE
        spot.z = pc.z + 60.0
        REQUEST_COLLISION_AT_COORD(spot)
        FLOAT sgz = 0.0
        IF GET_INTERIOR_AT_COORDS(spot) != NULL
            sok = FALSE                     // 室内/楼里的点不要
        ELIF GET_GROUND_Z_FOR_3D_COORD(spot, sgz)
            spot.z = sgz + 0.5
            FLOAT sd = spot.z - pc.z
            IF sd > 12.0 OR sd < -12.0
                sok = FALSE                 // 别刷在楼顶/深坑
            ENDIF
            // ★ v0.45：**水里也不刷幸存者**。
            //   注意必须放在"取到地面高度之后" —— 上面 `spot.z` 还是 `pc.z + 60`（探测高度），
            //   那时候拿它跟水面比是白判（这也是本轮审查抓出来的一处自摆乌龙）。
            FLOAT swh
            IF GET_WATER_HEIGHT_NO_WAVES(spot, swh)
                IF spot.z < swh + 0.3
                    sok = FALSE
                ENDIF
            ENDIF
        ELSE
            spot.z = pc.z + 0.5             // 取不到地面就退回原行为
        ENDIF

        // 落点合格（不是室内/高差离谱）且没被占 -> 才真生成
        IF sok AND NOT IS_POSITION_OCCUPIED(spot, 2.0, FALSE, TRUE, TRUE, FALSE, FALSE, player, FALSE)
            MODEL_NAMES mdl = RandomCivilianModel()
            PED_INDEX s = CREATE_PED(PEDTYPE_CIVMALE, mdl, spot, GET_RANDOM_FLOAT_IN_RANGE(0.0, 360.0), TRUE, FALSE)
            IF DOES_ENTITY_EXIST(s)
                SET_PED_RANDOM_COMPONENT_VARIATION(s)
                SET_PED_RELATIONSHIP_GROUP_HASH(s, g_sGroup)
                // v0.9：血/护甲/命中小幅加强，并让他在 7~30m 的中距离对射
                //   （原来默认"向前压"会直接冲进尸群送死，你走过去就只剩下尸体了）
                SET_ENTITY_MAX_HEALTH(s, 350)
                SET_ENTITY_HEALTH(s, 350)
                SET_PED_ARMOUR(s, 60)
                GIVE_WEAPON_TO_PED(s, WEAPONTYPE_PISTOL, 200, FALSE, TRUE)
                // 被打死时会掉枪（地上可以捡）
                SET_PED_DROPS_WEAPONS_WHEN_DEAD(s, TRUE)
                SET_PED_ACCURACY(s, 45)
                SET_PED_ALERTNESS(s, AS_VERY_ALERT)
                SET_PED_COMBAT_RANGE(s, CR_MEDIUM)
                SET_PED_COMBAT_ABILITY(s, CAL_AVERAGE)
                // 感知范围放大 + 抗摔倒：让"看到僵尸就开打"靠引擎完成，
                // 不需要我们频繁重下任务（少下任务 = 少抖）
                SET_PED_SEEING_RANGE(s, 60.0)
                SET_PED_HEARING_RANGE(s, 80.0)
                SET_PED_RAGDOLL_ON_COLLISION(s, FALSE)
                SET_PED_COMBAT_ATTRIBUTES(s, CA_ALWAYS_FIGHT, TRUE)
                SET_PED_FLEE_ATTRIBUTES(s, FA_NEVER_FLEE, TRUE)
                SET_BLOCKING_OF_NON_TEMPORARY_EVENTS(s, TRUE)
                TASK_COMBAT_HATED_TARGETS_AROUND_PED(s, 70.0)
                SET_PED_KEEP_TASK(s, TRUE)

                g_sBlip[g_survivorCount] = ADD_BLIP_FOR_ENTITY(s)
                SET_BLIP_COLOUR(g_sBlip[g_survivorCount], 3)
                SET_BLIP_SCALE(g_sBlip[g_survivorCount], 0.7)
                SET_BLIP_AS_SHORT_RANGE(g_sBlip[g_survivorCount], TRUE)

                g_survivors[g_survivorCount] = s
                g_sAngryUntil[g_survivorCount] = 0
                g_survivorCount = g_survivorCount + 1
                placed = placed + 1
            ENDIF
        ENDIF
    ENDWHILE
ENDPROC

// 幸存者维护
//   ★ 关于"打幸存者"的设计（迭代了三次，最终方案）：
//     - 关系组**永远不动**（SetupRelations 里设一次 RESPECT 就完事）→ 谁都不会被
//       牵连成敌对，新刷出来的幸存者一定还是友军（蓝点）。
//     - 但"完全不理你"也不自然，所以改成**只有被你打中的那一个**会还手：
//       该幸存者单独 TASK_COMBAT_PED 打你、地标变红；**其它队友照常打僵尸**。
//       25 秒内没再被打就自动消气，回去打僵尸、地标变回蓝色。
//     - 因为改的是"任务"而不是"关系组"，所以对其它幸存者（含以后新生成的）零影响。
PROC UpdateSurvivors()
    IF g_survivorCount <= 0
        EXIT
    ENDIF

    INT now = GET_GAME_TIMER()
    BOOL retask = now >= g_nextSurvRetask
    IF retask
        g_nextSurvRetask = now + 4000
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    INT i = 0
    WHILE i < g_survivorCount
        BOOL drop = FALSE

        IF NOT DOES_ENTITY_EXIST(g_survivors[i])
            drop = TRUE
        ELIF IS_ENTITY_DEAD(g_survivors[i], FALSE)
            // 死之前把手上的枪放地上（配合 SET_PED_DROPS_WEAPONS_WHEN_DEAD）
            SET_PED_DROPS_WEAPON(g_survivors[i])
            RememberLoot(g_survivors[i], 0)
            SET_PED_AS_NO_LONGER_NEEDED(g_survivors[i])
            drop = TRUE
        ELIF GET_PED_RELATIONSHIP_GROUP_HASH(g_survivors[i]) = g_zGroup
            // 真的被同化成僵尸了 -> 从名单和地图上移除（否则你会看到
            // 一个蓝色的"幸存者"点，走过去按互动键却毫无反应）
            SET_PED_AS_NO_LONGER_NEEDED(g_survivors[i])
            drop = TRUE
        ELIF GET_PED_RELATIONSHIP_GROUP_HASH(g_survivors[i]) <> g_sGroup
            // ★ v0.9：只是关系组被别的脚本改掉了 —— **纠正回来**。
            //   上一版这里直接把人和蓝点一起丢掉，这正是"蓝点闪一下就没了"
            //   的另一条可能路径（任何原因导致组不一致都会当场清场）。
            SET_PED_RELATIONSHIP_GROUP_HASH(g_survivors[i], g_sGroup)
        ELIF GET_DISTANCE_BETWEEN_COORDS(pc, GET_ENTITY_COORDS(g_survivors[i], TRUE), TRUE) > 200.0
            SET_PED_AS_NO_LONGER_NEEDED(g_survivors[i])
            drop = TRUE
        ELSE
            // 被玩家打中 -> 这个人还手 25 秒
            IF HAS_ENTITY_BEEN_DAMAGED_BY_ENTITY(g_survivors[i], player)
                g_sAngryUntil[i] = GET_GAME_TIMER() + 25000
                IF DOES_BLIP_EXIST(g_sBlip[i])
                    SET_BLIP_COLOUR(g_sBlip[i], 1)     // 变红：他翻脸了
                ENDIF
            ENDIF

            IF g_sAngryUntil[i] > 0
                IF GET_GAME_TIMER() > g_sAngryUntil[i]
                    // 消气：回去打僵尸
                    g_sAngryUntil[i] = 0
                    IF DOES_BLIP_EXIST(g_sBlip[i])
                        SET_BLIP_COLOUR(g_sBlip[i], 3)
                    ENDIF
                    TASK_COMBAT_HATED_TARGETS_AROUND_PED(g_survivors[i], 70.0)
                    SET_PED_KEEP_TASK(g_survivors[i], TRUE)
                ELSE
                    // 还在气头上：打玩家
                    TASK_COMBAT_PED(g_survivors[i], player)
                    SET_PED_KEEP_TASK(g_survivors[i], TRUE)
                ENDIF
            ELSE
                // 让幸存者主动去找僵尸打。
                // ★ 间隔必须够长：这个维护循环每 0.5 秒跑一次，原来每 0.5 秒
                //   就重下一次 TASK_COMBAT_HATED_TARGETS_AROUND_PED，任务被反复
                //   重置 -> 走路也是一走一停（和护卫那个 bug 同源）。
                //   现在统一 4 秒才允许重下一次，且只在他们没在战斗时。
                IF retask AND NOT IS_PED_IN_COMBAT(g_survivors[i])
                    TASK_COMBAT_HATED_TARGETS_AROUND_PED(g_survivors[i], 70.0)
                    SET_PED_KEEP_TASK(g_survivors[i], TRUE)
                ENDIF
            ENDIF
        ENDIF

        IF drop
            IF DOES_BLIP_EXIST(g_sBlip[i])
                REMOVE_BLIP(g_sBlip[i])
            ENDIF
            INT last = g_survivorCount - 1
            g_survivorCount = last
            g_survivors[i] = g_survivors[last]
            g_sBlip[i] = g_sBlip[last]
            g_sAngryUntil[i] = g_sAngryUntil[last]
        ELSE
            i = i + 1
        ENDIF
    ENDWHILE
ENDPROC

// ---------------------------------------------------------------------------
// 警察巡逻队（会跟僵尸打起来）
//   僵尸与警察的关系在 SetupRelations() 里已经设成互相敌对，所以只要把警察放到
//   附近，他们自己就会交火。为了不刷屏 + 不增加太多负担：
//     · 同一时间最多一队（2~3 人）
//     · 场上僵尸少于 6 只时不派（没什么可打的）
//     · 派过一次后至少间隔 3 分钟
// ---------------------------------------------------------------------------
PROC ForgetAllCops()
    INT i = 0
    WHILE i < g_copCount
        IF DOES_ENTITY_EXIST(g_cops[i])
            SET_ENTITY_AS_MISSION_ENTITY(g_cops[i], TRUE, TRUE)
            DELETE_PED(g_cops[i])
        ENDIF
        i = i + 1
    ENDWHILE
    g_copCount = 0
ENDPROC

PROC SpawnCopPatrol()
    IF NOT g_modelReady
        EXIT
    ENDIF
    IF g_copCount > 0
        EXIT
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)
    INT want = GET_RANDOM_INT_IN_RANGE(2, 4)
    INT placed = 0
    INT guard = 0

    WHILE placed < want AND guard < 10
        guard = guard + 1

        FLOAT ang = GET_RANDOM_FLOAT_IN_RANGE(0.0, 360.0)
        FLOAT rad = ang * 0.01745329
        FLOAT dist = GET_RANDOM_FLOAT_IN_RANGE(40.0, 70.0)

        VECTOR spot
        spot.x = pc.x + dist * SIN(rad)
        spot.y = pc.y + dist * COS(rad)
        spot.z = pc.z + 60.0

        REQUEST_COLLISION_AT_COORD(spot)
        FLOAT gz = 0.0
        BOOL cok = FALSE
        VECTOR csafe
        // ★★ v0.45（本轮审查修正）：警察巡逻原来**只**用 `GET_GROUND_Z_FOR_3D_COORD` ——
        //   和僵尸当初那个 bug 完全同源：
        //     ① 山上/野外那个坐标的碰撞往往还没流式加载好 ⇒ 整队刷不出来；
        //     ② 没有水源/室内/楼顶校验 ⇒ 可能刷在海里。
        //   ⇒ 改成和僵尸同一套口径：导航面优先（排除水面）→ 地形兜底 → `GroundSpotOK` 全套。
        IF GET_SAFE_COORD_FOR_PED(spot, FALSE, csafe, GSC_FLAG_NOT_WATER)
            spot.x = csafe.x
            spot.y = csafe.y
            spot.z = csafe.z + 0.6
            gz = csafe.z
            cok = TRUE
        ELIF GET_GROUND_Z_FOR_3D_COORD(spot, gz)
            spot.z = gz + 0.6
            cok = TRUE
        ENDIF
        IF cok
            IF GroundSpotOK(spot, pc, gz, 2.0) AND NOT InCampSafeZone(spot)
                IF NOT IS_POSITION_OCCUPIED(spot, 2.0, FALSE, TRUE, TRUE, FALSE, FALSE, player, FALSE)
                    PED_INDEX c = CREATE_PED(PEDTYPE_COP, S_M_Y_COP_01, spot, GET_RANDOM_FLOAT_IN_RANGE(0.0, 360.0), TRUE, FALSE)
                    IF DOES_ENTITY_EXIST(c)
                        // 用自己的巡逻组：对玩家尊重 -> 你在旁边开枪他也不会打你（问题 5）
                        SET_PED_RELATIONSHIP_GROUP_HASH(c, g_copGroup)
                        SET_PED_CAN_BE_TARGETTED(c, TRUE)
                        // 问题 5 配套：警方默认会"听到枪声就过去调查"，那正好会撞上玩家。
                        // 关掉调查行为 + 打开主动推进，他只认关系组里的敌人（僵尸）。
                        SET_PED_COMBAT_ATTRIBUTES(c, CA_CAN_INVESTIGATE, FALSE)
                        SET_PED_COMBAT_ATTRIBUTES(c, CA_AGGRESSIVE, TRUE)
                        SET_ENTITY_MAX_HEALTH(c, 300)
                        SET_ENTITY_HEALTH(c, 300)
                        SET_PED_ARMOUR(c, 100)
                        GIVE_WEAPON_TO_PED(c, WEAPONTYPE_PISTOL, 250, FALSE, TRUE)
                        SET_PED_ACCURACY(c, 40)
                        SET_PED_ALERTNESS(c, AS_VERY_ALERT)
                        SET_PED_COMBAT_ATTRIBUTES(c, CA_ALWAYS_FIGHT, TRUE)
                        SET_PED_FLEE_ATTRIBUTES(c, FA_NEVER_FLEE, TRUE)
                        SET_BLOCKING_OF_NON_TEMPORARY_EVENTS(c, TRUE)
                        SET_PED_DROPS_WEAPONS_WHEN_DEAD(c, TRUE)
                        TASK_COMBAT_HATED_TARGETS_AROUND_PED(c, 90.0)
                        SET_PED_KEEP_TASK(c, TRUE)

                        g_cops[g_copCount] = c
                        g_copCount = g_copCount + 1
                        placed = placed + 1
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDWHILE
ENDPROC

PROC UpdateCops()
    IF g_copCount <= 0
        EXIT
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    INT i = 0
    WHILE i < g_copCount
        BOOL drop = FALSE

        IF NOT DOES_ENTITY_EXIST(g_cops[i])
            drop = TRUE
        ELIF IS_ENTITY_DEAD(g_cops[i], FALSE)
            SET_PED_AS_NO_LONGER_NEEDED(g_cops[i])
            drop = TRUE
        ELIF GET_DISTANCE_BETWEEN_COORDS(pc, GET_ENTITY_COORDS(g_cops[i], TRUE), TRUE) > 250.0
            SET_PED_AS_NO_LONGER_NEEDED(g_cops[i])
            drop = TRUE
        ELSE
            IF NOT IS_PED_IN_COMBAT(g_cops[i])
                TASK_COMBAT_HATED_TARGETS_AROUND_PED(g_cops[i], 90.0)
                SET_PED_KEEP_TASK(g_cops[i], TRUE)
            ENDIF
        ENDIF

        IF drop
            INT last = g_copCount - 1
            g_copCount = last
            g_cops[i] = g_cops[last]
        ELSE
            i = i + 1
        ENDIF
    ENDWHILE
ENDPROC

// ---------------------------------------------------------------------------
// 敌对掠夺者车队（参考 Reborn 的 HostileSurvivors）
//   一车 3~4 个武装歹徒，从 90~150m 外开来，主动猎杀玩家；
//   红标（挂在车上），会掉枪，尸体也能搜刮。
//   他们跟玩家 / 僵尸 / 幸存者 / 巡逻警全部敌对 —— 所以也会跟僵尸打起来，
//   你甚至可以坐山观虎斗。
//   节奏：感染模式开着时才派，同一时间最多一队，派过至少隔 2.5~4 分钟。
// ---------------------------------------------------------------------------
PROC SetupRaider(PED_INDEX p, BOOL isDriver)
    SET_PED_RELATIONSHIP_GROUP_HASH(p, g_rGroup)
    SET_ENTITY_MAX_HEALTH(p, 200)
    SET_ENTITY_HEALTH(p, 200)
    SET_PED_ARMOUR(p, 30)
    SET_PED_ACCURACY(p, 30)
    SET_PED_ALERTNESS(p, AS_VERY_ALERT)
    SET_PED_COMBAT_ATTRIBUTES(p, CA_ALWAYS_FIGHT, TRUE)
    SET_PED_COMBAT_ATTRIBUTES(p, CA_AGGRESSIVE, TRUE)
    SET_PED_COMBAT_ATTRIBUTES(p, CA_DO_DRIVEBYS, TRUE)   // 坐在车里也能开枪
    SET_PED_FLEE_ATTRIBUTES(p, FA_NEVER_FLEE, TRUE)
    SET_BLOCKING_OF_NON_TEMPORARY_EVENTS(p, TRUE)
    SET_PED_DROPS_WEAPONS_WHEN_DEAD(p, TRUE)
    SET_PED_SEEING_RANGE(p, 70.0)
    SET_PED_HEARING_RANGE(p, 80.0)
    SET_PED_CAN_RAGDOLL_FROM_PLAYER_IMPACT(p, FALSE)

    IF isDriver
        GIVE_WEAPON_TO_PED(p, WEAPONTYPE_PISTOL, 120, FALSE, TRUE)
        TASK_VEHICLE_CHASE(p, PLAYER_PED_ID())
    ELSE
        GIVE_WEAPON_TO_PED(p, WEAPONTYPE_SMG, 180, FALSE, TRUE)
        TASK_COMBAT_PED(p, PLAYER_PED_ID())
    ENDIF
    SET_PED_KEEP_TASK(p, TRUE)
ENDPROC

PROC CleanupRaiders()
    INT i = 0
    WHILE i < g_raiderCount
        IF DOES_ENTITY_EXIST(g_raiders[i])
            SET_PED_AS_NO_LONGER_NEEDED(g_raiders[i])
        ENDIF
        i = i + 1
    ENDWHILE
    g_raiderCount = 0
    IF DOES_BLIP_EXIST(g_raiderBlip)
        REMOVE_BLIP(g_raiderBlip)
    ENDIF
    IF g_raiderCar <> NULL
        IF DOES_ENTITY_EXIST(g_raiderCar)
            SET_VEHICLE_AS_NO_LONGER_NEEDED(g_raiderCar)
        ENDIF
        g_raiderCar = NULL
    ENDIF
ENDPROC

PROC SpawnRaiders()
    IF g_raiderCount > 0
        EXIT
    ENDIF
    IF NOT g_carReady
        EXIT
    ENDIF
    IF NOT g_rGroupOk
        EXIT
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player)
        EXIT
    ENDIF
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    FLOAT ang = GET_RANDOM_FLOAT_IN_RANGE(0.0, 360.0)
    FLOAT rad = ang * 0.01745329
    FLOAT dist = GET_RANDOM_FLOAT_IN_RANGE(90.0, 150.0)

    VECTOR spot
    spot.x = pc.x + dist * SIN(rad)
    spot.y = pc.y + dist * COS(rad)
    spot.z = pc.z + 60.0

    REQUEST_COLLISION_AT_COORD(spot)
    FLOAT gz = 0.0
    IF NOT GET_GROUND_Z_FOR_3D_COORD(spot, gz)
        EXIT
    ENDIF
    spot.z = gz + 0.5

    // v0.24：营地安全区内不派车队（用户要求"帐篷周围不刷新坏人"）
    IF InCampSafeZone(spot)
        EXIT
    ENDIF

    // 车头朝向玩家（注意：本端口的 GET_HEADING_FROM_VECTOR_2D 收两个标量，不是 VECTOR）
    FLOAT heading = GET_HEADING_FROM_VECTOR_2D(pc.x - spot.x, pc.y - spot.y)

    g_raiderCar = CREATE_VEHICLE(EMPEROR, spot, heading, TRUE, TRUE)
    IF NOT DOES_ENTITY_EXIST(g_raiderCar)
        g_raiderCar = NULL
        EXIT
    ENDIF
    SET_VEHICLE_ON_GROUND_PROPERLY(g_raiderCar)
    SET_VEHICLE_ENGINE_ON(g_raiderCar, TRUE, TRUE)
    SET_ENTITY_MAX_HEALTH(g_raiderCar, 1500)
    SET_ENTITY_HEALTH(g_raiderCar, 1500)
    SET_ENTITY_PROOFS(g_raiderCar, FALSE, FALSE, FALSE, FALSE, FALSE)
    // 门锁上：玩家不能随手把车抢走（先杀掉他们再说）
    SET_VEHICLE_DOORS_LOCKED(g_raiderCar, VEHICLELOCK_LOCKOUT_PLAYER_ONLY)

    g_raiderBlip = ADD_BLIP_FOR_ENTITY(g_raiderCar)
    SET_BLIP_COLOUR(g_raiderBlip, 1)      // 红色 = 敌意
    SET_BLIP_SCALE(g_raiderBlip, 0.9)
    SET_BLIP_AS_SHORT_RANGE(g_raiderBlip, TRUE)

    INT want = GET_RANDOM_INT_IN_RANGE(3, 5)      // 3~4 人
    INT i = 0
    WHILE i < want
        VEHICLE_SEAT seat = VS_DRIVER
        IF i = 1 seat = VS_FRONT_RIGHT ENDIF
        IF i = 2 seat = VS_BACK_LEFT ENDIF
        IF i = 3 seat = VS_BACK_RIGHT ENDIF

        MODEL_NAMES m = RandomCivilianModel()
        PED_INDEX p = CREATE_PED_INSIDE_VEHICLE(g_raiderCar, PEDTYPE_CIVMALE, m, seat, TRUE, TRUE)
        IF DOES_ENTITY_EXIST(p)
            SET_PED_RANDOM_COMPONENT_VARIATION(p)
            SetupRaider(p, (i = 0))
            g_raiders[g_raiderCount] = p
            g_raiderCount = g_raiderCount + 1
        ENDIF
        i = i + 1
    ENDWHILE

    IF g_raiderCount <= 0
        CleanupRaiders()
    ENDIF
ENDPROC

// 1Hz 维护
PROC UpdateRaiders()
    IF g_raiderCount <= 0
        IF g_raiderCar <> NULL
            CleanupRaiders()
        ENDIF
        EXIT
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)
    INT alive = 0

    INT i = 0
    WHILE i < g_raiderCount
        BOOL drop = FALSE
        PED_INDEX p = g_raiders[i]
        IF NOT DOES_ENTITY_EXIST(p)
            drop = TRUE
        ELIF IS_ENTITY_DEAD(p, FALSE)
            // 死了：记下位置给"搜刮尸体"用（枪械会掉在地上）
            RememberLoot(p, 0)
            SET_PED_AS_NO_LONGER_NEEDED(p)
            drop = TRUE
        ELIF VDIST(pc, GET_ENTITY_COORDS(p, TRUE)) > 400.0
            drop = TRUE
        ELSE
            alive = alive + 1
        ENDIF

        IF drop
            INT last = g_raiderCount - 1
            g_raiderCount = last
            g_raiders[i] = g_raiders[last]
        ELSE
            i = i + 1
        ENDIF
    ENDWHILE

    // 全灭 -> 收掉红标（车留在原地，算是战利品/掩体）
    IF alive <= 0
        IF DOES_BLIP_EXIST(g_raiderBlip)
            REMOVE_BLIP(g_raiderBlip)
        ENDIF
        g_raiderCount = 0
        // ★ v0.12：车队被清光后加一段"保底冷却"。
        //   原来只在**派遣时**推进 g_nextRaiders —— 如果玩家拖了很久才清掉，
        //   那个计时器早就过期了，于是下一 tick 立刻又开来一队。
        //   这是"出现太频繁"的**另一半根因**（不只是间隔本身短）。
        //   这里取 max 而不是直接覆盖：杀得快的时候不会因此缩短原本的间隔。
        IF g_nextRaiders < GET_GAME_TIMER() + 300000
            g_nextRaiders = GET_GAME_TIMER() + 300000
        ENDIF
    ENDIF
ENDPROC

// 打僵尸不招警察：把"最高通缉等级"压到 0（**状态设定**，只在开关变化时设一次）
PROC ApplyWantedLevel()
    INT want = 0
    IF g_infection
        want = 1
    ENDIF

    IF g_wantedMod = want
        // 已经是目标状态。但"通缉抑制"是**状态设定**，别的脚本/修改器可能改回去，
        // 所以开着的期间每 5 秒补设一次（很低频，不抢资源）。
        IF want = 1 AND GET_GAME_TIMER() >= g_nextWantedHold
            g_nextWantedHold = GET_GAME_TIMER() + 5000
            SET_MAX_WANTED_LEVEL(0)
            SET_WANTED_LEVEL_MULTIPLIER(0.0)
            SET_POLICE_IGNORE_PLAYER(PLAYER_ID(), TRUE)
        ENDIF
    ELSE
        g_wantedMod = want
        IF want = 1
            // 先把已有的星消掉，再把"能拿到的星"整体掐断：
            //   · CLEAR_PLAYER_WANTED_LEVEL  清掉当前星
            //   · SET_MAX_WANTED_LEVEL(0)    通缉上限压到 0
            //   · SET_WANTED_LEVEL_MULTIPLIER(0)  ★ 关键 —— 犯罪获得的星直接乘以 0。
            //     只压上限是不够的：在警察面前开枪属于"犯罪行为"，游戏**照样会派星**，
            //     只是被上限压住 -> 表现就是"两星闪一下就没了"（之前的做法是
            //     1 秒后才清，所以肉眼能看到那两星）。乘数设 0 才是从源头掐断。
            //   · SET_POLICE_IGNORE_PLAYER    警察彻底无视玩家（连犯罪反应都没有）
            CLEAR_PLAYER_WANTED_LEVEL(PLAYER_ID())
            SET_MAX_WANTED_LEVEL(0)
            SET_WANTED_LEVEL_MULTIPLIER(0.0)
            SET_POLICE_IGNORE_PLAYER(PLAYER_ID(), TRUE)
        ELSE
            SET_POLICE_IGNORE_PLAYER(PLAYER_ID(), FALSE)
            SET_WANTED_LEVEL_MULTIPLIER(1.0)
            SET_MAX_WANTED_LEVEL(5)
        ENDIF
    ENDIF

    // ★ 每帧兜底：万一还是有星冒出来，**同一帧**就清掉。
    //   每帧只多 1 次 native（GET_PLAYER_WANTED_LEVEL），代价可忽略；
    //   好处是再也不会出现"星闪一下"的观感（原来在 1Hz 里清，所以看得见）。
    IF want = 1
        IF GET_PLAYER_WANTED_LEVEL(PLAYER_ID()) > 0
            CLEAR_PLAYER_WANTED_LEVEL(PLAYER_ID())
        ENDIF
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 护卫招募（参考 Reborn 的 RecruitPeds：互动键招募、上限 6 人、引擎群组跟随）
//   做法：把 ped 加入玩家所在的群组（SET_PED_AS_GROUP_MEMBER）——
//   跟随/护卫/协同作战全部交给引擎 AI，我们只在 1Hz 慢循环里做维护。
//   招募对象：幸存者小队成员，或普通市民（会发一把手枪，并转成友方关系组）
// ---------------------------------------------------------------------------
// ★ 只排除"绝对不该动的人"（家人 / 剧情模型 / 玩家）。
//   这里**不能**复用 IsProtectedPed() —— 它包含 `IS_ENTITY_A_MISSION_ENTITY`
//   这一条，而我们自己的幸存者/护卫也是脚本创建的，某些情况下会被判成
//   mission entity，于是幸存者永远进不了候选名单 —— 这就是用户反馈的
//   "对着幸存者按互动键毫无反应、也没有提示"的一个根因。
FUNC BOOL IsStoryPed(PED_INDEX p)
    IF IS_PED_MODEL(p, IG_AMANDATOWNLEY) RETURN TRUE ENDIF
    IF IS_PED_MODEL(p, IG_JIMMYDISANTO) RETURN TRUE ENDIF
    IF IS_PED_MODEL(p, IG_TRACYDISANTO) RETURN TRUE ENDIF
    IF IS_PED_A_PLAYER(p) RETURN TRUE ENDIF
    RETURN FALSE
ENDFUNC

FUNC BOOL IsRecruitablePed(PED_INDEX p)
    IF NOT DOES_ENTITY_EXIST(p) RETURN FALSE ENDIF
    IF IS_PED_A_PLAYER(p) RETURN FALSE ENDIF
    IF NOT IS_PED_HUMAN(p) RETURN FALSE ENDIF
    IF IS_ENTITY_DEAD(p, FALSE) RETURN FALSE ENDIF
    IF IS_PED_IN_ANY_VEHICLE(p) RETURN FALSE ENDIF
    IF IsStoryPed(p) RETURN FALSE ENDIF
    // 僵尸模型（U_M_Y_ZOMBIE_01 / A_M_M_*）在 ped 类型上也是"人类"，
    // 不排除的话你会被提示"招募为护卫"，招过来一只僵尸 —— 很荒唐。
    IF GET_PED_RELATIONSHIP_GROUP_HASH(p) = g_zGroup RETURN FALSE ENDIF
    // 掠夺者（敌对车队）不能招募 —— 他们见到你就开枪，不是可招募对象
    IF g_rGroupOk AND GET_PED_RELATIONSHIP_GROUP_HASH(p) = g_rGroup RETURN FALSE ENDIF
    RETURN TRUE
ENDFUNC

// 把某个 ped 从"幸存者小队"名单里摘掉（招募成护卫时必须摘）
//   ★ 否则 UpdateSurvivors 还会把它当幸存者，每 4 秒给它重下"打附近的敌人"
//     任务，把群组的"跟随队长"任务顶掉 —— 又变回"走路一顿一顿"。
PROC RemoveSurvivor(PED_INDEX p)
    INT i = 0
    WHILE i < g_survivorCount
        IF g_survivors[i] = p
            IF DOES_BLIP_EXIST(g_sBlip[i])
                REMOVE_BLIP(g_sBlip[i])
            ENDIF
            INT last = g_survivorCount - 1
            g_survivorCount = last
            g_survivors[i] = g_survivors[last]
            g_sBlip[i] = g_sBlip[last]
            g_sAngryUntil[i] = g_sAngryUntil[last]
            EXIT
        ENDIF
        i = i + 1
    ENDWHILE
ENDPROC

FUNC BOOL IsAlreadyGuard(PED_INDEX p)
    INT k = 0
    WHILE k < g_guardCount
        IF g_guards[k] = p RETURN TRUE ENDIF
        k = k + 1
    ENDWHILE
    RETURN FALSE
ENDFUNC

PROC ForgetAllGuards()
    INT k = 0
    WHILE k < g_guardCount
        IF DOES_ENTITY_EXIST(g_guards[k])
            REMOVE_PED_FROM_GROUP(g_guards[k])
            REMOVE_PED_DEFENSIVE_AREA(g_guards[k], FALSE)
        ENDIF
        IF DOES_BLIP_EXIST(g_gBlip[k])
            REMOVE_BLIP(g_gBlip[k])
        ENDIF
        k = k + 1
    ENDWHILE
    g_guardCount = 0
ENDPROC

// 护卫群组：只在第一次需要时创建（问题 2 的配套）
//   原来这个群组是在菜单里切换「招募护卫」时才创建的；如果那个开关没开过，
//   g_guardGroup 就是空的，SET_PED_AS_GROUP_MEMBER 会挂到一个无效群组上，
//   护卫根本不会跟随。
PROC EnsureGuardGroup()
    IF g_groupReady
        EXIT
    ENDIF
    IF NOT DOES_ENTITY_EXIST(PLAYER_PED_ID())
        EXIT
    ENDIF
    g_guardGroup = CREATE_GROUP(DEFAULT_TASK_ALLOCATOR_FOLLOW_ANY_MEANS)
    SET_PED_AS_GROUP_LEADER(PLAYER_PED_ID(), g_guardGroup)
    // ★ 关键（学 Reborn 的 PedExtended.Recruit）：
    //   把群组"分离范围"设得极大。默认值下队员会不停重新计算站位/想拉开距离，
    //   表现出来就是"犹豫、走走停停"；设大之后他们只管跟，不再反复微调。
    //   （Reborn 用的是 float.MaxValue，这里用 100 公里，等效且安全。）
    SET_GROUP_SEPARATION_RANGE(g_guardGroup, 100000.0)
    g_groupReady = TRUE
ENDPROC

// ---------------------------------------------------------------------------
// 护卫的"跟随"任务（v0.10 新增，修"招募后定在原地一动不动"）
//
//   ★ 根因：光把 ped 挂进群组（`SET_PED_AS_GROUP_MEMBER`）是不够的。
//     群组的"分离范围"被我们设成了 100000（学 Reborn 防止队员反复微调站位），
//     引擎因此认为"队员早就在位了"，于是**不给他任何移动任务** —— 招募完他就
//     站在那儿不动。
//   ★ 正确做法：跟随由一条**长效任务**驱动（`Time = -1` 不超时），
//     交战交给关系组 + `CA_ALWAYS_FIGHT`；群组只用于"协同/共享目标"。
//     `SET_PED_KEEP_TASK` 保证打完架之后自动回到跟随（不会站着发呆）。
//   只在"入队 / 掉队太远 / 玩家复活"这些**状态变化**时下，不做周期重下。
// ---------------------------------------------------------------------------
PROC OrderGuardFollow(PED_INDEX p)
    IF NOT DOES_ENTITY_EXIST(p)
        EXIT
    ENDIF
    IF IS_ENTITY_DEAD(p, FALSE)
        EXIT
    ENDIF
    IF NOT DOES_ENTITY_EXIST(PLAYER_PED_ID())
        EXIT
    ENDIF
    // 站位：玩家右后侧 1.2m / 2.0m 处，3m 内不再调整（避免贴脸抖动）
    TASK_FOLLOW_TO_OFFSET_OF_ENTITY(p, PLAYER_PED_ID(), <<1.2, -2.0, 0.0>>, PEDMOVEBLENDRATIO_RUN, -1, 3.0, TRUE)
    SET_PED_KEEP_TASK(p, TRUE)
ENDPROC

// ---------------------------------------------------------------------------
// 护卫指令（v0.17）—— 跟随 / 留守
//
//   【为什么需要】原来的招募只有"跟随"一种行为，没法把人留在某处
//   （守家、守车、守住路口）。菜单里现在可切：
//     · 跟随：挂长效跟随任务（原有行为），交战时自己找敌人
//     · 留守：`TASK_GUARD_CURRENT_POSITION` 守住当前位置、警戒半径 10m ——
//             靠近的僵尸会自己挨打（靠敌对关系组 + CA_ALWAYS_FIGHT），
//             但**不会**被 70m 半径的 combat 任务拉走
//
//   ★ 换指令时必须把旧任务清掉再下新的，否则"跟随"和"留守"会互相顶
//     （脚本任务不会自动让位）。
//
//   ★ 光加这个函数还不够 —— `UpdateGuards` 里有两处会在下一拍推翻留守指令：
//     1) "掉队 >25m 就重挂群组 + 重下跟随任务"  -> 必须只在跟随模式跑
//     2) 交战期的"补 combat 任务"（70m 半径）  -> 留守模式要改成补留守任务
//     这两处都已在 `UpdateGuards` 里按模式分流（见那里的注释）。
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 留守行为（v0.18 重做）—— 修"留守时不打僵尸"
//
//   【为什么原来不打】`TASK_GUARD_CURRENT_POSITION` 是 `TASK_STAND_GUARD` 的
//   "带巡逻"版本，官方 PARAM NOTES 原话：
//       "Will stay within fPositionProximity metres to the given position,
//        **unless attacked**; then ped will react according to its set decision makers
//        until combat is ended, then will return to given position."
//   也就是说它是**被动**的 —— 僵尸不打他，他就不还手（只会来回巡逻，就是你看到的样子）。
//   跟随模式之所以会打，是因为那边下发的是 `TASK_COMBAT_HATED_TARGETS_AROUND_PED`（主动索敌）。
//   这与你观察到的"只有跟随的时候才会攻击僵尸"完全吻合。
//
//   【现在的做法：防御区 + 区域内主动索敌】
//     · `SET_PED_SPHERE_DEFENSIVE_AREA` —— 把作战范围钉在守卫点周围：引擎会让他
//       不追出这个圈，并在找不到掩体时回到中心。
//     · `TASK_COMBAT_HATED_TARGETS_IN_AREA(Ped, **vPosition**, Range)` ——
//       关键在于第一个坐标参数：搜索中心是**守卫点**而不是 ped 自己，所以就算他
//       边走边打，索敌范围也不会跟着漂。
//       （对比 `..._AROUND_PED` 是"以 ped 为中心 70m"，那个会让他一路追出去 —— 留守不能用。）
//
//   【重下节流】任何 `TASK_*` 重下都会把当前任务重置（这是"走路一顿一顿"的老根因），
//   所以留守任务用 `g_gHoldTick[]` 做 12 秒节流，只在"首次 / 被清过 / 看门狗到点"时重下。
// ---------------------------------------------------------------------------
PROC HoldGuardPost(INT i)
    PED_INDEX p = g_guards[i]
    VECTOR holdPos
    holdPos = g_gPost[i]

    // 全部动作都受同一个 12 秒节流约束 —— 这一条很关键：
    //   如果"离得太远就清任务"不受节流限制，ped 在往回走的路上会**每 3 秒（retask）
    //   被清一次任务**，表现就是走两步停一下。节流之后 12 秒内最多干预一次。
    IF GET_GAME_TIMER() > g_gHoldTick[i]
        g_gHoldTick[i] = GET_GAME_TIMER() + 12000

        // 真的跑野了（60m）才强清任务把他拽回来；一般情况交给防御区自己处理
        IF VDIST(GET_ENTITY_COORDS(p, TRUE), holdPos) > 60.0
            CLEAR_PED_TASKS_IMMEDIATELY(p)
        ENDIF

        SET_PED_SPHERE_DEFENSIVE_AREA(p, holdPos, GUARD_POST_RADIUS, TRUE, FALSE)
        TASK_COMBAT_HATED_TARGETS_IN_AREA(p, holdPos, GUARD_POST_RANGE)
        SET_PED_KEEP_TASK(p, TRUE)
    ENDIF
ENDPROC

// v0.18：签名从 (PED_INDEX) 改成 (INT 索引) —— 留守要读他自己的守卫点。
PROC OrderGuardTask(INT i, BOOL wantEngage)
    PED_INDEX p = g_guards[i]
    IF NOT DOES_ENTITY_EXIST(p)
        EXIT
    ENDIF
    IF IS_ENTITY_DEAD(p, FALSE)
        EXIT
    ENDIF

    IF g_gMode[i] = 1
        HoldGuardPost(i)
        EXIT
    ENDIF

    // 跟随：把留守留下的东西**彻底拆掉**
    //   ★★ 这是"切回跟随后他还会跑回留守点站着"的根因修复：
    //     `TASK_GUARD_CURRENT_POSITION(..., bSetDefensiveArea = TRUE)` 会给 ped 挂一个
    //     **防御区**（官方 PARAM NOTES 原话：the peds defensive area will be set to
    //     the position and radius of fGuardAreaRadius）。防御区是 ped AI 的**独立状态**，
    //     `CLEAR_PED_TASKS` **清不掉它** —— 于是"必须待在守点附近"这个约束会一直残留，
    //     人就会自己跑回老位置站着。必须显式 REMOVE_PED_DEFENSIVE_AREA。
    REMOVE_PED_DEFENSIVE_AREA(p, FALSE)

    IF wantEngage
        TASK_COMBAT_HATED_TARGETS_AROUND_PED(p, 70.0)
        SET_PED_KEEP_TASK(p, TRUE)
    ELSE
        OrderGuardFollow(p)
    ENDIF
ENDPROC

// 超过这个距离就把护卫从名单里摘掉（引擎会自行回收远处的普通 ped）。
//   留守模式给得宽得多：把队友留在一处、自己跑进城里搜刮，回来时他们还得在。
FUNC FLOAT GuardDropDistance(INT i)
    IF g_gMode[i] = 1
        RETURN 600.0
    ENDIF
    RETURN 200.0
ENDFUNC

// 指令变化时给全队重下（由主循环的脏标志驱动；不做周期调用）
PROC ApplyGuardMode()
    INT i = 0
    WHILE i < g_guardCount
        IF DOES_ENTITY_EXIST(g_guards[i])
            IF NOT IS_ENTITY_DEAD(g_guards[i], FALSE)
                // 全局指令 -> 落实到每一个人（之后单兵长按切换只改其中一人）
                g_gMode[i] = g_guardMode
                // 用 IMMEDIATELY 版本：普通 CLEAR_PED_TASKS 会让 ped 先把当前动作
                // 做完再切，观感上"下了指令还愣一下"
                CLEAR_PED_TASKS_IMMEDIATELY(g_guards[i])
                IF g_guardMode = 1
                    // 留守点 = **下达这一刻他站的位置**
                    g_gPost[i] = GET_ENTITY_COORDS(g_guards[i], TRUE)
                    g_gHoldTick[i] = 0                // 允许立刻下发留守任务
                ELSE
                    REMOVE_PED_DEFENSIVE_AREA(g_guards[i], FALSE)
                ENDIF
                OrderGuardTask(i, FALSE)
            ENDIF
        ENDIF
        i = i + 1
    ENDWHILE

    // 给个短提示（不常驻）
    g_specialUntil = GET_GAME_TIMER() + 4000
    IF g_guardMode = 1
        g_specialMsg = "护卫指令：留守原地"
    ELSE
        g_specialMsg = "护卫指令：跟随"
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 单人切换指令（v0.18 引入，v0.21 换键）—— 十字键**左**切换"我面前这个护卫"
//
//   【为什么从"十字键下长按"换成"十字键左短按"】
//     实机反馈：按住十字键下**没有反应**。十字键下在本作里是**角色切换轮盘**
//     （按住弹出换人界面），原生逻辑会把这个输入吃掉，所以我们那种"按住满 700ms
//     再触发"的写法永远等不到条件成立。
//     十字键左**没有原生绑定**，可以直接读"按下"这一瞬间 —— 响应更快，也不再有
//     上述冲突。（换人轮盘用的是十字键下，两者互不干扰。）
//
//   【读取方式：四个通道全读】
//     本项目里"十字键右"用作互动键时的写法是
//     `IS_CONTROL_JUST_PRESSED(FRONTEND_CONTROL, INPUT_FRONTEND_RIGHT)`（**没被禁用**，
//     实测可用）。所以这里也以 FRONTEND 组为主，同时把 PLAYER 组和
//     "被禁用"变体一并读上 —— 端口的按键映射无法离线验证，四通道覆盖最保险，
//     代价只是 6 次 native/帧（有护卫时才执行）。
//
//   【为什么不 DISABLE 这个 action】不吃掉它就没有副作用；十字键左本来也没有
//     重要原生功能，万一端口给它绑了什么，也只会"多触发一次"而不会失灵。
//
//   【为什么只在菜单关闭时做】菜单打开时十字键左是"改档位"（那边会 DISABLE
//   这个 action 再用 IS_DISABLED_CONTROL_* 读），两个用途不能同时生效。
// ---------------------------------------------------------------------------
PROC ToggleNearbyGuardMode()
    IF g_guardCount <= 0
        EXIT
    ENDIF
    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    // 找 6m 内最近的护卫（比"解除护卫"的 1.5m 宽松：不用贴脸操作）
    INT best = -1
    FLOAT bestD = 6.0
    INT i = 0
    WHILE i < g_guardCount
        IF DOES_ENTITY_EXIST(g_guards[i])
            FLOAT d = VDIST(pc, GET_ENTITY_COORDS(g_guards[i], TRUE))
            IF d < bestD
                bestD = d
                best = i
            ENDIF
        ENDIF
        i = i + 1
    ENDWHILE

    // 附近没人：静默返回（按错键不该弹提示打扰）
    IF best < 0
        EXIT
    ENDIF
    g_specialUntil = GET_GAME_TIMER() + 4000

    CLEAR_PED_TASKS_IMMEDIATELY(g_guards[best])
    IF g_gMode[best] = 1
        // 留守 -> 跟随
        g_gMode[best] = 0
        REMOVE_PED_DEFENSIVE_AREA(g_guards[best], FALSE)
        g_specialMsg = "这名护卫：跟随"
    ELSE
        // 跟随 -> 留守（守点 = 他现在站的位置）
        g_gMode[best] = 1
        g_gPost[best] = GET_ENTITY_COORDS(g_guards[best], TRUE)
        g_gHoldTick[best] = 0
        g_specialMsg = "这名护卫：留守原地"
    ENDIF
    OrderGuardTask(best, FALSE)
ENDPROC

// 十字键左：切换"我面前这个护卫"的指令（每帧调用；没有护卫时直接退出，代价 0）
PROC CheckGuardHotkey()
    IF g_guardCount <= 0
        EXIT
    ENDIF
    IF g_menuOpen
        EXIT
    ENDIF

    // 四通道读"刚按下"：FRONTEND 组（与互动键同一读法，已验证可用）+ PLAYER 组
    //   + 各自的"被禁用"变体（万一端口把它算进了被禁用的那一类）。任一命中即可。
    BOOL hit = FALSE
    IF IS_CONTROL_JUST_PRESSED(FRONTEND_CONTROL, INPUT_FRONTEND_LEFT)
        hit = TRUE
    ELIF IS_CONTROL_JUST_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_LEFT)
        hit = TRUE
    ELIF IS_DISABLED_CONTROL_JUST_PRESSED(FRONTEND_CONTROL, INPUT_FRONTEND_LEFT)
        hit = TRUE
    ELIF IS_DISABLED_CONTROL_JUST_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_LEFT)
        hit = TRUE
    ENDIF

    // 兜底：如果"刚按下"这个边沿在端口上读不到（例如它被并进了长按型输入），
    //   那么"按住 0.4 秒"也一样触发 —— 保证这个键**一定**能用。
    IF NOT hit
        IF IS_CONTROL_PRESSED(FRONTEND_CONTROL, INPUT_FRONTEND_LEFT)
        OR IS_CONTROL_PRESSED(PLAYER_CONTROL, INPUT_FRONTEND_LEFT)
            IF GET_GAME_TIMER() > g_guardKeyNext
                g_guardKeyNext = GET_GAME_TIMER() + GUARD_KEY_DEBOUNCE
                hit = TRUE
            ENDIF
        ENDIF
    ENDIF

    IF hit
        IF GET_GAME_TIMER() > g_guardKeyNext
            g_guardKeyNext = GET_GAME_TIMER() + GUARD_KEY_DEBOUNCE
            ToggleNearbyGuardMode()
        ENDIF
    ENDIF
ENDPROC

// 把某个 ped 身上的"幸存者蓝点"摘下来（不删除，交给 g_tmpBlip）
PROC DetachSurvivorBlip(PED_INDEX p)
    g_tmpBlip = NULL
    INT i = 0
    INT n = g_survivorCount
    WHILE i < n
        IF g_survivors[i] = p
            g_tmpBlip = g_sBlip[i]
            g_sBlip[i] = NULL
            i = n                     // 找到就跳出循环（PROC 里不能用裸 RETURN）
        ELSE
            i = i + 1
        ENDIF
    ENDWHILE
ENDPROC

// 招募结果提示（整队招募时显示"小队"）—— 字符串不能和数字拼接，所以在这里分支
PROC SetRecruitMsg(INT made)
    g_specialUntil = GET_GAME_TIMER() + 4000
    IF made <= 0
        g_specialMsg = "附近没有可招募的人"
    ELIF made = 1
        g_specialMsg = "已招募一名护卫"
    ELSE
        g_specialMsg = "已招募一支护卫小队"
    ENDIF
ENDPROC

PROC AddGuard(PED_INDEX p)
    IF g_guardCount >= MAX_SURVIVORS
        EXIT
    ENDIF
    IF IsAlreadyGuard(p)
        EXIT
    ENDIF

    EnsureGuardGroup()

    // ★ 先把旧任务/旧群组清干净（学 Reborn：LeaveGroup + Task.ClearAll）。
    //   否则他身上残留的任务会和"跟随"打架，一入队就开始抖。
    REMOVE_PED_FROM_GROUP(p)
    CLEAR_PED_TASKS(p)

    // 转成友方关系组（这样不会被僵尸以外的人误伤，也不会打玩家）
    SET_PED_RELATIONSHIP_GROUP_HASH(p, g_sGroup)
    SET_PED_AS_GROUP_MEMBER(p, g_guardGroup)
    SET_PED_NEVER_LEAVES_GROUP(p, TRUE)
    SET_PED_CAN_BE_TARGETTED(p, TRUE)
    SET_PED_ACCURACY(p, 50)
    SET_PED_ALERTNESS(p, AS_VERY_ALERT)
    SET_PED_COMBAT_ATTRIBUTES(p, CA_ALWAYS_FIGHT, TRUE)
    SET_PED_COMBAT_ATTRIBUTES(p, CA_AGGRESSIVE, TRUE)
    SET_PED_FLEE_ATTRIBUTES(p, FA_NEVER_FLEE, TRUE)
    // 战斗属性：会主动推进、在中距离（7~30m）交火、水平中等
    //   （不设的话默认"原地防御"，看起来就是"站着不帮忙"）
    SET_PED_COMBAT_MOVEMENT(p, CM_WILLADVANCE)
    SET_PED_COMBAT_RANGE(p, CR_MEDIUM)
    SET_PED_COMBAT_ABILITY(p, CAL_AVERAGE)
    SET_BLOCKING_OF_NON_TEMPORARY_EVENTS(p, TRUE)
    // 感知范围放大 —— 这样"看到僵尸就自己开打"靠引擎完成，不需要我们每秒下任务
    SET_PED_SEEING_RANGE(p, 60.0)
    SET_PED_HEARING_RANGE(p, 80.0)
    SET_ENTITY_MAX_HEALTH(p, 250)
    SET_ENTITY_HEALTH(p, 250)
    SET_PED_ARMOUR(p, 50)
    IF NOT IS_PED_ARMED(p, 7)
        GIVE_WEAPON_TO_PED(p, WEAPONTYPE_PISTOL, 200, FALSE, TRUE)
    ENDIF
    SET_PED_DROPS_WEAPONS_WHEN_DEAD(p, TRUE)
    // 不被撞倒/不因碰撞进 ragdoll —— 跟着你跑的时候少摔跤
    SET_PED_CAN_RAGDOLL_FROM_PLAYER_IMPACT(p, FALSE)
    SET_PED_RAGDOLL_ON_COLLISION(p, FALSE)
    // 注意：这里**不再**下发 TASK_COMBAT_HATED_TARGETS_AROUND_PED。
    //   跟随交给群组 AI，交战交给关系组 + CA_ALWAYS_FIGHT —— 两者都不需要
    //   我们反复下任务，这正是"走路一顿一顿"的根源（详见 UpdateGuards）。

    // 如果他本来是幸存者小队成员 -> 把蓝点接过来，再从名单摘掉
    //   （摘名单是必须的：否则幸存者维护循环每 4 秒还会给他重下"打附近的敌人"
    //     任务，把跟随任务顶掉 —— 那就是以前的"走路一顿一顿"）
    DetachSurvivorBlip(p)
    RemoveSurvivor(p)

    // ★ v0.10：招募后地图上**保留蓝点**（原来这里把人摘走了、蓝点也删了，
    //   结果"招募完就找不到队友了"）。普通 NPC 被招募时新给他建一个。
    IF NOT DOES_BLIP_EXIST(g_tmpBlip)
        g_tmpBlip = ADD_BLIP_FOR_ENTITY(p)
    ENDIF
    SET_BLIP_COLOUR(g_tmpBlip, 3)
    SET_BLIP_SCALE(g_tmpBlip, 0.7)
    SET_BLIP_AS_SHORT_RANGE(g_tmpBlip, TRUE)
    g_gBlip[g_guardCount] = g_tmpBlip

    g_guards[g_guardCount] = p
    // v0.18：新护卫继承**当前**指令；留守的话守点就是他加入时站的位置
    g_gMode[g_guardCount] = g_guardMode
    g_gPost[g_guardCount] = GET_ENTITY_COORDS(p, TRUE)
    g_gHoldTick[g_guardCount] = 0
    g_guardCount = g_guardCount + 1

    // ★ 按**当前指令**下任务（跟随 / 留守）——
    //   修"定在原地一动不动"（原来只挂群组不给任务 = 站着不动）
    OrderGuardTask(g_guardCount - 1, FALSE)

    SetRecruitMsg(1)
ENDPROC

// ---------------------------------------------------------------------------
// 整队招募（v0.11）—— 采纳用户建议："一次性招募就招募整个幸存者小队"
//   它同时解决两件事：
//     · 几个人聚在一起时不用挨个按（一次把附近的人都收编）；
//     · 不会出现"招了一个之后，剩下的都被那个人的互动判定挡住"。
//   范围：自己的幸存者小队 6m 内、附近普通市民 3.5m 内。
//   ★ 先把候选人**收集到本地数组**再动手 —— AddGuard 内部会 swap-remove 幸存者
//     名单，边遍历边改会漏人（这类坑踩过一次）。
// ---------------------------------------------------------------------------
PROC RecruitSquad(PED_INDEX first)
    PED_INDEX cand[12]
    INT nc = 0

    IF IsRecruitablePed(first) AND NOT IsAlreadyGuard(first)
        cand[0] = first
        nc = 1
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    // (1) 自己的幸存者小队（优先，范围给宽一点：他们本来就是一起行动的）
    INT i = 0
    WHILE i < g_survivorCount AND nc < 12
        PED_INDEX sv = g_survivors[i]
        IF IsRecruitablePed(sv) AND NOT IsAlreadyGuard(sv)
            IF VDIST(pc, GET_ENTITY_COORDS(sv, TRUE)) < 6.0
                cand[nc] = sv
                nc = nc + 1
            ENDIF
        ENDIF
        i = i + 1
    ENDWHILE

    // (2) 附近的普通市民（3.5m 内，别把整条街都收编）
    PED_INDEX found[16]
    INT n = GET_PED_NEARBY_PEDS(player, found, PEDTYPE_INVALID)
    INT j = 0
    WHILE j < n AND nc < 12
        PED_INDEX p = found[j]
        IF IsRecruitablePed(p) AND NOT IsAlreadyGuard(p)
            IF VDIST(pc, GET_ENTITY_COORDS(p, TRUE)) < 3.5
                // 去重（可能已经在幸存者名单里出现过）
                BOOL dup = FALSE
                INT q = 0
                WHILE q < nc
                    IF cand[q] = p dup = TRUE ENDIF
                    q = q + 1
                ENDWHILE
                IF NOT dup
                    cand[nc] = p
                    nc = nc + 1
                ENDIF
            ENDIF
        ENDIF
        j = j + 1
    ENDWHILE

    INT m = 0
    INT made = 0
    WHILE m < nc AND g_guardCount < MAX_SURVIVORS
        AddGuard(cand[m])
        made = made + 1
        m = m + 1
    ENDWHILE

    SetRecruitMsg(made)
ENDPROC

// 解除护卫 —— v0.10 重写：必须**还原成可再招募的幸存者小队成员**（带蓝点），
//   而不是像以前那样"退化成满街乱走的普通 NPC"（用户反馈：解除后状态无法恢复、
//   人自己走开了、蓝点也没了、想再招还得重新找）。
PROC DismissGuard(PED_INDEX p)
    INT k = 0
    WHILE k < g_guardCount
        IF g_guards[k] = p
            // 先把他那条蓝点取出来（下面要交还给幸存者名单）
            BLIP_INDEX b = g_gBlip[k]

            INT last = g_guardCount - 1
            g_guardCount = last
            g_guards[k] = g_guards[last]
            g_gBlip[k] = g_gBlip[last]
            g_gMode[k] = g_gMode[last]
            g_gPost[k] = g_gPost[last]
            g_gHoldTick[k] = g_gHoldTick[last]

            IF DOES_ENTITY_EXIST(p) AND NOT IS_ENTITY_DEAD(p, FALSE)
                REMOVE_PED_FROM_GROUP(p)
                CLEAR_PED_TASKS_IMMEDIATELY(p)
                // ★ 解雇时也要拆防御区 —— 否则他会一直守在"离职前那个点"，
                //   回到幸存者小队之后还赖在原地不动
                REMOVE_PED_DEFENSIVE_AREA(p, FALSE)
                // 还原关系组（和 SetupRelations 里一致：对玩家尊重、对僵尸敌对）
                SET_PED_RELATIONSHIP_GROUP_HASH(p, g_sGroup)

                IF g_survivorCount < MAX_SURVIVORS
                    // 回到幸存者小队：名单 + 蓝点 + 继续打僵尸 = 可以再次被招募
                    IF NOT DOES_BLIP_EXIST(b)
                        b = ADD_BLIP_FOR_ENTITY(p)
                    ENDIF
                    SET_BLIP_COLOUR(b, 3)          // 蓝点
                    SET_BLIP_SCALE(b, 0.7)
                    SET_BLIP_AS_SHORT_RANGE(b, TRUE)
                    g_survivors[g_survivorCount] = p
                    g_sBlip[g_survivorCount] = b
                    g_sAngryUntil[g_survivorCount] = 0
                    g_survivorCount = g_survivorCount + 1
                    TASK_COMBAT_HATED_TARGETS_AROUND_PED(p, 70.0)
                    SET_PED_KEEP_TASK(p, TRUE)
                    g_specialMsg = "已解除护卫 - 他回到了幸存者小队"
                ELSE
                    // 幸存者名单满了：只解除关系，不做小队管理（蓝点收掉）
                    IF DOES_BLIP_EXIST(b)
                        REMOVE_BLIP(b)
                    ENDIF
                    TASK_WANDER_STANDARD(p)
                    SET_PED_KEEP_TASK(p, TRUE)
                    g_specialMsg = "已解除该护卫"
                ENDIF
            ELSE
                IF DOES_BLIP_EXIST(b)
                    REMOVE_BLIP(b)
                ENDIF
            ENDIF

            g_specialUntil = GET_GAME_TIMER() + 4000
            EXIT
        ENDIF
        k = k + 1
    ENDWHILE
ENDPROC

// 1Hz 维护
PROC UpdateGuards()
    IF g_guardCount <= 0
        EXIT
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    // ★ v0.11：让护卫真的会打仗（用户反馈：招募后只会跟着我，僵尸咬我也不管）。
    //   根因：护卫的主任务是"跟随"（TASK_FOLLOW_...），而引擎**不会**用战斗去
    //   打断这条任务 —— 所以他们的行为就固定在"跟班"上了。
    //   做法：按"附近有没有僵尸"在两个阶段之间切换，**只在阶段变化时**重下任务：
    //     · 跟随阶段 -> `OrderGuardFollow`（长效跟随任务）
    //     · 交战阶段 -> `TASK_COMBAT_HATED_TARGETS_AROUND_PED`（自己找附近的僵尸打）
    //   带滞回（45m 进入 / 70m 退出），避免边界来回抖动。
    //   成本：1Hz 里最多 32 次"取坐标 + 内建 VDIST"，可忽略。
    FLOAT nearZ = 9999.0
    INT zi = 0
    WHILE zi < g_zombieCount
        IF DOES_ENTITY_EXIST(g_zombies[zi])
            FLOAT dz2 = VDIST(pc, GET_ENTITY_COORDS(g_zombies[zi], TRUE))
            IF dz2 < nearZ
                nearZ = dz2
            ENDIF
        ENDIF
        zi = zi + 1
    ENDWHILE

    IF g_guardFight = 0
        IF nearZ < 45.0 g_guardFight = 1 ENDIF
    ELSE
        IF nearZ > 70.0 g_guardFight = 0 ENDIF
    ENDIF

    // 阶段变化 = 事件：这时候才给全队重下任务（不做周期重下）
    IF g_guardFight <> g_prevGuardFight
        g_prevGuardFight = g_guardFight
        INT t = 0
        WHILE t < g_guardCount
            IF DOES_ENTITY_EXIST(g_guards[t]) AND NOT IS_ENTITY_DEAD(g_guards[t], FALSE)
                // ★ v0.17：统一走 OrderGuardTask —— 它按"当前指令"决定跟随还是留守；
                //   留守模式下它会忽略 wantEngage，守住位置不动。
                OrderGuardTask(t, (g_guardFight = 1))
            ENDIF
            t = t + 1
        ENDWHILE
    ENDIF

    // 交战阶段：定期给"没在打架"的护卫补一次任务（3 秒一次，属于状态恢复，
    //   不是轮询下发 —— 打完了自己会回到这条任务上）
    IF g_guardFight = 1 AND GET_GAME_TIMER() > g_nextGuardRetask
        g_nextGuardRetask = GET_GAME_TIMER() + 3000
        INT t2 = 0
        WHILE t2 < g_guardCount
            IF DOES_ENTITY_EXIST(g_guards[t2]) AND NOT IS_ENTITY_DEAD(g_guards[t2], FALSE)
                IF NOT IS_PED_IN_COMBAT(g_guards[t2])
                    // 跟随模式 -> 补 combat（打完自动回到跟随任务）；
                    // 留守模式 -> OrderGuardTask 内部会改补留守任务，
                    //   否则他们会追着 70m 外的敌人跑掉，留守形同虚设。
                    OrderGuardTask(t2, TRUE)
                ENDIF
            ENDIF
            t2 = t2 + 1
        ENDWHILE
    ENDIF

    INT k = 0
    WHILE k < g_guardCount
        BOOL drop = FALSE
        PED_INDEX g = g_guards[k]
        IF NOT DOES_ENTITY_EXIST(g)
            drop = TRUE
        ELIF IS_ENTITY_DEAD(g, FALSE)
            drop = TRUE
        ELIF GET_PED_RELATIONSHIP_GROUP_HASH(g) = g_zGroup
            // 真的被同化成僵尸了 -> 释放引用（v0.9 起自己人已不会被同化，
            //   这里只是保险）
            drop = TRUE
        ELIF GET_PED_RELATIONSHIP_GROUP_HASH(g) <> g_sGroup
            // ★ 只是关系组被别的脚本改掉了 -> **纠正回来**，不要因为一句
            //   "组不一致"就把一个活着的护卫从名单里丢掉（那会让他既不跟随、
            //   也不再受我们管理）。
            SET_PED_RELATIONSHIP_GROUP_HASH(g, g_sGroup)
            IF g_groupReady
                SET_PED_AS_GROUP_MEMBER(g, g_guardGroup)
                SET_PED_NEVER_LEAVES_GROUP(g, TRUE)
            ENDIF
        ELIF VDIST(pc, GET_ENTITY_COORDS(g, TRUE)) > GuardDropDistance(k)
            REMOVE_PED_FROM_GROUP(g)
            drop = TRUE
        ELSE
            // ★★ 这就是"NPC 在是否跟随之间反复犹豫、走路一顿一顿"的根因。
            //   原来这里每秒重下一次 TASK_COMBAT_HATED_TARGETS_AROUND_PED，
            //   它会把"跟随队长"的任务顶掉 —— 护卫于是在"跟随"和"找敌人"
            //   之间每秒来回切换，一走一停。
            //   为什么开了僵尸模式反而不抖？因为那时他们一直在战斗，
            //   IS_PED_IN_COMBAT 为真，这段根本不执行 —— 与你的观察完全吻合。
            //   现在：跟随交给引擎群组 AI，交战交给敌对关系组 + CA_ALWAYS_FIGHT，
            //   我们只在"掉队太远"时把他们重新挂回群组（低频、幂等）。
            // ★★ v0.17：**只在跟随模式**做掉队归队 —— 留守模式下把人拽回来
            //    等于把你刚下的"留守"指令当场推翻（1 秒后就被撤销）。
            IF g_gMode[k] = 0 AND g_guardFight = 0 AND g_groupReady AND NOT IS_PED_IN_COMBAT(g)
                // 掉队超过 25m 才管（而且 5 秒最多重下一次任务 ——
                // 跟随本身由 OrderGuardFollow 下发的长效任务负责，这里是兜底）
                // ★ 交战阶段不走这条：那会儿他们要留在原地打，而不是被拽回来。
                IF VDIST(pc, GET_ENTITY_COORDS(g, TRUE)) > 25.0
                    SET_PED_AS_GROUP_MEMBER(g, g_guardGroup)
                    SET_PED_NEVER_LEAVES_GROUP(g, TRUE)
                    IF GET_GAME_TIMER() > g_nextGuardFollow
                        g_nextGuardFollow = GET_GAME_TIMER() + 5000
                        OrderGuardFollow(g)
                    ENDIF
                ENDIF
            ENDIF
        ENDIF

        IF drop
            IF DOES_BLIP_EXIST(g_gBlip[k])
                REMOVE_BLIP(g_gBlip[k])
            ENDIF
            INT last = g_guardCount - 1
            g_guardCount = last
            g_guards[k] = g_guards[last]
            g_gBlip[k] = g_gBlip[last]
            g_gMode[k] = g_gMode[last]
            g_gPost[k] = g_gPost[last]
            g_gHoldTick[k] = g_gHoldTick[last]
        ELSE
            k = k + 1
        ENDIF
    ENDWHILE
ENDPROC

// ---------------------------------------------------------------------------
// 死亡 -> 医院复活（问题 3 / 4 / 5）
//
//   ★ 问题根因：整个感染系统（进度、咬伤数、危急/终末计时、症状计时）都是
//     脚本全局变量，**没有任何"玩家死了"的复位逻辑**。
//     被僵尸打死 -> 医院复活 -> 这些值原样保留：
//       · 复活后立刻带着上一局的感染度（你看到的"84%"就是死前进到危急时被
//         夹到的 0.85 档）
//       · 症状计时还在跑 -> 复活不久就"无故摔倒"（那其实还是上一局的感染症状）
//   检测方式有两重，都能覆盖：
//     a) 玩家 ped 换了一个（医院复活 = 新 ped）
//     b) 观察到"上一帧是死的、这一帧活了"（同 ped 复活）
//   复位动作：感染清零 + 收走解药箱 + 重建护卫群组（旧群组的队长 ped 已经没了）
// ---------------------------------------------------------------------------
// 感染清零（死亡复活 / 修改器开无敌 两处共用）
PROC ResetInfection()
    g_infProgress = 0.0
    g_infBites = 0
    g_infSymNext = 0
    ClearAntidoteCrate()
ENDPROC

PROC OnPlayerRespawn()
    ResetInfection()

    // v0.15：生存指标一并回满（和感染复位同一时机）
    //   v0.24：体力已删除，这里只剩饥饿/口渴
    g_food = 100.0
    g_water = 100.0
    g_nextStarve = 0

    // 复活后玩家是个新 ped，旧群组作废 —— 重建，并让还在附近的护卫归队
    g_groupReady = FALSE
    IF g_guardCount > 0
        EnsureGuardGroup()
        PED_INDEX np = PLAYER_PED_ID()
        VECTOR npc = GET_ENTITY_COORDS(np, TRUE)
        INT k = 0
        WHILE k < g_guardCount
            IF DOES_ENTITY_EXIST(g_guards[k])
                IF VDIST(npc, GET_ENTITY_COORDS(g_guards[k], TRUE)) < 80.0
                    SET_PED_AS_GROUP_MEMBER(g_guards[k], g_guardGroup)
                    SET_PED_NEVER_LEAVES_GROUP(g_guards[k], TRUE)
                    OrderGuardTask(k, FALSE)
                ENDIF
            ENDIF
            k = k + 1
        ENDWHILE
    ENDIF
ENDPROC

// 每帧调用（2 次 native，可忽略）
PROC CheckPlayerRespawn()
    PED_INDEX p = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(p)
        EXIT
    ENDIF
    BOOL dead = IS_ENTITY_DEAD(p, FALSE)
    BOOL newPed = (p <> g_lastPlayerPed)
    // 首次运行（g_lastPlayerPed 还是 NULL）也算一次，正好把初始状态摆正
    IF (g_playerWasDead AND NOT dead) OR newPed
        OnPlayerRespawn()
    ENDIF
    g_playerWasDead = dead
    g_lastPlayerPed = p
ENDPROC

// ---------------------------------------------------------------------------
// 互动（招募 / 解雇 / 搜刮）—— v0.8 重构
//
//   用户反馈两个问题：
//     a) 僵尸模式关着时，普通 NPC 也弹招募提示（不想要）
//     b) 僵尸模式/幸存者模式开着时，反而招不了幸存者、也没有提示
//   原因（b）很实际：解药箱和"搜刮尸体"都会抢同一个互动键，
//   而它们原先在链条里排在招募前面 —— 站在幸存者旁边（附近常有尸体）
//   按下去就被"搜刮"吃掉了，招募当然没反应。
//   现在改成**统一的仲裁**：把三个候选（护卫/招募对象/尸体）都算出来，
//   谁离得近谁拿这次按键和提示，规则单一、可预期。
//
//   另外按用户要求加模式门槛：**只有"僵尸模式"或"幸存者小队"开着时才提供招募**。
// ---------------------------------------------------------------------------
// 招募是否可用：僵尸模式 或 幸存者小队 开着才算
FUNC BOOL RecruitEnabled()
    IF g_infection RETURN TRUE ENDIF
    IF g_survivorsOn RETURN TRUE ENDIF
    RETURN FALSE
ENDFUNC

// 扫描最近的招募候选（含"已有护卫 -> 解雇"）
PROC ScanRecruitCandidate()
    g_candPed = NULL
    g_candKind = 0
    IF NOT RecruitEnabled()
        EXIT
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    // ★ v0.11：范围大幅收紧（用户反馈"招募判定范围太大"）。
    //   原来是"幸存者 12m 就能招募、护卫 4m 就能解雇"，于是：
    //     · 几个幸存者聚在一起时，你只能锁到最近的那一个；
    //     · 而最近的那个往往就是**已经招募、正跟着你**的护卫 ->
    //       提示只剩"解除护卫"，剩下的幸存者根本招不了。
    //   现在改成：**站到人跟前（2.5m）才有互动**，而且先看"还有没有没招募的人"，
    //   有就先招募（而且是整队招募，见 RecruitSquad）；只有身边没有可招募的人时，
    //   这一次按键才让给"解除护卫"。这样已招募的队友永远不会挡住招人。
    IF g_guardCount < MAX_SURVIVORS
        FLOAT best = 2.5
        INT s2 = 0
        WHILE s2 < g_survivorCount
            PED_INDEX sv = g_survivors[s2]
            IF IsRecruitablePed(sv)
            AND NOT IsAlreadyGuard(sv)
                FLOAT d = VDIST(pc, GET_ENTITY_COORDS(sv, TRUE))
                IF d < best
                    best = d
                    g_candPed = sv
                    g_candKind = 2
                ENDIF
            ENDIF
            s2 = s2 + 1
        ENDWHILE

    PED_INDEX found[16]
    INT n = GET_PED_NEARBY_PEDS(player, found, PEDTYPE_INVALID)
    INT j = 0
    WHILE j < n AND g_guardCount < MAX_SURVIVORS
        PED_INDEX p = found[j]
        IF IsRecruitablePed(p)
        AND NOT IsAlreadyGuard(p)
            FLOAT d = VDIST(pc, GET_ENTITY_COORDS(p, TRUE))
            IF d < 2.5 AND d < best
                best = d
                g_candPed = p
                g_candKind = 2
            ENDIF
        ENDIF
        j = j + 1
    ENDWHILE
    ENDIF

    // (2) 身边没有可招募的人 -> 才把这次互动让给"解除护卫"
    //   ★ 半径给到 1.5m，**故意比"跟随站位距离"（右后 2.33m）更小**：
    //     否则你带着队友走路时，提示会一直停在"解除这名护卫"上，
    //     手一抖就把队友踢了。要解雇得走到他鼻子底下。
    IF g_candKind = 0
        FLOAT bestD = 1.5
        INT k = 0
        WHILE k < g_guardCount
            IF DOES_ENTITY_EXIST(g_guards[k])
                FLOAT d = VDIST(pc, GET_ENTITY_COORDS(g_guards[k], TRUE))
                IF d < bestD
                    bestD = d
                    g_candPed = g_guards[k]
                    g_candKind = 1
                ENDIF
            ENDIF
            k = k + 1
        ENDWHILE
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 载具维修（v0.21 新增）—— 徒手敲车修车
//
//   【为什么加这个】v0.11 起僵尸能把车砸出**真实的凹陷/碎窗**（SET_VEHICLE_DAMAGE），
//   但玩家**没有任何修复手段** —— 车只会越来越破，最终变成路边废铁。
//   这个功能把那个循环闭上：站到车边按互动键 -> 蹲下去敲一下 -> 凹陷消失、车况回升。
//   参考 Reborn 的 `VehicleRepair`（它要求"修理包"道具；我们没有背包系统，
//   所以做成徒手敲 —— 也符合末日里东拼西凑的调性）。
//
//   【为什么敲一下要等 0.7 秒才结算】本项目的设计原则：**结果不在按下的同一瞬间发生**，
//   否则玩家看不到任何动作。这里让动画先播到"接触"那一刻，再由 `RepairTick` 结算；
//   中途走开/上车也不会出问题（结算时会重新检查车还在不在）。
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 报废车辆系统（v0.22 新增）
//
//   【为什么做这个】用户要的是"更有末日生存的感觉，而不是一直打僵尸"。
//   于是路上的破车变成**目标**：想开就得先修，而修车材料（汽车零件）只能从
//   僵尸尸体上搜出来 —— "打僵尸"从此只是手段，不是目的。
//
//   【怎么保证"开不了"】用官方的 `SET_VEHICLE_UNDRIVEABLE` ——
//   官方注释写得很清楚："Sets the vehicle to be undriveable **(but still enterable)**"，
//   也就是**能进、能坐，就是开不走**（R* 自己在 re_crashrescue / Towing 里就用它
//   标记事故车和故障车）。发动机健康设 -400（官方 re_crashrescue 同款数值），
//   同时 `SET_ENTITY_PROOFS(..., fireProof = TRUE, ...)` 防自燃 ——
//   不防火的话发动机为负会烧起来，而"烧掉的车"会直接消失，报废车就没了。
//
//   【刷在哪】不随机撒点，而是**吸附到最近的车行节点**上（`GET_CLOSEST_VEHICLE_NODE`）——
//   车行节点只存在于街道 / 车道 / 车库通道，因此天然满足"在路上 + 地面层 + 不在室内"。
//   再叠加视野否决（别在玩家眼前冒出来）和"别和已有报废车挤一起"。
// ---------------------------------------------------------------------------
FUNC MODEL_NAMES RandomWreckModel()
    INT r = GET_RANDOM_INT_IN_RANGE(0, 100)
    IF r < 30 RETURN EMPEROR ENDIF        // 轿车（和掠夺者车队同款，资源已加载）
    IF r < 55 RETURN ASEA ENDIF           // 家用轿车
    IF r < 78 RETURN PREMIER ENDIF        // 轿车（出租车同族）
    RETURN RUMPO                          // 面包车（末日里的"逃难车"）
ENDFUNC

// 这辆车是不是"我们放的报废车"（还没修好的）
FUNC BOOL IsWreck(VEHICLE_INDEX v)
    IF NOT DOES_ENTITY_EXIST(v)
        RETURN FALSE
    ENDIF
    INT k = 0
    WHILE k < g_wreckCount
        IF g_wrecks[k] = v
            RETURN TRUE
        ENDIF
        k = k + 1
    ENDWHILE
    RETURN FALSE
ENDFUNC

// 把一辆车做成报废状态（视觉上"一看就是废车"，功能上"开不走"）
PROC MakeWreck(VEHICLE_INDEX v)
    IF NOT DOES_ENTITY_EXIST(v)
        EXIT
    ENDIF

    // (1) 轮胎：两只爆掉 —— 最直观的"趴窝"（车会歪着坐在地上）
    SET_VEHICLE_TYRE_BURST(v, SC_WHEEL_CAR_FRONT_LEFT, TRUE, 1000.0)
    SET_VEHICLE_TYRE_BURST(v, SC_WHEEL_CAR_REAR_RIGHT, TRUE, 1000.0)

    // (2) 玻璃：侧窗砸碎 + 前风挡掀掉（官方 re_crashrescue.sc 的做法）
    SMASH_VEHICLE_WINDOW(v, SC_WINDOW_FRONT_LEFT)
    SMASH_VEHICLE_WINDOW(v, SC_WINDOW_REAR_LEFT)
    POP_OUT_VEHICLE_WINDSCREEN(v)

    // (3) 车身凹陷/掉漆（同样照官方：只有 SET_VEHICLE_DAMAGE 会产生形变）
    VECTOR hitF = GET_OFFSET_FROM_ENTITY_IN_WORLD_COORDS(v, <<0.0, 1.6, 0.4>>)
    VECTOR hitR = GET_OFFSET_FROM_ENTITY_IN_WORLD_COORDS(v, <<0.0, -1.6, 0.4>>)
    SET_VEHICLE_DAMAGE(v, hitF, 400.0, 600.0, FALSE)
    SET_VEHICLE_DAMAGE(v, hitR, 400.0, 600.0, FALSE)

    SET_VEHICLE_DIRT_LEVEL(v, 12.0)
    SET_VEHICLE_ENGINE_ON(v, FALSE, FALSE)
    SET_VEHICLE_LIGHTS(v, FORCE_VEHICLE_LIGHTS_OFF)

    // (4) 关键两行：发动机报废 + 不可驾驶（能进能坐，就是开不走）
    SET_VEHICLE_ENGINE_HEALTH(v, -400.0)
    SET_VEHICLE_UNDRIVEABLE(v, TRUE)

    // (5) 防火 + 漏油：发动机健康为负有自燃风险，而烧掉的车会消失
    SET_ENTITY_PROOFS(v, FALSE, TRUE, FALSE, FALSE, FALSE)
    SET_VEHICLE_CAN_LEAK_PETROL(v, TRUE)
ENDPROC

// 生成一辆报废车（返回是否成功）
// 在给定的车行节点上放一辆报废车（成功返回 TRUE）
//   ★ v0.23 新增 `SET_ENTITY_AS_MISSION_ENTITY` —— 这是"街上见不到报废车"的**第二个根因**：
//     没标 mission entity 的车辆属于"环境车"，引擎会在它离开玩家视野后自行回收，
//     于是你在 100m 外"放"下的车，等你走过去时早就被清掉了。
PROC PlaceWreckAt(VECTOR nodePos)
    IF g_wreckCount >= MAX_WRECKS
        EXIT
    ENDIF
    MODEL_NAMES m = RandomWreckModel()
    IF NOT HAS_MODEL_LOADED(m)
        EXIT
    ENDIF
    VEHICLE_INDEX v = CREATE_VEHICLE(m, nodePos, GET_RANDOM_FLOAT_IN_RANGE(0.0, 360.0), TRUE, FALSE)
    IF NOT DOES_ENTITY_EXIST(v)
        EXIT
    ENDIF
    SET_VEHICLE_ON_GROUND_PROPERLY(v)
    SET_VEHICLE_DOORS_SHUT(v, TRUE)
    SET_VEHICLE_ALARM(v, FALSE)
    MakeWreck(v)
    // ★ 交给脚本长期持有：不会被引擎当环境车回收，等你回来修
    SET_ENTITY_AS_MISSION_ENTITY(v, TRUE, TRUE)
    g_wrecks[g_wreckCount] = v
    g_wreckCount = g_wreckCount + 1
ENDPROC

// 生成一辆报废车（返回是否成功）
//   【v0.23 修"街上从来见不到报废车"】
//   原来两个问题叠加，导致通过率极低：
//     ① 落点是**纯随机角度**（0~360°），而僵尸刷怪用的是"65% 落后在身后"的偏置；
//     ② 叠加了"必须不在视野外"的硬否决 —— 而城市街道上 60~150m 的道路节点
//        几乎全在你正看着的那条街上，于是反复被否决，十次里难得有一次通过。
//   现在：方向改成**优先身后/侧后**（和僵尸刷怪同一套思路）、距离收到 35~100m、
//   尝试次数 5→10，并且在全部失败时走一条**兜底路径**（沿玩家正后方找节点，
//   不再要求不可见 —— 身后 55~95m 属于余光之外，即使看见也只是远处一辆停着的破车）。
FUNC BOOL SpawnOneWreck()
    // ★ 边界守卫：数组写入前**必须**自检（万一以后有别的调用方忘了先判上限，
    //   越界写全局数组会直接踩坏内存 —— 不能只靠调用方守规矩）。
    IF g_wreckCount >= MAX_WRECKS
        RETURN FALSE
    ENDIF

    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player)
        RETURN FALSE
    ENDIF
    IF NOT g_wreckReady
        RETURN FALSE
    ENDIF
    IF g_playerIndoor
        RETURN FALSE                     // 你在屋里就别在街上搞小动作了
    ENDIF

    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)
    FLOAT baseRad = GET_ENTITY_HEADING(player) * 0.01745329

    INT attempt = 0
    WHILE attempt < 10
        attempt = attempt + 1

        // 方向：70% 落在身后（120°~240°），其余两侧后方 —— 别当着你的面出现
        FLOAT off
        IF GET_RANDOM_INT_IN_RANGE(0, 100) < 70
            off = GET_RANDOM_FLOAT_IN_RANGE(120.0, 240.0)
        ELSE
            IF GET_RANDOM_INT_IN_RANGE(0, 100) < 50
                off = GET_RANDOM_FLOAT_IN_RANGE(70.0, 115.0)
            ELSE
                off = GET_RANDOM_FLOAT_IN_RANGE(-115.0, -70.0)
            ENDIF
        ENDIF
        FLOAT rad = baseRad + (off * 0.01745329)
        FLOAT dist = GET_RANDOM_FLOAT_IN_RANGE(35.0, 100.0)

        VECTOR spot
        spot.x = pc.x + dist * SIN(rad)
        spot.y = pc.y + dist * COS(rad)
        // ★ 用玩家高度做起点（不是 +30）—— 车行节点搜索会按 z 误差加权，
        //   起点差 30m 会让它返回**很远那个街区**的节点。
        spot.z = pc.z

        REQUEST_COLLISION_AT_COORD(spot)

        VECTOR nodePos
        IF GET_CLOSEST_VEHICLE_NODE(spot, nodePos, NF_NONE, 1.0, 1.0)
            // 节点不能离落点太远（横向 60m）—— 防止搜到隔壁街区/对面山头
            VECTOR a2
            VECTOR b2
            a2.x = spot.x
            a2.y = spot.y
            a2.z = 0.0
            b2.x = nodePos.x
            b2.y = nodePos.y
            b2.z = 0.0
            FLOAT lat2 = VDIST2(a2, b2)
            // 层高要和玩家差不多（挡楼顶停车场 / 高架 / 地下车库）
            FLOAT zdiff = nodePos.z - pc.z
            IF lat2 < 3600.0 AND zdiff < 14.0 AND zdiff > -14.0
                // 不在室内（车库 / 隧道里不要）+ 不在营地安全区内（营地边上一辆破车很出戏）
                IF GET_INTERIOR_AT_COORDS(nodePos) = NULL AND NOT InCampSafeZone(nodePos)
                    // 不在视野里 —— 免得当着你的面"变"出来一辆车
                    IF NOT IS_SPHERE_VISIBLE(nodePos, 3.0)
                        // 别和已有的报废车挤在一起（50m 内不重复放）
                        BOOL tooClose = FALSE
                        // 别和已有实体重叠（比如那儿正好停着另一辆车）
                        IF IS_POSITION_OCCUPIED(nodePos, 2.2, FALSE, TRUE, TRUE, FALSE, FALSE, player, FALSE)
                            tooClose = TRUE
                        ENDIF
                        INT k = 0
                        WHILE k < g_wreckCount
                            IF DOES_ENTITY_EXIST(g_wrecks[k])
                                IF VDIST2(nodePos, GET_ENTITY_COORDS(g_wrecks[k], TRUE)) < 2500.0
                                    tooClose = TRUE
                                ENDIF
                            ENDIF
                            k = k + 1
                        ENDWHILE

                        IF NOT tooClose
                            INT before = g_wreckCount
                            PlaceWreckAt(nodePos)
                            IF g_wreckCount > before
                                RETURN TRUE
                            ENDIF
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDWHILE

    // ── 兜底路径：十次随机尝试都失败，就沿"玩家正后方"强行放一辆 ──
    //   为什么需要它：城市街道上 35~100m 内的道路节点大多落在你的视野里，
    //   纯随机 + 视野否决会连续失败 —— 这就是"逛了很久一辆都没见到"的主因。
    //   身后 55~95m 属于余光之外；即使被看到，也只是远处停着一辆破车。
    FLOAT bAng = (GET_ENTITY_HEADING(player) + 180.0) * 0.01745329
    FLOAT bdist = GET_RANDOM_FLOAT_IN_RANGE(55.0, 95.0)
    VECTOR bspot
    bspot.x = pc.x + bdist * SIN(bAng)
    bspot.y = pc.y + bdist * COS(bAng)
    bspot.z = pc.z
    REQUEST_COLLISION_AT_COORD(bspot)

    VECTOR bnode
    IF GET_CLOSEST_VEHICLE_NODE(bspot, bnode, NF_NONE, 1.0, 1.0)
        IF GET_INTERIOR_AT_COORDS(bnode) = NULL
            FLOAT bz = bnode.z - pc.z
            IF bz < 14.0 AND bz > -14.0
                BOOL bClose = FALSE
                INT k2 = 0
                WHILE k2 < g_wreckCount
                    IF DOES_ENTITY_EXIST(g_wrecks[k2])
                        IF VDIST2(bnode, GET_ENTITY_COORDS(g_wrecks[k2], TRUE)) < 2500.0
                            bClose = TRUE
                        ENDIF
                    ENDIF
                    k2 = k2 + 1
                ENDWHILE
                IF NOT bClose
                    PlaceWreckAt(bnode)
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    RETURN FALSE
ENDFUNC

// 一次最多放两辆（路上有破车是氛围，堵满整条街就假了）
PROC SpawnWrecks()
    IF g_wreckCount >= MAX_WRECKS
        EXIT
    ENDIF
    INT want = GET_RANDOM_INT_IN_RANGE(1, 3)
    INT made = 0
    INT tries = 0
    WHILE made < want AND tries < 4
        tries = tries + 1
        IF g_wreckCount < MAX_WRECKS
            IF SpawnOneWreck()
                made = made + 1
            ENDIF
        ENDIF
    ENDWHILE
ENDPROC

// 1Hz 维护：车没了 / 被炸了 -> 从名单摘掉；离得太远 -> 交还给引擎（省资源）
PROC UpdateWrecks()
    IF g_wreckCount <= 0
        EXIT
    ENDIF
    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    INT i = 0
    WHILE i < g_wreckCount
        BOOL drop = FALSE
        VEHICLE_INDEX v = g_wrecks[i]
        IF NOT DOES_ENTITY_EXIST(v)
            drop = TRUE
        ENDIF
        // ★ v0.23：不再"离得远就释放"。报废车已被标成 mission entity，
        //   `SET_VEHICLE_AS_NO_LONGER_NEEDED` 对它无效（车会留在世界里，
        //   但我们的名单里没了 -> 变成一辆永远修不好的废车）。
        //   而且这本来就是"你开出去搜刮、回头再来修"的玩法，车必须留在原地。
        //   上限只有 6 辆，长期持有无压力。

        IF drop
            INT last = g_wreckCount - 1
            g_wreckCount = last
            g_wrecks[i] = g_wrecks[last]
        ELSE
            i = i + 1
        ENDIF
    ENDWHILE
ENDPROC

// 从名单里摘掉一辆（修好之后调用）
PROC RemoveWreck(VEHICLE_INDEX v)
    INT i = 0
    WHILE i < g_wreckCount
        IF g_wrecks[i] = v
            INT last = g_wreckCount - 1
            g_wreckCount = last
            g_wrecks[i] = g_wrecks[last]
            i = last                     // 跳出（末尾接手过来的那辆也要检查，但这里不需要）
        ELSE
            i = i + 1
        ENDIF
    ENDWHILE
ENDPROC

// 把报废车修好（消耗零件之后调用）
PROC FixWreck(VEHICLE_INDEX v)
    IF NOT DOES_ENTITY_EXIST(v)
        EXIT
    ENDIF
    SET_VEHICLE_UNDRIVEABLE(v, FALSE)      // 先解除"开不走"
    SET_VEHICLE_FIXED(v)                   // 一次性复原（含冒烟 / 掉轮）
    SET_VEHICLE_ENGINE_HEALTH(v, 1000.0)
    SET_VEHICLE_BODY_HEALTH(v, 1000.0)
    SET_VEHICLE_TYRE_FIXED(v, SC_WHEEL_CAR_FRONT_LEFT)
    SET_VEHICLE_TYRE_FIXED(v, SC_WHEEL_CAR_FRONT_RIGHT)
    SET_VEHICLE_TYRE_FIXED(v, SC_WHEEL_CAR_REAR_LEFT)
    SET_VEHICLE_TYRE_FIXED(v, SC_WHEEL_CAR_REAR_RIGHT)
    SET_VEHICLE_DOORS_SHUT(v, TRUE)
    SET_VEHICLE_DIRT_LEVEL(v, 0.0)
    SET_VEHICLE_CAN_LEAK_PETROL(v, FALSE)
    SET_ENTITY_PROOFS(v, FALSE, FALSE, FALSE, FALSE, FALSE)   // 防护恢复正常
    SET_VEHICLE_ALARM(v, FALSE)
    // ★ v0.23：修好之后**交还引擎管理** —— 它现在是一辆普通车了，不该再由脚本
    //   永久持有（否则每修好一辆，世界里就多一辆永远不会被回收的车）。
    SET_ENTITY_AS_MISSION_ENTITY(v, FALSE, TRUE)
ENDPROC

// 清场（关掉僵尸模式时）：报废车是我们造出来的 -> 一并删除
PROC ForgetAllWrecks()
    INT i = 0
    WHILE i < g_wreckCount
        VEHICLE_INDEX v = g_wrecks[i]
        IF DOES_ENTITY_EXIST(v)
            SET_ENTITY_AS_MISSION_ENTITY(v, TRUE, TRUE)
            DELETE_VEHICLE(v)
        ENDIF
        i = i + 1
    ENDWHILE
    g_wreckCount = 0
    g_nextWreck = 0
ENDPROC

FUNC BOOL VehicleNeedsRepair(VEHICLE_INDEX v)
    IF NOT DOES_ENTITY_EXIST(v)
        RETURN FALSE
    ENDIF
    // ★ v0.22：报废车**不走徒手敲击这条路** —— 它必须用零件修。
    //   不加这一条的话，敲十几下就能把发动机从 -400 敲回 900，
    //   零件系统就形同虚设了。
    IF IsWreck(v)
        RETURN FALSE
    ENDIF
    IF IS_ENTITY_UPSIDEDOWN(v)
        RETURN FALSE                     // 翻车的先自己翻回来
    ENDIF
    IF GET_VEHICLE_ENGINE_HEALTH(v) < REPAIR_NEED
        RETURN TRUE
    ENDIF
    IF GET_VEHICLE_BODY_HEALTH(v) < REPAIR_NEED
        RETURN TRUE
    ENDIF
    RETURN FALSE
ENDFUNC

// 扫描身边最近的"需要处理的车"，结果写进 g_repairCand / g_repairCandIsWreck
//   v0.22：从"只找能敲的车"扩成**两类**：
//     · 报废车（在 g_wrecks 名单里）-> 走零件修复
//     · 普通受损车 -> 走徒手敲击
//   仍然只认**最近的那一辆**（人站在两辆车中间时，先处理脚边这辆更符合直觉）。


PROC ScanRepairCandidate()
    g_repairCand = NULL
    g_repairCandIsWreck = FALSE

    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player)
        EXIT
    ENDIF
    IF IS_PED_IN_ANY_VEHICLE(player)
        EXIT                             // 坐在车里不修
    ENDIF
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    // ★ 第一优先：先扫**我们自己的报废车名单**。
    //   为什么不用下面的 native 搜索来找报废车：那样就把"能不能修报废车"这个核心玩法
    //   押在了 `GET_CLOSEST_VEHICLE` 的检索标志上（它未必会把脚本创建的、又被我们
    //   标成不可驾驶的车算进来）。直扫名单只花几次 VM 距离比较（0 次 native），
    //   而且**一定**找得到 —— 关键玩法不该依赖不确定的检索行为。
    //   优先级说明：报废车排在前面（它是需要"掏出零件"的主动交互，意图更明确），
    //   普通受损车排在后面（随时可敲，不着急）。
    INT wi = 0
    FLOAT wbest = REPAIR_RANGE
    WHILE wi < g_wreckCount
        VEHICLE_INDEX wv = g_wrecks[wi]
        IF DOES_ENTITY_EXIST(wv)
            FLOAT wd = VDIST(pc, GET_ENTITY_COORDS(wv, TRUE))
            IF wd < wbest
                wbest = wd
                g_repairCand = wv
                g_repairCandIsWreck = TRUE
            ENDIF
        ENDIF
        wi = wi + 1
    ENDWHILE
    IF g_repairCandIsWreck
        EXIT
    ENDIF

    // ★ 第二优先：普通受损车（徒手敲击修理）
    //   搜索标志（照官方写法）：场景车 + 脚本车 + 里面坐着人的（车主就是你）都要能选中。
    //   注意：SanScript **不支持把调用拆到多行**（参数必须写在一行里，拆行报 parse error），
    //   所以这里先把标志拼进一个 INT，再传给调用 —— 调用行就不会长得离谱。
    INT vflags = VEHICLE_SEARCH_FLAG_RETURN_RANDOM_VEHICLES | VEHICLE_SEARCH_FLAG_RETURN_MISSION_VEHICLES | VEHICLE_SEARCH_FLAG_RETURN_VEHICLES_CONTAINING_A_PLAYER | VEHICLE_SEARCH_FLAG_RETURN_VEHICLES_CONTAINING_A_DEAD_OR_DYING_PED | VEHICLE_SEARCH_FLAG_ALLOW_VEHICLE_OCCUPANTS_TO_BE_PERFORMING_A_SCRIPTED_TASK
    VEHICLE_INDEX v = GET_CLOSEST_VEHICLE(pc, REPAIR_RANGE, DUMMY_MODEL_FOR_SCRIPT, vflags)

    IF NOT DOES_ENTITY_EXIST(v)
        EXIT
    ENDIF
    IF VehicleNeedsRepair(v)
        g_repairCand = v
    ENDIF
ENDPROC

// 结算一次敲击：车况回升 + 形变/碎窗复原（★ 这是玩家"看得见"的修复反馈）
PROC ApplyRepairHit(VEHICLE_INDEX v)
    IF NOT DOES_ENTITY_EXIST(v)
        EXIT
    ENDIF
    FLOAT eh = GET_VEHICLE_ENGINE_HEALTH(v) + 180.0
    IF eh > 1000.0 eh = 1000.0 ENDIF
    SET_VEHICLE_ENGINE_HEALTH(v, eh)
    FLOAT bh = GET_VEHICLE_BODY_HEALTH(v) + 180.0
    IF bh > 1000.0 bh = 1000.0 ENDIF
    SET_VEHICLE_BODY_HEALTH(v, bh)

    // ★ 关掉形变 = 凹陷/掉漆当场复原（僵尸砸出来的痕迹消失）
    SET_VEHICLE_DEFORMATION_FIXED(v)
    SET_VEHICLE_DIRT_LEVEL(v, 0.0)
    // 顺手补一扇窗（碎窗是僵尸砸车留下的最直观痕迹）
    FIX_VEHICLE_WINDOW(v, INT_TO_ENUM(SC_WINDOW_LIST, GET_RANDOM_INT_IN_RANGE(0, 6)))
    SET_VEHICLE_ALARM(v, FALSE)
ENDPROC

// 敲下去：面向车辆 + 播修车动画，0.7 秒后由 RepairTick 结算
PROC StartRepairHit(VEHICLE_INDEX v)
    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player) OR NOT DOES_ENTITY_EXIST(v)
        EXIT
    ENDIF
    g_repairVeh = v
    g_repairAt = GET_GAME_TIMER() + REPAIR_DELAY_MS

    // 面向车辆（引擎不会替我们转）
    TASK_TURN_PED_TO_FACE_ENTITY(player, v, 250)
    // 修车动画：官方 FBI4_Prep2.sc 用的就是 mini@repair / fixing_a_ped。
    //   flags 48 = AF_UPPERBODY | AF_SECONDARY：只动上半身、走次级任务槽，
    //   玩家仍能移动、也不会把别的任务顶掉（否则被咬时跑不掉）。
    IF HAS_ANIM_DICT_LOADED("mini@repair")
        TASK_PLAY_ANIM(player, "mini@repair", "fixing_a_ped", 4.0, 4.0, REPAIR_DELAY_MS, INT_TO_ENUM(ANIMATION_FLAGS, 48))
    ENDIF
ENDPROC

// 结算（主循环每帧调用；不在"正在敲"的 0.7 秒内时只有 1 次计时器比较，代价 0）
PROC RepairTick()
    IF g_repairAt = 0
        EXIT
    ENDIF
    IF GET_GAME_TIMER() < g_repairAt
        EXIT
    ENDIF
    g_repairAt = 0
    VEHICLE_INDEX v = g_repairVeh
    g_repairVeh = NULL
    // ★ 局部变量名**不能叫 isWreck** —— SanScript 不区分大小写，
    //   会和函数 `IsWreck()` 撞名，报 "parse error, expecting NEWSYM or VAR_REF"。
    //   （同类坑：night / phase / surge / post）
    BOOL wreckFix = g_repairIsWreck
    g_repairIsWreck = FALSE
    IF NOT DOES_ENTITY_EXIST(v)
        EXIT
    ENDIF

    // ★ v0.22：修报废车（零件在**结算这一刻**才扣 —— 中途走开不会白花零件）
    IF wreckFix
        IF g_parts < WRECK_PARTS
            g_specialUntil = GET_GAME_TIMER() + 3000
            g_specialMsg = "零件不足 - 修复中断"
            EXIT
        ENDIF
        g_parts = g_parts - WRECK_PARTS
        FixWreck(v)
        RemoveWreck(v)
        g_specialUntil = GET_GAME_TIMER() + 4500
        g_specialMsg = "报废车修复完成 - 可以开了"
        EXIT
    ENDIF

    ApplyRepairHit(v)

    g_specialUntil = GET_GAME_TIMER() + 2500
    IF NOT VehicleNeedsRepair(v)
        // 全好了 -> 一次性复原一切（含冒烟/掉轮），彻底利落
        SET_VEHICLE_FIXED(v)
        g_specialMsg = "车辆已修复"
    ELSE
        g_specialMsg = "修理中… 再敲几下"
    ENDIF
ENDPROC

// 修报废车：先播动画，1.4 秒后由 RepairTick 结算（和徒手敲车同一套"两段式"）
//   ★ 零件不足时不播动画、直接给提示 —— 免得玩家以为"敲了就有用"。
PROC StartWreckRepair(VEHICLE_INDEX v)
    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player) OR NOT DOES_ENTITY_EXIST(v)
        EXIT
    ENDIF

    IF g_parts < WRECK_PARTS
        g_specialUntil = GET_GAME_TIMER() + 3500
        g_specialMsg = "零件不足 - 搜刮僵尸尸体可以找到汽车零件"
        EXIT
    ENDIF

    g_repairVeh = v
    g_repairIsWreck = TRUE
    g_repairAt = GET_GAME_TIMER() + WRECK_REPAIR_MS

    TASK_TURN_PED_TO_FACE_ENTITY(player, v, 250)
    IF HAS_ANIM_DICT_LOADED("mini@repair")
        TASK_PLAY_ANIM(player, "mini@repair", "fixing_a_ped", 4.0, 4.0, WRECK_REPAIR_MS, INT_TO_ENUM(ANIMATION_FLAGS, 48))
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 野化动物（v0.21 新增）
//
//   【设计意图】末日里没人喂的宠物和被血腥味引来的野兽会进城。
//   对玩法的意义有两个：
//     1. 氛围 —— 街上不再只有僵尸和活人，"还有别的东西活着"；
//     2. **食物来源** —— 打死之后走我们已有的搜刮系统（`g_lootKind = 1`），
//        割肉补饥饿，和 v0.15 的生存三柱咬合（比翻箱子更有末日感）。
//
//   【为什么只挑这几种】都是"城市化野兽"：流浪犬 / 野猪 / 郊狼 / 山狮。
//   刻意**不用**鹿、牛、鸡这些纯乡下的模型 —— 我们没有可靠的"城区/郊外"判定
//   （`GET_NAME_OF_ZONE` 要拿字符串做比较，端口的字符串比较行为没法离线验证），
//   与其赌它，不如选在任何地点出现都说得通的动物。
//
//   【生成方式】完全沿用僵尸那套：视野否决（`IS_SPHERE_VISIBLE`）+ 高差否决 +
//   不占用已有位置 + 贴地。距玩家 55~110m，玩家看不见的地方才刷。
// ---------------------------------------------------------------------------
// ★ v0.24：用户要求删掉**猫狗**（原来两个犬种占了一半以上）——
//   街上到处是流浪狗确实太"日常"，而且狗的模型和僵尸混在一起辨识度差。
//   现在只剩三种"野性"动物：野猪 / 郊狼 / 山狮。
FUNC MODEL_NAMES RandomAnimalModel()
    INT r = GET_RANDOM_INT_IN_RANGE(0, 100)
    IF r < 45 RETURN A_C_BOAR ENDIF           // 野猪（最常见）
    IF r < 88 RETURN A_C_COYOTE ENDIF         // 郊狼
    RETURN A_C_MTLION                          // 山狮（罕见）
ENDFUNC

// 尝试刷一只野化动物（与僵尸同款的校验；成功返回 TRUE）
FUNC BOOL SpawnOneAnimal()
    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player)
        RETURN FALSE
    ENDIF
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    INT attempt = 0
    WHILE attempt < 5
        attempt = attempt + 1

        FLOAT ang = GET_RANDOM_FLOAT_IN_RANGE(0.0, 360.0)
        FLOAT rad = ang * 0.01745329
        FLOAT dist = GET_RANDOM_FLOAT_IN_RANGE(55.0, 110.0)

        VECTOR spot
        spot.x = pc.x + dist * SIN(rad)
        spot.y = pc.y + dist * COS(rad)
        spot.z = pc.z + 60.0

        REQUEST_COLLISION_AT_COORD(spot)
        FLOAT gz = 0.0
        IF GET_GROUND_Z_FOR_3D_COORD(spot, gz)
            spot.z = gz + 0.6
            // ★ v0.22：和僵尸共用同一套落点校验（室内否决 + 道路层校验挡楼顶 + 坡度 + 占位）
            // ★ v0.24：营地安全区内不生成（山狮在营地旁边转悠就没法安心休息了）
            IF GroundSpotOK(spot, pc, gz, 1.5) AND NOT InCampSafeZone(spot)
                // ★ 视野否决：生成点不能在玩家视野里（否则"凭空出现"）
                IF NOT IS_SPHERE_VISIBLE(spot, 2.0)
                    MODEL_NAMES m = RandomAnimalModel()
                    PED_INDEX a = CREATE_PED(PEDTYPE_ANIMAL, m, spot, GET_RANDOM_FLOAT_IN_RANGE(0.0, 360.0), TRUE, FALSE)
                    IF DOES_ENTITY_EXIST(a)
                        // 血比僵尸薄（一枪就倒，保证"打猎"是轻松事而不是消耗战）
                        SET_ENTITY_MAX_HEALTH(a, 200)
                        SET_ENTITY_HEALTH(a, 200)
                        // 随机游荡；靠引擎自己的动物 AI（受惊会跑）
                        TASK_WANDER_STANDARD(a)
                        SET_PED_KEEP_TASK(a, TRUE)
                        g_animals[g_animalCount] = a
                        g_animalCount = g_animalCount + 1
                        RETURN TRUE
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDWHILE
    RETURN FALSE
ENDFUNC

PROC SpawnWildlife()
    IF g_animalCount >= MAX_ANIMALS
        EXIT
    ENDIF
    IF NOT g_animalReady
        EXIT
    ENDIF
    // 一次最多两只（动物是点缀，不该像僵尸那样成群）
    INT want = GET_RANDOM_INT_IN_RANGE(1, 3)
    INT made = 0
    INT tries = 0
    WHILE made < want AND tries < 6
        tries = tries + 1
        IF SpawnOneAnimal()
            made = made + 1
        ENDIF
    ENDWHILE
ENDPROC

// 1Hz 维护：死了 -> 记成"兽尸"交给搜刮系统；走远 -> 释放
PROC UpdateAnimals()
    IF g_animalCount <= 0
        EXIT
    ENDIF
    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)

    INT i = 0
    WHILE i < g_animalCount
        BOOL drop = FALSE
        IF NOT DOES_ENTITY_EXIST(g_animals[i])
            drop = TRUE
        ELIF IS_ENTITY_DEAD(g_animals[i], FALSE)
            RememberLoot(g_animals[i], 1)        // 1 = 兽：搜刮出肉
            SET_PED_AS_NO_LONGER_NEEDED(g_animals[i])
            drop = TRUE
        ELIF VDIST(pc, GET_ENTITY_COORDS(g_animals[i], TRUE)) > 250.0
            SET_PED_AS_NO_LONGER_NEEDED(g_animals[i])
            drop = TRUE
        ENDIF

        IF drop
            INT last = g_animalCount - 1
            g_animalCount = last
            g_animals[i] = g_animals[last]
        ELSE
            i = i + 1
        ENDIF
    ENDWHILE
ENDPROC

PROC ForgetAllAnimals()
    INT i = 0
    WHILE i < g_animalCount
        IF DOES_ENTITY_EXIST(g_animals[i])
            SET_ENTITY_AS_MISSION_ENTITY(g_animals[i], TRUE, TRUE)
            DELETE_PED(g_animals[i])
        ENDIF
        i = i + 1
    ENDWHILE
    g_animalCount = 0
    g_nextWildlife = 0
ENDPROC

// 扫描最近的可搜刮尸体
FUNC INT ScanLootCandidate()
    PED_INDEX player = PLAYER_PED_ID()
    VECTOR pc = GET_ENTITY_COORDS(player, TRUE)
    INT bestSlot = -1
    FLOAT bestD = 999.0
    INT i = 0
    WHILE i < 6
        IF NOT g_lootTaken[i]
            PED_INDEX corpse = g_lootPed[i]
            IF NOT DOES_ENTITY_EXIST(corpse)
                // 尸体已被引擎刷掉 -> 这一格作废
                g_lootTaken[i] = TRUE
            ELSE
                FLOAT d = VDIST(pc, GET_ENTITY_COORDS(corpse, TRUE))
                IF d < 2.5 AND d < bestD
                    bestD = d
                    bestSlot = i
                ENDIF
            ENDIF
        ENDIF
        i = i + 1
    ENDWHILE
    RETURN bestSlot
ENDFUNC

// 统一互动入口（1Hz）
PROC UpdateInteract()
    ScanRecruitCandidate()
    INT lootSlot = ScanLootCandidate()
    // v0.22：第三个候选 —— 身边有没有需要处理的车
    //   结果写在 g_repairCand / g_repairCandIsWreck（报废车 vs 普通受损车）
    ScanRepairCandidate()

    // v0.24：第四个候选 —— 站在营地里（3m 内）
    //   ★ 局部变量**不能叫 nearCamp** —— SanScript 不区分大小写，会和函数
    //     `NearCamp()` 撞名，报 parse error（同类坑：isWreck / post / night）。
    BOOL atCamp = NearCamp()

    IF g_candKind = 0 AND lootSlot < 0 AND NOT DOES_ENTITY_EXIST(g_repairCand) AND NOT atCamp
        EXIT
    ENDIF

    // 仲裁：谁能拿到这次按键（v0.21 起有三个候选）
    //   · 有 NPC 候选        -> NPC（无条件优先）
    //   · 否则只有尸体        -> 搜刮
    //   · 否则只有车          -> 修车
    //   · 尸体和车都有        -> 谁近谁赢（两者都是场景物件、都不着急）
    // ★ v0.9：NPC 候选**无条件优先**于尸体。
    //   上一版按"谁近谁赢"仲裁 —— 可刚打完架的幸存者脚边通常就躺着尸体，
    //   你想招募时按键被"搜刮"吃掉了，表现就是"对着幸存者按键没反应"。
    //   尸体随时可以搜（它自己会一直在那儿），招募机会却稍纵即逝。
    BOOL doNpc = FALSE
    IF g_candKind <> 0
        doNpc = TRUE
    ENDIF

    // ★ v0.21 仲裁：NPC 绝对优先（招募机会稍纵即逝）；NPC 没有候选时，
    //   "修车"与"搜刮尸体"按**谁近谁赢** —— 两者都是场景物件、都不着急。
    BOOL doRepair = FALSE
    IF NOT doNpc AND DOES_ENTITY_EXIST(g_repairCand)
        IF lootSlot < 0
            doRepair = TRUE
        ELSE
            PED_INDEX rp = PLAYER_PED_ID()
            VECTOR rpc = GET_ENTITY_COORDS(rp, TRUE)
            FLOAT dV = VDIST(rpc, GET_ENTITY_COORDS(g_repairCand, TRUE))
            FLOAT dL = VDIST(rpc, GET_ENTITY_COORDS(g_lootPed[lootSlot], TRUE))
            IF dV <= dL
                doRepair = TRUE
            ENDIF
        ENDIF
    ENDIF

    // ★ v0.24：营地也参与"谁近谁赢"，而且**赢过修车**（修车随时可敲，休息是主动行为）。
    //   为什么要比距离而不是无条件优先：帐篷边上也会躺尸体（你刚清完场），
    //   如果营地永远优先，那就"没法捡自己刚打死的那只僵尸了"。
    BOOL doCamp = FALSE
    IF NOT doNpc AND atCamp
        PED_INDEX cp = PLAYER_PED_ID()
        VECTOR cpc = GET_ENTITY_COORDS(cp, TRUE)
        FLOAT dCamp = VDIST(cpc, g_campPos)
        FLOAT dOther = 9999.0
        IF lootSlot >= 0
            dOther = VDIST(cpc, GET_ENTITY_COORDS(g_lootPed[lootSlot], TRUE))
        ENDIF
        IF DOES_ENTITY_EXIST(g_repairCand)
            FLOAT dCar = VDIST(cpc, GET_ENTITY_COORDS(g_repairCand, TRUE))
            IF dCar < dOther
                dOther = dCar
            ENDIF
        ENDIF
        IF dCamp <= dOther
            doCamp = TRUE
            doRepair = FALSE          // 营地赢了，这一次按键不是修车
        ENDIF
    ENDIF

    g_hintUntil = GET_GAME_TIMER() + 1600
    IF doNpc
        IF g_candKind = 1
            g_hintMsg = "按 [十字键 右] 解除这名护卫"
        ELSE
            // 招募是"整队"的，提示里写清楚
            g_hintMsg = "按 [十字键 右] 招募附近的人"
        ENDIF
        // ★ 防连按：动作做完后 0.8 秒内不再响应 —— 否则刚招完一队，
        //   手指还按着/又按一下，立刻就把身边最近的护卫给解雇了。
        IF g_keyContext AND GET_GAME_TIMER() > g_interactNext
            g_keyContext = FALSE
            g_interactNext = GET_GAME_TIMER() + 800
            IF g_candKind = 1
                DismissGuard(g_candPed)
            ELSE
                RecruitSquad(g_candPed)
            ENDIF
        ENDIF
    ELIF doCamp
        g_hintMsg = "按 [十字键 右] 在营地睡到早上 6 点"
        IF g_keyContext AND GET_GAME_TIMER() > g_interactNext
            g_keyContext = FALSE
            g_interactNext = GET_GAME_TIMER() + 900
            StartCampRest()
        ENDIF
    ELIF doRepair
        IF g_repairCandIsWreck
            // ── 报废车：只能靠"汽车零件"修（打僵尸搜刮获得）──
            //   提示文案里的 3 与常量 WRECK_PARTS 保持一致（字符串不能与数字拼接，
            //   所以这里是写死的 —— 改常量时记得同步这句）。
            IF g_parts >= WRECK_PARTS
                g_hintMsg = "按 [十字键 右] 用汽车零件修复这辆报废车"
            ELSE
                g_hintMsg = "报废车：需要 3 个汽车零件（打僵尸后搜刮尸体）"
            ENDIF
            IF g_keyContext AND GET_GAME_TIMER() > g_interactNext
                g_keyContext = FALSE
                g_interactNext = GET_GAME_TIMER() + 700
                StartWreckRepair(g_repairCand)
            ENDIF
        ELSE
            g_hintMsg = "按 [十字键 右] 敲击修理车辆"
            IF g_keyContext AND GET_GAME_TIMER() > g_interactNext
                g_keyContext = FALSE
                g_interactNext = GET_GAME_TIMER() + 700
                StartRepairHit(g_repairCand)
            ENDIF
        ENDIF
    ELSE
        g_hintMsg = "按 [十字键 右] 搜刮尸体"
        IF g_keyContext AND GET_GAME_TIMER() > g_interactNext
            g_keyContext = FALSE
            g_interactNext = GET_GAME_TIMER() + 800
            g_lootTaken[lootSlot] = TRUE
            TakeLoot(g_lootKind[lootSlot])
        ENDIF
    ENDIF
ENDPROC

// 屏幕底部的小提示
PROC DrawHint(STRING s)
    DRAW_RECT(0.5, 0.885, 0.30, 0.030, 10, 12, 16, 200)
    SET_TEXT_FONT(FONT_STANDARD)
    SET_TEXT_CENTRE(TRUE)
    SET_TEXT_WRAP(0.0, 1.0)
    SET_TEXT_DROPSHADOW(1, 0, 0, 0, 200)
    SET_TEXT_SCALE(0.26, 0.26)
    SET_TEXT_COLOUR(235, 235, 240, 235)
    BEGIN_TEXT_COMMAND_DISPLAY_TEXT("STRING")
    ADD_TEXT_COMPONENT_SUBSTRING_KEYBOARD_DISPLAY(s)
    END_TEXT_COMMAND_DISPLAY_TEXT(0.5, 0.876)
    SET_TEXT_CENTRE(FALSE)
ENDPROC

// 提示文字（问题 9）：把按键名写清楚 —— 本端口上互动键就是十字键右键

// 招募/解雇交互（1Hz 检查；命中时给出提示文字）

// ---------------------------------------------------------------------------
// 尸潮压力（参考 ApocalypseDirector 的精简版）
//   把 Reborn 的一整套乘数压成几个标量：平静/紧张阶段交替 × 昼夜 × 噪声 × 尸潮 surge
//   → g_pressure（0.65~2.2）→ 决定活跃上限与刷新节奏
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 尸潮（问题 6 / 7 的修复）
//
// 问题 6「太频繁」的根因：
//   上一版把 Reborn 的 `_hordeSurgeChance = 0.08` 直接塞进**每秒**一次的掷骰里，
//   还叠了紧张期 +6、噪声 +8、夜间 +5 —— 最高 27%/秒，平均十几秒就来一次尸潮。
//   而 Reborn 里 `TryStartHordeSurge()` 是**只在阶段切换到紧张期时调一次**
//   （UpdatePressurePhase 里），本来就是"每 1~3 分钟才掷一次"的稀有事件。
//   现在照它的调度改：
//     · 只在"刚进入紧张阶段"时掷一次骰子
//     · 掷骰概率 22%（噪声 >55 再 +20、夜间再 +15）
//     · 两次尸潮之间硬性至少隔 90 秒
// 问题 7「看不出变化」的根因：
//   尸潮原来只改了两个标量（上限 ×1.35、刷新间隔 1500→500ms），屏幕上几乎看不出来。
//   现在补上"看得见"的部分：
//     · 开始瞬间在玩家**前方**一次刷 4~7 只（明显的"一堵墙涌过来"）
//     · 之后每 6 秒再补一波，共 3 波
//     · 活跃上限额外 +10（Reborn 的 HordeSurge 也走同一条乘子链）
//     · 右下角出现红色「尸潮」倒计时
// ---------------------------------------------------------------------------
PROC StartHorde()
    // 双保险：理论上只有 UpdateThreat 会调它，而 UpdateThreat 已有模式门槛；
    // 但这条提示太醒目，多一道门槛的成本是 1 次判断，值得。
    IF NOT g_infection
        EXIT
    ENDIF
    INT now = GET_GAME_TIMER()
    g_hordeUntil = now + GET_RANDOM_INT_IN_RANGE(35000, 65000)
    g_hordeMinUntil = g_hordeUntil + 90000        // 硬性冷却：两次尸潮至少隔 90 秒
    g_hordeWavesLeft = 3
    g_hordeNextWave = now                          // 立刻来第一波
    g_hordeSpawned = 0
    g_noise = 100.0
    g_specialUntil = now + 4000
    g_specialMsg = "尸潮来袭"
ENDPROC

// 尸潮期间的补波：每 6 秒在玩家前方刷 4~7 只（比平时的 1~3 只明显得多）
PROC UpdateHordeWave()
    IF g_hordeWavesLeft <= 0
        EXIT
    ENDIF
    IF NOT g_modelReady
        EXIT
    ENDIF
    INT now = GET_GAME_TIMER()
    IF now < g_hordeNextWave
        EXIT
    ENDIF
    g_hordeNextWave = now + 6000
    g_hordeWavesLeft = g_hordeWavesLeft - 1

    FLOAT dist = SpawnDistance() * 0.75            // 刷得更近，压迫感更强
    INT want = GET_RANDOM_INT_IN_RANGE(4, 8)
    INT made = 0
    WHILE made < want
        IF g_zombieCount < ActiveCap()
            IF SpawnOneZombie(dist)
                g_hordeSpawned = g_hordeSpawned + 1
            ENDIF
        ENDIF
        made = made + 1
    ENDWHILE
ENDPROC

PROC UpdateThreat()
    // ★★ v0.19 BUG 修复：**这里是"不开感染模式也会弹尸潮来袭"的根因**。
    //   本过程承担"平静/紧张阶段推进 + 尸潮掷骰 + 噪声累计"，但它原来
    //   **没有任何模式门槛**，而调用它的 `UpdateSlowSystems()` 是每帧无条件跑的
    //   （1Hz）。于是：没开感染模式 → 阶段照转 → 紧张期一到就掷骰 →
    //   `StartHorde()` → 弹出"尸潮来袭"，可场上连一只僵尸都没有。
    //   现在加门槛：不在感染模式里就整段不执行（噪声/压力也随之停摆，
    //   由主循环在关闭模式时统一复位，见 `g_prevInfection AND NOT g_infection`）。
    IF NOT g_infection
        EXIT
    ENDIF

    INT now = GET_GAME_TIMER()

    // 平静 / 紧张 阶段交替（Reborn：calm 45~90s，tension 30~75s）
    IF now > g_phaseCalm
        g_tension = NOT g_tension
        IF g_tension
            g_phaseCalm = now + GET_RANDOM_INT_IN_RANGE(30000, 75000)
            // ★ 尸潮掷骰只在这里发生（对照 Reborn 的 TryStartHordeSurge 调用点）
            IF now > g_hordeMinUntil
            AND now > g_hordeUntil
                INT hc = 22
                IF g_noise > 55.0 hc = hc + 20 ENDIF
                IF GET_CLOCK_HOURS() >= 20 OR GET_CLOCK_HOURS() <= 4 hc = hc + 15 ENDIF
                IF GET_RANDOM_INT_IN_RANGE(0, 100) < hc
                    StartHorde()
                ENDIF
            ENDIF
        ELSE
            g_phaseCalm = now + GET_RANDOM_INT_IN_RANGE(45000, 90000)
        ENDIF
    ENDIF

    // 噪声源（Reborn：冲刺 4/s、车辆 4.5/s；这里适当放大，让玩家能明显感觉到）
    PED_INDEX player = PLAYER_PED_ID()
    IF IS_PED_RUNNING(player)
        g_noise = g_noise + 6.0
    ENDIF
    IF IS_PED_IN_ANY_VEHICLE(player)
        IF GET_ENTITY_SPEED(player) > 2.0
            g_noise = g_noise + 7.0
        ENDIF
    ENDIF
    // 自然衰减
    g_noise = g_noise - 5.0
    IF g_noise < 0.0 g_noise = 0.0 ENDIF
    IF g_noise > 100.0 g_noise = 100.0 ENDIF

    // 压力合成（局部变量避开内建名：night / phase 这类词可能撞车）
    FLOAT phaseMul = 0.85
    IF g_tension phaseMul = 1.25 ENDIF
    FLOAT nightMul = 0.95
    INT h = GET_CLOCK_HOURS()
    IF h >= 20 OR h <= 4 nightMul = 1.2 ENDIF
    FLOAT noiseMul = 1.0 + (g_noise / 100.0) * 0.45
    FLOAT surgeMul = 1.0
    IF now < g_hordeUntil surgeMul = 1.35 ENDIF

    g_pressure = phaseMul * nightMul * noiseMul * surgeMul
    IF g_pressure < 0.65 g_pressure = 0.65 ENDIF
    IF g_pressure > 2.2 g_pressure = 2.2 ENDIF

ENDPROC

// 低速系统统一入口（1Hz）—— 把非关键帧逻辑都节流到一起
//   ★ 注意：互动键的"按下"是单帧事件，1Hz 采样会漏掉。
//   所以按键边沿在主循环里每帧采样成 g_keyContext 标志位，这里只消费标志位。

// ---------------------------------------------------------------------------
// 生存三柱（v0.15）—— 饥饿 / 口渴 / 体力
//
//   【为什么做】给已有的"搜刮尸体 / 解药箱 / 撤回休整"一个存在理由：
//   末日模组里如果没有"必须去找补给"的压力，捡东西就只是收集癖。
//
//   【设计原则（都是踩过的坑）】
//     · **不做常驻计数**：三条都只在低于阈值时才显示，正常状态屏幕上只有
//       「末日第 N 天」—— 符合之前"去掉计数器以增强沉浸感"的要求。
//     · **状态类 native 只在边沿设**：体力不支的减速（`SET_PED_MOVE_RATE_OVERRIDE`）
//       只在跨越阈值时设一次，不是每帧设（状态类 native 每帧调会顶掉别的脚本）。
//     · **掉血必须尊重无敌**：走 `PlayerProtected()`，和僵尸撕咬用同一套判定。
//     · 全部塞进 1Hz 入口 `UpdateSlowSystems` -> `UpdateSurvival()`，
//       每帧只多 1 次计时器比较。
//
//   【数值】
//     饥饿 100→0 约 33 分钟；口渴 100→0 约 25 分钟（缺水比缺食更致命）
//     归零后每 5 秒掉血：饿 -2.5 / 渴 -3.5。**故意留一手**：伤害只在
//       `当前血量 > 伤害` 时施加 —— 所以饿/渴本身不会直接杀死你，
//       只会把你压到濒死（1~3 点血），最后一击留给僵尸。免得"莫名暴毙"。
//     体力：冲刺 -2.5/秒、奔跑 -1.2/秒、静止 +1.5/秒、车内 +0.8/秒
//     体力 <20 -> 移动力 ×0.85；=0 且还在跑 -> 12~22 秒判定一次，35% 腿软
//     补给：搜刮尸体有机会拿到 罐头（饥饿 +20）/ 瓶装水（水分 +20）
//     死亡复活 或 关闭僵尸模式 -> 三条全部回满、提示标志复位
// ---------------------------------------------------------------------------

// 掉血的统一入口：尊重无敌/受保护状态（与 ZombieAttack 的判定一致）
PROC StarveDamage(FLOAT amount)
    PED_INDEX p = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(p)
        EXIT
    ENDIF
    IF IS_ENTITY_DEAD(p, FALSE)
        EXIT
    ENDIF
    IF PlayerProtected()
        EXIT
    ENDIF
    INT dmg = ROUND(amount)
    IF dmg < 1 dmg = 1 ENDIF
    INT cur = GET_ENTITY_HEALTH(p)
    // 只压到濒死，不直接杀死（见上面"数值"里的说明）
    IF cur > dmg
        SET_ENTITY_HEALTH(p, cur - dmg)
    ENDIF
ENDPROC

// 1Hz：饥饿 / 口渴 / 体力 + 效果
PROC UpdateSurvival()
    IF NOT g_infection
        EXIT
    ENDIF
    IF NOT g_survival
        EXIT
    ENDIF
    PED_INDEX p = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(p)
        EXIT
    ENDIF
    IF IS_ENTITY_DEAD(p, FALSE)
        EXIT
    ENDIF
    INT now = GET_GAME_TIMER()

    // ── 饥饿 / 口渴：按秒扣（100/0.05 = 2000 秒 ≈ 33 分钟）──
    g_food = g_food - 0.05
    g_water = g_water - 0.067
    IF g_food < 0.0 g_food = 0.0 ENDIF
    IF g_water < 0.0 g_water = 0.0 ENDIF

    // ★ v0.24：删掉"首次跌破阈值弹一次提示" —— 饥饿/口渴现在是**常显进度条**，
    //   一眼就能看到，不需要再弹字（还会抢电台广播的位置）。

    // ── 归零 -> 每 5 秒掉血 ──
    IF now >= g_nextStarve
        g_nextStarve = now + 5000
        IF g_food <= 0.0
            StarveDamage(2.5)
        ENDIF
        IF g_water <= 0.0
            StarveDamage(3.5)
        ENDIF
    ENDIF

    // ★ v0.24：**体力系统整块删除**（用户要求："游戏内自带体力系统"）。
    //   原来这里会：跑步扣体力 -> 低于 20 用 SET_PED_MOVE_RATE_OVERRIDE 把玩家减速
    //   -> 归零后 35% 概率腿软摔倒。问题是：
    //     · 游戏自己的体力（跑步喘息/游泳）已经在管这件事，我们再叠一层是双重惩罚；
    //     · SET_PED_MOVE_RATE_OVERRIDE 是**状态设定**，会和引擎的移速计算互顶；
    //     · "无故摔倒"之前就被反馈过（v0.5 那条），能少一个来源就少一个。
ENDPROC

// 两种"生存条"的配色（值 -> 颜色）。抽出来只写一次，别在两个分支里各写一遍。
PROC FoodBarColour()
    IF g_food < 25.0
        g_barR = 255
        g_barG = 70
        g_barB = 60
    ELSE
        g_barR = 250
        g_barG = 180
        g_barB = 70
    ENDIF
ENDPROC

PROC WaterBarColour()
    IF g_water < 25.0
        g_barR = 255
        g_barG = 70
        g_barB = 60
    ELSE
        g_barR = 110
        g_barG = 200
        g_barB = 255
    ENDIF
ENDPROC

// 一条进度条（v0.24 新增）
//   DRAW_RECT 用的是**中心点**坐标，所以填充条的 x 要按长度重新算中心 ——
//   这是"条从左边长出来"而不是"从中间对称伸缩"的关键。
PROC DRAW_BAR(FLOAT left, FLOAT y, FLOAT frac, INT r, INT g, INT b)
    FLOAT cy = y + 0.011
    // 底槽
    DRAW_RECT(left + BAR_W * 0.5, cy, BAR_W, BAR_H, 12, 14, 18, 200)
    // 填充
    IF frac < 0.0 frac = 0.0 ENDIF
    IF frac > 1.0 frac = 1.0 ENDIF
    FLOAT w = BAR_W * frac
    IF w > 0.002
        DRAW_RECT(left + w * 0.5, cy, w, BAR_H, r, g, b, 235)
    ENDIF
ENDPROC

// 左上角生存提示 —— **只在低于阈值时出现**（正常状态什么都不画）
//   ★ v0.16：从"左下角"搬到"左上角"。
//     原因：左下角是 GTA 的小地图，原来 y=0.844~0.912 正好压在地图上，
//     字和地图糊在一起看不清。左上角（x=0.030，y 从 0.030 起）是空区，
//     不与小地图、金钱、菜单冲突。
//   ★ 采用**紧凑堆叠**：只画实际出现的那几行，行与行之间不留空槽 ——
//     否则"只有口渴低"时那一行会孤零零浮在中间，看起来像错位。
// ---------------------------------------------------------------------------
// 左上角生存条（v0.24 重做）
//
//   用户要求：饥饿与口渴**常显**，做成进度条（不行就 xx/100）。
//   现在两行固定显示：`饥饿 ▓▓▓▓▓░░░ 72` / `口渴 ▓▓▓▓▓▓░░ 84`
//
//   布局（都在左上角，纵向 0.032 一格 —— 自检工具的阈值是 0.025，安全）：
//     0.030  饥饿  条 + 数值
//     0.062  口渴  条 + 数值
//     0.094  零件          （PARTS_HUD，有零件才画）
//     0.126  潜行          （仅在潜行时画，见 STEALTH_HUD）
//
//   数值单独画、不与字符串拼接（SanScript 不允许把数字拼进字符串）。
// ---------------------------------------------------------------------------
PROC SURVIVAL_HUD()
    IF NOT g_infection
        EXIT
    ENDIF
    IF NOT g_survival
        EXIT
    ENDIF

    SET_TEXT_FONT(FONT_STANDARD)
    SET_TEXT_CENTRE(FALSE)
    SET_TEXT_RIGHT_JUSTIFY(FALSE)
    SET_TEXT_WRAP(0.0, 1.0)
    SET_TEXT_DROPSHADOW(1, 0, 0, 0, 235)

    FLOAT barLeft = 0.030 + 2.0 * g_cjkW * g_hudScale + 0.014

    // ── 饥饿 ──
    FoodBarColour()
    LABEL_AT(0.030, 0.030, "饥饿", g_barR, g_barG, g_barB)
    DRAW_BAR(barLeft, 0.030, g_food / 100.0, g_barR, g_barG, g_barB)
    NUM_AT(barLeft + BAR_W + 0.012, 0.030, ROUND(g_food), 225, 228, 235)

    // ── 口渴 ──
    WaterBarColour()
    LABEL_AT(0.030, 0.062, "口渴", g_barR, g_barG, g_barB)
    DRAW_BAR(barLeft, 0.062, g_water / 100.0, g_barR, g_barG, g_barB)
    NUM_AT(barLeft + BAR_W + 0.012, 0.062, ROUND(g_water), 225, 228, 235)
ENDPROC

// 潜行指示（v0.24）—— 只在潜行时出现。
//   为什么要给这个提示：潜行的效果是**看不见的**（"僵尸没发现我"和"附近没僵尸"
//   在屏幕上完全一样），没有指示的话玩家没法确认自己到底有没有进入潜行。
//   一行淡色小字，不占地方。
PROC STEALTH_HUD()
    IF NOT g_infection
        EXIT
    ENDIF
    IF NOT g_playerStealth
        EXIT
    ENDIF

    SET_TEXT_FONT(FONT_STANDARD)
    SET_TEXT_CENTRE(FALSE)
    SET_TEXT_RIGHT_JUSTIFY(FALSE)
    SET_TEXT_WRAP(0.0, 1.0)
    SET_TEXT_DROPSHADOW(1, 0, 0, 0, 235)

    // 刚开过枪 -> 潜行失效中，换成红字提示（这样"为什么被发现了"有个解释）
    IF GET_GAME_TIMER() < g_noiseUntil
        LABEL_AT(0.030, 0.126, "枪声暴露", 255, 110, 100)
    ELSE
        LABEL_AT(0.030, 0.126, "潜行中", 150, 205, 180)
    ENDIF
ENDPROC

// 左上角「零件」计数 —— 只在有零件时出现（和生存三柱一样"需要时才占屏"）
//   ★ 位置固定 0.138：生存三柱是紧凑堆叠、最多三行（0.030 / 0.066 / 0.102），
//     所以 0.138 永远在它们的下方，不可能叠字。
PROC PARTS_HUD()
    IF NOT g_infection
        EXIT
    ENDIF
    IF g_parts <= 0
        EXIT
    ENDIF

    SET_TEXT_FONT(FONT_STANDARD)
    SET_TEXT_CENTRE(FALSE)
    SET_TEXT_RIGHT_JUSTIFY(FALSE)
    SET_TEXT_WRAP(0.0, 1.0)
    SET_TEXT_DROPSHADOW(1, 0, 0, 0, 235)

    // v0.24：从 0.138 上移到 0.094 —— 上面多了两行常显的生存条
    LABEL_AT(0.030, 0.094, "零件", 200, 215, 235)
    NUM_AT(0.030 + 2.0 * g_cjkW * g_hudScale + 0.012, 0.094, g_parts, 200, 215, 235)
ENDPROC

PROC UpdateSlowSystems()
    UpdateThreat()

    // 通缉抑制现在由 ApplyWantedLevel() 每帧兜底（见那里的说明），
    // 这里不再需要 1Hz 的清星 —— 那正是"星闪一下"的观感来源。

    // ★ 修改器开无敌 -> 感染直接清零。
    //   理由：无敌状态下我们本来就不会让僵尸扣你的血（ZombieAttack 会先查
    //   PlayerProtected），所以感染度只会在开无敌之前累积 —— 那点进度留着
    //   毫无意义，只会一直显示感染度、偶尔触发症状腿软，看着莫名其妙。
    //   用边沿触发（只在"第一次变成无敌"时清一次），不会每帧重复清。
    IF PlayerProtected()
        IF NOT g_immuneClear
            g_immuneClear = TRUE
            ResetInfection()
        ENDIF
    ELSE
        g_immuneClear = FALSE
    ENDIF

    IF g_infectedPlayer
        UpdatePlayerInfection()
    ENDIF

    // 护卫维护（跟随/清理）
    UpdateGuards()

    // 互动仲裁：招募 / 解雇 / 搜刮尸体，谁近谁拿这次按键
    UpdateInteract()

    // 末日纪时（跨天 -> 第 N 天 +1）与紧急广播
    UpdateApocClock()
    UpdateBroadcast()

    // 生存三柱（饥饿 / 口渴 / 体力）
    UpdateSurvival()

    // 野化动物维护（死了 -> 变成可搜刮的兽尸；走远 -> 释放）
    UpdateAnimals()

    // 报废车维护（车没了/炸了 -> 摘掉；离得远 -> 交还引擎）
    UpdateWrecks()

    // v0.45：更新"玩家在不在野外"（1Hz，一次导航面查询）—— 僵尸上限据此减半
    UpdateWildState()


    g_keyContext = FALSE      // 标志位用完即清，避免"一次按键被反复消费"
ENDPROC

// ---------------------------------------------------------------------------
// 环境
//   密度倍率带 _THIS_FRAME 后缀，**必须每帧设**（否则只生效一帧），这部分无法省。
//   但纯"状态设定"类的（近战伤害倍率）改成只在开关变化时设一次 —— 见 ApplyMeleeModifier。
// ---------------------------------------------------------------------------
PROC ApplyEnvironment()
    IF g_infection
        // ★★ v0.41/v0.42：**街上不再有"开着的车"**（行人按用户意见保留 0.4）。
        //   密度用 `*_THIS_FRAME` 版本，所以**必须每帧重申**
        //   （官方只剩这个版本：不带 _THIS_FRAME 的持久版在 .sch 里已被注释掉，
        //   标着 *BEING REMOVED SOON*，用了直接编译失败）。
        //   ★ 顺带的好处：停掉这些调用就自动恢复默认，不需要写还原代码。
        //
        //   【取舍：行人 0.4 -> 0.0 的代价】
        //   原来留四成行人是**故意的** —— `InfectNearbyPed()` 靠"感染街上的人"多生一批
        //   僵尸（`MakeIntoZombie`）。现在街上没人，那条路径自然失效（找不到目标，无害）。
        //   僵尸的**主来源是模组自己的刷怪器**（`SpawnZombie()` / `SpawnOneZombie()`），
        //   它不依赖路人，所以整体僵尸量不受影响；少的只是"路人被同化"这一段演出 ——
        //   而既然要求街上没人，也就没有路人来演了。
        // ★ v0.42：**行人改回 0.4**（用户指出 `InfectNearbyPed()` 靠"感染街上的人"
        //   多生一批僵尸，全清掉等于把那段代码废了）⇒ 行人/场景人恢复原状，
        //   只压**车流**。
        SET_PED_DENSITY_MULTIPLIER_THIS_FRAME(0.4)
        SET_VEHICLE_DENSITY_MULTIPLIER_THIS_FRAME(0.0)           // 车流：停刷（街上没人开车）
        SET_RANDOM_VEHICLE_DENSITY_MULTIPLIER_THIS_FRAME(0.0)    // 随机车流：停刷
        // ★ v0.42：**停放车保留**（末日里路边停满空车才像样，用户要求留着）
        SET_PARKED_VEHICLE_DENSITY_MULTIPLIER_THIS_FRAME(1.0)
    ENDIF
    // 注意：停电和近战倍率都不在这里做（它们是状态设定，每帧调会顶掉别人）
ENDPROC

// 僵尸近战伤害倍率（RottenV 的做法：让它们的拳头真的疼）
//   它是**全局状态**，只在开关变化时设一次就够 —— 原来每帧调纯属浪费，而且会
//   和别的脚本抢。0 = 关，1 = 开。
PROC ApplyMeleeModifier()
    INT want = 0
    IF g_infection
        want = 1
    ENDIF
    IF g_meleeMod = want
        EXIT
    ENDIF
    g_meleeMod = want
    IF want = 1
        SET_AI_MELEE_WEAPON_DAMAGE_MODIFIER(2.0)
    ELSE
        SET_AI_MELEE_WEAPON_DAMAGE_MODIFIER(1.0)
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 停电
//   要点（踩过两次坑之后总结）：
//   1. 参数是**反的**：官方注释 "it takes TRUE to turn them off, and FALSE to turn
//      them on"；R* 自己的清理代码也写着 "turning lights back on with
//      SET_ARTIFICIAL_LIGHTS_STATE(FALSE)"。
//   2. 它是**状态设定**、不是每帧命令（R* 也只在开关时调一次）。
//      每帧调用会把修改器/其它脚本的设置顶掉 —— 之前"修改器的停电也不生效了"
//      就是这么来的：我们在 g_blackout=FALSE 时每帧往 FALSE 上顶。
//   3. 所以你那个能用的修改器（ragemenu）也是用这同一个 native —— native 没问题，
//      是调用方式有问题。
//   → 现在的策略：**只在开启时维持（3 秒补一次，防场景切换重置），
//     关闭时只还原一次，之后完全不碰**。这样永远不和别人抢。
// ---------------------------------------------------------------------------
PROC ApplyBlackout()
    IF g_blackout
        IF GET_GAME_TIMER() >= g_nextBlackout
            // 先设"车灯是否也受停电影响"（这个参数要在停电命令之前设），
            // FALSE = 排除车辆灯光：现实里车灯用自己的电瓶，而且全黑之后夜里没法开车
            SET_ARTIFICIAL_VEHICLE_LIGHTS_STATE(FALSE)
            SET_ARTIFICIAL_LIGHTS_STATE(TRUE)
            g_nextBlackout = GET_GAME_TIMER() + 10000
            g_blackoutOwned = TRUE
        ENDIF
    ELSE
        // 只有"是我们自己开的"才还原一次；否则一个字都不碰，免得和修改器打架
        IF g_blackoutOwned
            SET_ARTIFICIAL_VEHICLE_LIGHTS_STATE(TRUE)
            SET_ARTIFICIAL_LIGHTS_STATE(FALSE)
            g_blackoutOwned = FALSE
        ENDIF
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 车内被拖下车的规则（v0.8 重做"车内安全"并删除该选项，v0.12 增加引擎击落开关）
//
//   设计意图：**车不再是安全区**，但要有区分度 ——
//     · 有车厢的车（轿车/卡车…）：门挡着，僵尸拽不出你，只能围上来砸车；
//       你可以靠警报和车身掉血判断处境，但必须开走或下车解决。
//     · 摩托 / 自行车（没有车厢）：**能被直接拽下车** —— 停在僵尸堆里就是找死。
//   用"模型是不是摩托/自行车"判定，比手工维护车型表可靠。
//   只在**状态变化**时设置（边沿触发），不每帧调 —— 状态类 native 的老规矩。
//   ★ v0.12：这里同时设两个开关（都是状态设定，一起在边沿处设最省）：
//     · `SET_PED_CAN_BE_DRAGGED_OUT` + `PCF_NO_DRAG_OUT` —— 能不能被拖出车
//     · `SET_PED_CAN_BE_KNOCKED_OFF_VEHICLE` —— 引擎层面的"能不能被击落"，
//       `ExecuteKnockOff` 用的 KNOCK_PED_OFF_VEHICLE 会尊重它。
// ---------------------------------------------------------------------------
PROC UpdateVehicleDragRule()
    PED_INDEX player = PLAYER_PED_ID()
    IF NOT DOES_ENTITY_EXIST(player)
        EXIT
    ENDIF

    // 0 = 不在车里(可被拖) / 1 = 有车厢(拖不出) / 2 = 摩托·自行车(可被拖)
    INT state = 0
    IF IS_PED_IN_ANY_VEHICLE(player)
        VEHICLE_INDEX v = GET_VEHICLE_PED_IS_IN(player, FALSE)
        IF DOES_ENTITY_EXIST(v)
            MODEL_NAMES m = GET_ENTITY_MODEL(v)
            IF IS_THIS_MODEL_A_BIKE(m) OR IS_THIS_MODEL_A_BICYCLE(m)
                state = 2
            ELSE
                state = 1
            ENDIF
        ENDIF
    ENDIF

    IF state = g_prevInVeh
        EXIT
    ENDIF
    g_prevInVeh = state

    // ★ v0.12：除了"能不能被拖出车"，还要设引擎层面的"能不能被击落"
    //   （`SET_PED_CAN_BE_KNOCKED_OFF_VEHICLE`）—— 我们最终是把玩家弄下车的
    //   那一步交给引擎的 KNOCK_PED_OFF_VEHICLE，而它会尊重这个开关。
    //   两个开关一起设，保证"有车厢的车绝对下不来、摩托一定下得来"。
    IF state = 1
        // 有车厢：门挡着，拖不出去，引擎层面也禁止被击落
        SET_PED_CAN_BE_DRAGGED_OUT(player, FALSE)
        SET_PED_CONFIG_FLAG(player, INT_TO_ENUM(PED_CONFIG_FLAGS, PCF_NO_DRAG_OUT), TRUE)
        SET_PED_CAN_BE_KNOCKED_OFF_VEHICLE(player, KNOCKOFFVEHICLE_NEVER)
    ELSE
        // 步行 or 摩托/自行车：允许被僵尸拽下来
        SET_PED_CAN_BE_DRAGGED_OUT(player, TRUE)
        SET_PED_CONFIG_FLAG(player, INT_TO_ENUM(PED_CONFIG_FLAGS, PCF_NO_DRAG_OUT), FALSE)
        IF state = 2
            // 摩托 / 自行车：允许被击落（僵尸抓得住就拽得下来）
            SET_PED_CAN_BE_KNOCKED_OFF_VEHICLE(player, KNOCKOFFVEHICLE_EASY)
        ELSE
            SET_PED_CAN_BE_KNOCKED_OFF_VEHICLE(player, KNOCKOFFVEHICLE_DEFAULT)
        ENDIF
    ENDIF
ENDPROC

// ---------------------------------------------------------------------------
// 主循环
// ---------------------------------------------------------------------------
SCRIPT
    PED_INDEX player

    g_bannerUntil = GET_GAME_TIMER() + 10000

    WHILE TRUE
        WAIT(0)

        IF NOT IS_PLAYER_PLAYING(PLAYER_ID())
            // 游戏还在加载 / 玩家还不能操作：本帧不做事。
            // 这里绝对不能写成 WHILE 等待循环 —— 会把脚本线程整个卡死。
        ELSE
            IF NOT g_announced
                g_announced = TRUE
                g_nextSpawn = GET_GAME_TIMER() + 3000
                g_nextSurvivor = GET_GAME_TIMER() + 5000
                g_nextRaiders = GET_GAME_TIMER() + 180000
                g_bannerUntil = GET_GAME_TIMER() + 9000
                // ★ 审查修复：失败点缓冲原来全是 (0,0,0)，而世界原点附近
                //   （大概在好麦坞山那一带）的落点会与它"距离 < 12m"，
                //   于是那片区域的刷怪会被永久判为"刚失败过"而拒绝。
                //   用一个远在脚下的哨兵值初始化，就不会误伤。
                INT fi = 0
                WHILE fi < 4
                    g_failPos[fi].x = 0.0
                    g_failPos[fi].y = 0.0
                    g_failPos[fi].z = -9000.0
                    fi = fi + 1
                ENDWHILE
                // 搜刮缓冲同理：全部标成"已取走"，这样只有真的记过尸体才会触发提示
                INT li = 0
                WHILE li < 6
                    g_lootTaken[li] = TRUE
                    g_lootKind[li] = 0            // 0 = 人（默认值，写出来是为了明确）
                    li = li + 1
                ENDWHILE
            ENDIF

            SetupRelations()

            // 打开僵尸模式 —— v0.19：五个子系统**跟着主开关一起开**
            //   （快速僵尸 / 幸存者小队 / 玩家感染 / 末日氛围 / 生存需求）
            //   它们不再单列菜单项：菜单只管"要不要玩僵尸"，其余全部由主开关决定。
            IF g_infection AND NOT g_prevInfection
                g_fastZombies = TRUE
                g_survivorsOn = TRUE
                g_infectedPlayer = TRUE
                g_ambience = TRUE
                g_survival = TRUE

                // 各自的"开启初始化"（原来散在这五项各自的菜单切换代码里）
                g_nextSurvivor = GET_GAME_TIMER() + 3000
                g_nextAmbience = 0            // 让氛围状态立刻应用一遍
                g_nextAmbienceKill = 0
                g_food = 100.0
                g_water = 100.0
                g_nextStarve = 0
                g_playerStealth = FALSE
                // v0.24：体力系统删了，但**保留一次移速复位** —— 万一上一局
                //   （脚本热重载前）留下过 MOVE_RATE_OVERRIDE 0.85，这里把它抹平，
                //   否则玩家会一直"慢吞吞"而没有任何解释。
                IF DOES_ENTITY_EXIST(PLAYER_PED_ID())
                    SET_PED_MOVE_RATE_OVERRIDE(PLAYER_PED_ID(), 1.0)
                ENDIF

                // 末日纪时与开场广播
                g_apocDay = 1
                g_lastHour = -1
                g_lastBroadcastIdx = -1
                g_nextBroadcast = 0
                g_pendingDayNews = 0        // v0.26：排队中的跨天播报一并清掉
                g_clockLockUntil = 0       //        时钟锁同理

                // ★ 尸潮压力状态一并复位 —— 否则上一次游戏留下的压力/噪声
                //   会让这次一开局就立刻触发尸潮。
                g_noise = 0.0
                g_pressure = 1.0
                g_tension = FALSE
                g_phaseCalm = GET_GAME_TIMER() + 45000
                g_hordeUntil = 0
                g_hordeMinUntil = GET_GAME_TIMER() + 120000
                g_hordeWavesLeft = 0
                g_hordeNextWave = 0
                g_hordeSpawned = 0

                // 野化动物：开局先等半分钟再出现，别一进游戏就撞见野猪
                g_animalCount = 0
                g_nextWildlife = GET_GAME_TIMER() + 30000

                // 报废车：开局等半分钟再开始出现（先让你熟悉环境）
                //   ★ g_wreckCount **不在这里清零** —— 关模式时 ForgetAllWrecks 已经清过，
                //     在这里再清一次会把那边的引用丢掉却不删车。
                g_nextWreck = GET_GAME_TIMER() + 25000
            ENDIF

            // 关掉僵尸模式 = 一键清场：僵尸、幸存者、警察巡逻、护卫全部移除，
            // 并顺手把幸存者开关也关掉（否则它会在 90 秒后又刷一队出来）
            IF g_prevInfection AND NOT g_infection
                ForgetAllZombies()
                ForgetAllSurvivors()
                ForgetAllCops()
                ForgetAllGuards()
                CleanupRaiders()
                ForgetAllAnimals()
                ForgetAllWrecks()
                ForgetCamp()                 // v0.24：营地一并拆掉（恢复原状）
                ClearAntidoteCrate()

                // v0.19：五个联动开关一并关掉
                g_fastZombies = FALSE
                g_survivorsOn = FALSE
                g_infectedPlayer = FALSE
                g_ambience = FALSE            // 氛围由 ApplyAmbience 的 ELSE 分支还原
                g_survival = FALSE

                // 末日纪时复位
                g_apocDay = 1
                g_lastHour = -1
                g_lastBroadcastIdx = -1
                g_nextBroadcast = 0
                g_pendingDayNews = 0        // v0.26：排队中的跨天播报一并清掉
                g_clockLockUntil = 0       //        时钟锁同理

                // 生存指标回满（v0.24：体力已删除，只剩饥饿/口渴）
                g_food = 100.0
                g_water = 100.0
                g_nextStarve = 0
                g_playerStealth = FALSE

                // 尸潮压力状态复位
                g_noise = 0.0
                g_pressure = 1.0
                g_tension = FALSE
                g_phaseCalm = 0
                g_hordeUntil = 0
                g_hordeMinUntil = 0
                g_hordeWavesLeft = 0
                g_hordeNextWave = 0
                g_hordeSpawned = 0
            ENDIF
            g_prevInfection = g_infection

            IF g_prevSurvivors AND NOT g_survivorsOn
                ForgetAllSurvivors()
            ENDIF
            g_prevSurvivors = g_survivorsOn

            IF g_prevInfPlayer AND NOT g_infectedPlayer
                ResetInfection()
            ENDIF
            g_prevInfPlayer = g_infectedPlayer

            // 噪声：枪声 / 开车经过 / 爆炸
            //   枪声用 IS_PED_SHOOTING（1 次 native，且"射击中"会持续若干帧）；
            //   车辆/爆炸属于"冲击型"事件，节流到 0.25 秒查一次就够 ——
            //   没必要每帧烧 GET_ENTITY_SPEED + IS_EXPLOSION_IN_SPHERE + 坐标。
            //   噪声标量 g_noise 会喂给尸潮压力系统（Reborn 的 AddExternalNoise）
            player = PLAYER_PED_ID()

            // ★ v0.22：玩家是不是在室内实例里（每帧 1 次 native，可忽略）
            //   用途：室内不刷僵尸 / 僵尸不追进室内 / 僵尸不把室内的人当目标。
            //   "在室内"的判据照官方脚本的写法：GET_INTERIOR_FROM_ENTITY(...) != NULL。
            g_playerIndoor = FALSE
            IF GET_INTERIOR_FROM_ENTITY(player) != NULL
                g_playerIndoor = TRUE
            ENDIF

            // ★ v0.24：潜行状态（每帧 1 次 native）
            //   玩家按住潜行键时引擎会把他切成 stealth 步态，这里就是读那个状态。
            //   用途见 ZombieDetectRange()：潜行 + 没开过枪 -> 僵尸的发现距离缩到四成。
            g_playerStealth = GET_PED_STEALTH_MOVEMENT(player)

            // ★ v0.24：玩家在不在营地安全区（没有营地时内部提前退出，等于 0 次 native）
            UpdateCampSafeZone()


            IF IS_PED_SHOOTING(player)
                g_noiseUntil = GET_GAME_TIMER() + 4000
                g_noise = g_noise + 4.0
            ENDIF
            IF GET_GAME_TIMER() >= g_nextNoiseCheck
                g_nextNoiseCheck = GET_GAME_TIMER() + 250
                IF IS_PED_IN_ANY_VEHICLE(player)
                    IF GET_ENTITY_SPEED(player) > 2.0
                        g_noiseUntil = GET_GAME_TIMER() + 2000
                    ENDIF
                ENDIF
                IF IS_EXPLOSION_IN_SPHERE(EXP_TAG_DONTCARE, GET_ENTITY_COORDS(player, TRUE), 60.0)
                    g_noiseUntil = GET_GAME_TIMER() + 4000
                    g_noise = g_noise + 40.0
                ENDIF
            ENDIF

            MenuInput()

            // 互动键（INPUT_CONTEXT）的"按下"是单帧事件，必须每帧采样成标志位，
            // 否则 1Hz 的低速系统会漏掉（这是本轮自查抓到的真实问题）。
            IF NOT g_menuOpen
                // 本端口上互动键 = 十字键右键；INPUT_CONTEXT 是官方语义上对应的
                // action。两个都读，保证不管端口怎么映射都能按得动（问题 9）。
                IF IS_CONTROL_JUST_PRESSED(PLAYER_CONTROL, INPUT_CONTEXT)
                OR IS_CONTROL_JUST_PRESSED(FRONTEND_CONTROL, INPUT_FRONTEND_RIGHT)
                    g_keyContext = TRUE
                ENDIF
            ENDIF

            // 车内被拖下车的规则（边沿触发，不耗资源）
            UpdateVehicleDragRule()

            // ★ 护卫指令变化 -> **下一帧**立刻应用到全队（事件驱动，不占轮询）
            //   放在菜单判断之外：开着菜单改指令也要立刻生效。
            IF g_guardModeDirty
                g_guardModeDirty = FALSE
                ApplyGuardMode()
            ENDIF

            // 十字键**左** = 切换面前那个护卫的指令（v0.21 换键，见 CheckGuardHotkey 说明）
            CheckGuardHotkey()

            // 营地：菜单里按了「放置营地」-> 下一帧执行（脏标志模式）
            //   为什么用脏标志：PlaceCamp / RemoveCamp 定义在文件后段，
            //   而菜单处理函数在很靠前的位置（SanScript 要求先定义后调用）。
            IF g_campDirty
                g_campDirty = FALSE
                ToggleCamp()
            ENDIF

            // 休息的两段式：淡出之后才改时间（见 StartCampRest 的说明）
            UpdateCampRest()

            // 修车结算（只有"正在敲"的那 0.7 秒内才会干活）
            RepairTick()

            // 抓拽阶段维护（僵尸抓住玩家 -> 1.1 秒后把他拽下车）
            //   不在抓拽中时只有 1 次计时器比较，成本可忽略
            UpdateGrapple()
            // 击落后的兜底检查（只有"刚击落"的 0.35 秒内才会真正干活）
            VerifyDragOff()

            // 停电：菜单开着也要立刻生效，所以放在菜单判断之前
            ApplyBlackout()

            // 末日氛围（世界静默）：同样放在菜单判断之前，菜单里一改就生效
            ApplyAmbience()

            IF g_menuOpen
                DrawMenu()
            ELSE
                PrepareAssets()

                // 刷怪节奏随尸潮压力变化（Reborn：压力高 -> 间隔更短、上限更高）
                IF g_infection
                    // ★ v0.22：玩家在室内时整条刷怪链都不跑 ——
                    //   注意这里必须卡住，因为下面那条"感染附近的人"跟"生成僵尸"是
                    //   两条不同的路径，只在 SpawnOneZombie 里加守卫是挡不住感染路径的。
                    //   ★ v0.24：营地安全区内同样整条链不跑（和室内一个道理）。
                    IF GET_GAME_TIMER() > g_nextSpawn AND NOT g_playerIndoor AND NOT g_playerSafe
                        // 优先感染街上的人；没有合适目标才凭空生成
                        IF NOT InfectNearbyPed()
                            SpawnZombie()
                        ENDIF
                        INT gap = 1500
                        IF g_pressure > 1.3 gap = 950 ENDIF
                        IF GET_GAME_TIMER() < g_hordeUntil gap = 500 ENDIF
                        g_nextSpawn = GET_GAME_TIMER() + gap
                    ENDIF
                    UpdateZombieWorld()
                    // 尸潮期间的补波（问题 7：让尸潮真的"一波一波"涌过来）
                    UpdateHordeWave()

                    // 警察巡逻：场上僵尸够多才派，同一时间最多一队，派过至少隔 3 分钟
                    IF g_copReady
                        IF g_copCount <= 0
                        AND g_zombieCount >= 6
                        AND GET_GAME_TIMER() > g_nextCops
                            SpawnCopPatrol()
                            g_nextCops = GET_GAME_TIMER() + 180000
                        ENDIF
                        IF GET_GAME_TIMER() >= g_nextCopThink
                            g_nextCopThink = GET_GAME_TIMER() + 1000
                            UpdateCops()
                        ENDIF
                    ENDIF

                    // 敌对掠夺者车队（感染模式开着才派；同一时间最多一队）
                    //   v0.12：间隔从 2.5~4 分钟拉长到 **5~8 分钟**（用户反馈太频繁）。
                    //   另外 UpdateRaiders 在车队被清光时还会补一段 5 分钟保底冷却。
                    IF GET_GAME_TIMER() > g_nextRaiders
                    AND g_raiderCount <= 0
                    AND g_zombieCount >= 4
                        SpawnRaiders()
                        g_nextRaiders = GET_GAME_TIMER() + GET_RANDOM_INT_IN_RANGE(300000, 480000)
                    ENDIF
                    IF GET_GAME_TIMER() >= g_nextRaiderThink
                        g_nextRaiderThink = GET_GAME_TIMER() + 1000
                        UpdateRaiders()
                    ENDIF

                    // 路上报废车（v0.22）：末日氛围 + "攒零件修车"这个目标。
                    //   40~75 秒尝试一次，同一时间最多 MAX_WRECKS 辆。
                    //   报废车只放在**车行节点**上（= 道路 / 车道），所以天然在地面层。
                    IF GET_GAME_TIMER() > g_nextWreck
                        g_nextWreck = GET_GAME_TIMER() + GET_RANDOM_INT_IN_RANGE(25000, 50000)
                        IF g_wreckCount < MAX_WRECKS
                            SpawnWrecks()
                        ENDIF
                    ENDIF
                ENDIF

                // 野化动物（v0.21）：末日里被血腥味引出来的流浪动物。
                //   ★ 必须包在 g_infection 里 —— 它和 IF g_survivorsOn 是**并列**的，
                //     上面那个感染块已经 ENDIF 了；不包的话关掉感染模式后
                //     g_nextWildlife 早已过期，会变成"每秒都在刷动物"。
                IF g_infection
                    IF GET_GAME_TIMER() > g_nextWildlife
                        g_nextWildlife = GET_GAME_TIMER() + GET_RANDOM_INT_IN_RANGE(30000, 55000)
                        SpawnWildlife()
                    ENDIF
                ENDIF

                IF g_survivorsOn
                    IF g_survivorCount <= 0
                    AND GET_GAME_TIMER() > g_nextSurvivor
                        SpawnSurvivors()
                        g_nextSurvivor = GET_GAME_TIMER() + 90000
                    ENDIF
                    // 幸存者维护节流到 0.5 秒一次（非关键帧逻辑）
                    IF GET_GAME_TIMER() >= g_survThink
                        g_survThink = GET_GAME_TIMER() + 500
                        UpdateSurvivors()
                    ENDIF
                ENDIF

                // 低速系统统一入口（1Hz）：尸潮压力 / 玩家感染 / 护卫
                IF GET_GAME_TIMER() >= g_nextSlowThink
                    g_nextSlowThink = GET_GAME_TIMER() + 1000
                    UpdateSlowSystems()
                ENDIF

                ApplyEnvironment()
                ApplyMeleeModifier()
                STATUS()
                APOC_DAY()
                SURVIVAL_HUD()
                STEALTH_HUD()        // v0.24：潜行指示（只在潜行时画）
                CAMP_HUD()           // v0.24：营地安全区指示（只在安全区内画）
                PARTS_HUD()          // v0.22：零件计数（有零件才画，位置在生存条下方）
                SPECIAL_MSG()
                // 互动提示每帧画（低速系统只负责决定"要不要提示"，避免闪烁）
                IF g_hintUntil > GET_GAME_TIMER()
                    DrawHint(g_hintMsg)
                ENDIF
            ENDIF
        ENDIF

        // ★ 这两件事放在 IS_PLAYER_PLAYING 判断**之外**：
        //   1) 死亡画面期间 IS_PLAYER_PLAYING 为 FALSE —— 放在里面就根本观察不到
        //      "玩家死过"这件事。复活后万一 ped 句柄没变，感染就永远复位不了。
        //   2) 通缉抑制是状态设定，菜单开着的时候也应该维持（原来它在"菜单关闭"
        //      的分支里，开菜单期间可能冒出星）。
        CheckPlayerRespawn()
        ApplyWantedLevel()

        // 横幅画在 IF/ELSE 之外：即使 IS_PLAYER_PLAYING 一直为 FALSE 也看得见
        IF g_bannerUntil > 0 AND NOT g_menuOpen
            IF GET_GAME_TIMER() < g_bannerUntil
                BANNER("脏比洛圣都", "v0.45 preview - 按住 RB+B 打开菜单", 90, 235, 140)
            ENDIF
        ENDIF
    ENDWHILE
ENDSCRIPT
