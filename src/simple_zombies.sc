PROC TEXT_AT(FLOAT x, FLOAT y, FLOAT scale, INT r, INT g, INT b, STRING s)
    SET_TEXT_FONT(FONT_STANDARD)
    SET_TEXT_SCALE(scale, scale)
    SET_TEXT_COLOUR(r, g, b, 255)
    SET_TEXT_WRAP(0.0, 1.0)
    SET_TEXT_DROPSHADOW(1, 0, 0, 0, 200)
    BEGIN_TEXT_COMMAND_DISPLAY_TEXT("STRING")
    ADD_TEXT_COMPONENT_SUBSTRING_KEYBOARD_DISPLAY(s)
    END_TEXT_COMMAND_DISPLAY_TEXT(x, y)
ENDPROC

PROC TEXT_RIGHT(FLOAT x, FLOAT y, FLOAT scale, INT r, INT g, INT b, STRING s)
    SET_TEXT_FONT(FONT_STANDARD)
    SET_TEXT_SCALE(scale, scale)
    SET_TEXT_COLOUR(r, g, b, 255)
    SET_TEXT_WRAP(0.0, x)
    SET_TEXT_RIGHT_JUSTIFY(TRUE)
    SET_TEXT_DROPSHADOW(1, 0, 0, 0, 200)
    BEGIN_TEXT_COMMAND_DISPLAY_TEXT("STRING")
    ADD_TEXT_COMPONENT_SUBSTRING_KEYBOARD_DISPLAY(s)
    END_TEXT_COMMAND_DISPLAY_TEXT(x, y)
    SET_TEXT_RIGHT_JUSTIFY(FALSE)
ENDPROC

PROC BANNER(STRING title, STRING sub, INT r, INT g, INT b)
    DRAW_RECT(0.500, 0.400, 0.460, 0.092, 6, 8, 12, 205)
    DRAW_RECT(0.500, 0.3595, 0.460, 0.007, r, g, b, 255)

    SET_TEXT_FONT(FONT_STANDARD)
    SET_TEXT_CENTRE(TRUE)
    SET_TEXT_WRAP(0.0, 1.0)
    SET_TEXT_DROPSHADOW(2, 0, 0, 0, 210)

    SET_TEXT_SCALE(0.52, 0.52)
    SET_TEXT_COLOUR(255, 255, 255, 255)
    BEGIN_TEXT_COMMAND_DISPLAY_TEXT("STRING")
    ADD_TEXT_COMPONENT_SUBSTRING_KEYBOARD_DISPLAY(title)
    END_TEXT_COMMAND_DISPLAY_TEXT(0.500, 0.376)

    SET_TEXT_SCALE(0.36, 0.36)
    SET_TEXT_COLOUR(r, g, b, 255)
    BEGIN_TEXT_COMMAND_DISPLAY_TEXT("STRING")
    ADD_TEXT_COMPONENT_SUBSTRING_KEYBOARD_DISPLAY(sub)
    END_TEXT_COMMAND_DISPLAY_TEXT(0.500, 0.406)

    SET_TEXT_CENTRE(FALSE)
ENDPROC

// 右下角计数：只在对应模式开着的时候显示，关掉就一起消失
// 右下角状态：僵尸数 / 变异体数 / 护卫 / 幸存者 / 感染度
//   每项只在对应系统开着或有内容时才画，避免无意义开销
PROC NUM_AT(FLOAT x, FLOAT y, INT n, INT r, INT g, INT b)
    SET_TEXT_SCALE(g_hudScale, g_hudScale)
    SET_TEXT_COLOUR(r, g, b, 250)
    BEGIN_TEXT_COMMAND_DISPLAY_TEXT("NUMBER")
    ADD_TEXT_COMPONENT_INTEGER(n)
    END_TEXT_COMMAND_DISPLAY_TEXT(x, y)
ENDPROC

PROC LABEL_AT(FLOAT x, FLOAT y, STRING s, INT r, INT g, INT b)
    SET_TEXT_SCALE(g_hudScale, g_hudScale)
    SET_TEXT_COLOUR(r, g, b, 250)
    BEGIN_TEXT_COMMAND_DISPLAY_TEXT("STRING")
    ADD_TEXT_COMPONENT_SUBSTRING_KEYBOARD_DISPLAY(s)
    END_TEXT_COMMAND_DISPLAY_TEXT(x, y)
ENDPROC

// ---------------------------------------------------------------------------
// 右下角 HUD —— 只保留"感染度"这一条必要信息
//
//   为了沉浸感，僵尸数 / 壮尸数 / 尖啸者数 / 护卫数 / 幸存者数 / 尸潮倒计时
//   全部移除（玩家应该靠眼睛看街上，而不是看计数器）。
//   唯一保留的是感染度：这是玩家**无法靠观察得知**的状态（中了感染不及时处理
//   会直接死亡），去掉就变成"莫名其妙暴毙"，属于玩法必需信息。
// ---------------------------------------------------------------------------
PROC STATUS()
    IF NOT g_infectedPlayer
        EXIT
    ENDIF
    IF g_infBites <= 0
        EXIT
    ENDIF

    SET_TEXT_FONT(FONT_STANDARD)
    SET_TEXT_CENTRE(FALSE)
    SET_TEXT_RIGHT_JUSTIFY(FALSE)
    SET_TEXT_WRAP(0.0, 1.0)
    SET_TEXT_DROPSHADOW(1, 0, 0, 0, 235)     // v0.15：阴影加深，亮背景下也看得清

    INT pct = ROUND(g_infProgress * 100.0)
    // v0.15：颜色改成**高饱和深色**（原来淡黄 + alpha 205，看着发灰看不清）
    INT cr = 255
    INT cg = 200
    INT cb = 60
    IF g_infProgress >= 0.75
        cr = 255
        cg = 55
        cb = 55
    ELIF g_infProgress >= 0.40
        cr = 255
        cg = 125
        cb = 40
    ENDIF
    // 字号变大后必须**算字宽再定位**，否则中文和数字会叠在一起
    FLOAT ix = 0.700
    LABEL_AT(ix, 0.958, "感染", cr, cg, cb)
    ix = ix + 2.0 * g_cjkW * g_hudScale + 0.012
    NUM_AT(ix, 0.958, pct, cr, cg, cb)
ENDPROC

